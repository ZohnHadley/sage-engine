[
  // Collision layers (docs/design/10 §3). Layer 0 is "default"; everything collides unless listed in
  // "ignore" (which is symmetric). Games patch this record to add their own layers.
  //
  // `hitbox` (issue #137) ignores "*", everything, so it is a query-only layer: a creature's hitboxes
  // (the `hitboxes` part) push nothing, trip no trigger, and are seen only by a query that asks for
  // them alone — a shot resolving where it landed — never by a sweep, a ray or a swing aimed at solid things.
  {
    "type": "physics_layers",
    "id": "default",
    "layers": ["default", "player", "enemy", "projectile", "trigger", "debris", "hitbox"],
    "ignore": {
      "projectile": ["projectile", "debris"],
      "debris": ["debris"],
      "hitbox": ["*"]
    }
  },

  // Surfaces (issue #270, docs/design/10 "As built (surfaces)"): what things are made of. A collider
  // names one ("body": { "surface": "sage:wood" }), a brush texture is one by a record's "textures", a
  // terrain layer by the terrain record's "surfaces"; every ray and sweep hit says which. These give
  // friction, bounce and a penetration hint only: the footstep and impact cues, the decals and the
  // textures they cover are the game's, added by patching these or by writing its own.
  { "type": "physics_material", "id": "default", "friction": 0.7, "restitution": 0,   "penetration": 1 },
  { "type": "physics_material", "id": "stone",   "friction": 0.8, "restitution": 0.05, "penetration": 1.5 },
  { "type": "physics_material", "id": "wood",    "friction": 0.6, "restitution": 0.1,  "penetration": 0.4 },
  { "type": "physics_material", "id": "metal",   "friction": 0.4, "restitution": 0.15, "penetration": 3 },
  { "type": "physics_material", "id": "dirt",    "friction": 0.9, "restitution": 0,    "penetration": 0.8 },
  { "type": "physics_material", "id": "grass",   "friction": 0.8, "restitution": 0,    "penetration": 0.8 },
  { "type": "physics_material", "id": "flesh",   "friction": 0.9, "restitution": 0,    "penetration": 0.2 },
  { "type": "physics_material", "id": "glass",   "friction": 0.3, "restitution": 0.1,  "penetration": 0.1 }
]
