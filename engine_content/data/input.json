[
  // Engine input maps (docs/design/08 §3.2–3.3). Actions are registered by modules (ClientModule
  // registers the client's own: Console, editor and UI; GameplayModule registers the simulation's:
  // Move, Jump, Run, Crouch, ToggleView, Attack, Use); games add maps for their own actions, and player rebinds
  // will be patches.
  {
    // Active while the console is open; consumes all other keyboard input.
    "type": "input_map",
    "id": "console",
    "context": "Console",
    "actions": {
      "ToggleConsole": [ { "key": "OemTilde" } ],
      "Menu":          [ { "key": "Escape" } ]
    }
  },
  {
    // Active while a screen is open (13 §3, F38). Its own keys are read first and then everything
    // else is swallowed, so nobody walks about behind an open inventory. MenuLeft/MenuRight/MenuTab
    // move focus across a widget screen's grid and round its tab order (#97; Shift+Tab goes back). `Inventory` is bound here as
    // well as in gameplay, so the key that opened a screen also closes it. A kit's screen keys (the
    // RPG kit's Spellbook, Spellmaker, Journal) are bound by the game that uses the kit.
    "type": "input_map",
    "id": "ui",
    "context": "UI",
    "actions": {
      "MenuUp":        [ { "key": "Up" }, { "key": "W" }, { "gamepad": "DPadUp" } ],
      "MenuDown":      [ { "key": "Down" }, { "key": "S" }, { "gamepad": "DPadDown" } ],
      "MenuLeft":      [ { "key": "Left" }, { "key": "A" }, { "gamepad": "DPadLeft" } ],
      "MenuRight":     [ { "key": "Right" }, { "key": "D" }, { "gamepad": "DPadRight" } ],
      "MenuTab":       [ { "key": "Tab" }, { "gamepad": "RightShoulder" } ],
      "MenuConfirm":   [ { "key": "Enter" }, { "gamepad": "A" } ],
      "MenuAlternate": [ { "key": "Delete" }, { "gamepad": "X" } ],
      "MenuBack":      [ { "key": "Escape" }, { "gamepad": "B" } ],
      "Inventory":     [ { "key": "I" }, { "gamepad": "Y" } ],
      "ToggleConsole": [ { "key": "OemTilde" } ]
    }
  },
  {
    "type": "input_map",
    "id": "gameplay",
    "context": "Gameplay",
    "actions": {
      "Move":          [ { "composite": "WASD" }, { "gamepad": "LeftStick" } ],
      "Look":          [ { "mouse": "Delta", "scale": 0.0025 }, { "gamepad": "RightStick", "scale": 3.0, "rate": true } ],
      "Jump":          [ { "key": "Space" }, { "gamepad": "A" } ],
      "Attack":        [ { "mouse": "Left" }, { "gamepad": "RightTrigger" } ],
      "Use":           [ { "key": "E" }, { "gamepad": "X" } ],
      "Run":           [ { "key": "LeftShift" }, { "gamepad": "LeftStickButton" } ],
      "Crouch":        [ { "key": "LeftControl" }, { "gamepad": "B" } ],
      "ToggleView":    [ { "key": "V" }, { "gamepad": "RightStickButton" } ],
      "Menu":          [ { "key": "Escape" }, { "gamepad": "Start" }, { "gamepad": "Back" } ],
      "Inventory":     [ { "key": "I" }, { "gamepad": "Y" } ],
      "ToggleConsole": [ { "key": "OemTilde" } ]
    }
  }
]
