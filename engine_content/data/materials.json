[
  // Engine materials (docs/design/07 §3.3), namespace "sage". Games and mods inherit from these with
  // "base": "sage:lit_default" and override params; every param the effect uses has a value here.
  {
    "type": "material",
    "id": "lit_default",
    "effect": "shaders/lit.mgfxo",
    "technique": "Default",
    "pass": "Opaque",
    "sampler": { "filter": "Linear", "address": "Wrap" },
    "params": { "Albedo": "textures/white.png", "AlbedoColor": [1, 1, 1, 1], "AlphaCutoff": 0.5 }
  },
  {
    "type": "material",
    "id": "unlit_default",
    "base": "lit_default",
    "technique": "Unlit"
  },
  {
    // Heightmap terrain (14 §3): one tiling texture. Layers blended by height and slope are a
    // `terrain_material` record (issue #307), which falls back to this where shaders/terrain.mgfxo is missing.
    "type": "material",
    "id": "terrain_default",
    "base": "lit_default",
    "params": { "Albedo": "textures/ground.png" }
  },
  {
    // Billboard sprites (06 §3.8): full-bright by default, with fog. Point sampling and alpha test give
    // the Daggerfall look; the sheet's texture replaces Albedo per draw, so one material serves every sheet.
    "type": "material",
    "id": "sprite_default",
    "effect": "shaders/sprite.mgfxo",
    "technique": "Unlit",
    "pass": "AlphaTested",
    "cull": "None",
    "sampler": { "filter": "Point", "address": "Clamp" },
    "params": { "Albedo": "textures/white.png", "AlbedoColor": [1, 1, 1, 1], "AlphaCutoff": 0.5 }
  },
  {
    // Sprites in the world's light: the sun (and its shadows), the sky's ambient and the nearby lamps, so a
    // creature darkens at night and glows by a fire. A sheet opts in with "material": "sage:sprite_lit".
    "type": "material",
    "id": "sprite_lit",
    "base": "sprite_default",
    "technique": "Lit"
  },
  {
    // Full-bright, by name: the same as the default, for a sheet that wants to say so.
    "type": "material",
    "id": "sprite_unlit",
    "base": "sprite_default"
  },
  {
    // What a particle draws with (06 §3.9, F39): the sprite shader's blended technique, *added* to what
    // is behind it so a spark glows, and no depth write so a cloud of them does not fight itself. The
    // technique and the blend mode were both written for this and unused until today.
    "type": "material",
    "id": "particle_additive",
    "base": "sprite_default",
    "technique": "UnlitBlend",
    "pass": "Transparent",
    "blend": "Additive",
    "depthWrite": false
  },
  {
    // The same, blended rather than added: smoke, dust and blood darken what is behind them.
    "type": "material",
    "id": "particle_blend",
    "base": "sprite_default",
    "technique": "UnlitBlend",
    "pass": "Transparent",
    "blend": "AlphaBlend",
    "depthWrite": false
  },
  {
    // The fallback for broken materials and the placeholder for missing meshes (07 §8).
    "type": "material",
    "id": "error",
    "effect": "shaders/error.mgfxo",
    "fog": false
  }
]
