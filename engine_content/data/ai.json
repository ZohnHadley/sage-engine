[
  // AI profile and schedules (docs/design/16 §3.4). A schedule is an ordered task list plus the
  // conditions that interrupt it. A task is { "task": "<name>", "<argument>": number }, or just its
  // name when it takes nothing: Wait takes "seconds", MoveToTarget "distance", MeleeAttack and
  // CastSpell "giveUpAfter" (seconds).
  {
    "type": "ai_profile",
    "id": "default_ai",
    "sightRange": 22,
    "sightAngleDegrees": 200,
    "meleeRange": 1.8,
    "thinkRate": 6,
    "turnSpeedDegrees": 360
  },
  {
    "type": "ai_schedule",
    "id": "idle",
    "tasks": [{ "task": "Wait", "seconds": 1.5 }],
    "interrupts": ["SeeEnemy"]
  },
  {
    "type": "ai_schedule",
    "id": "chase",
    "tasks": [{ "task": "MoveToTarget", "distance": 1.6 }],
    "interrupts": ["EnemyInMeleeRange", "LostEnemy", "NoEnemy"]
  },
  {
    // Magic (16 §3.3). Face it, ask for the spell the think picked, then pause — the pause is what
    // paces a caster with no cooldown on its spell, and a cooldown effect paces one that has it.
    // Casting is chosen over chasing, so a creature that cannot swing stops walking into reach.
    "type": "ai_schedule",
    "id": "hold_ground",
    "tasks": ["FaceTarget", { "task": "Wait", "seconds": 0.3 }],
    "interrupts": ["LostEnemy", "NoEnemy"]
  },
  {
    // Waiting out a cooldown with the enemy already in range (16 §3.4): keep facing it, and think
    // again shortly, so the tick the spell comes back is close to the tick it is thrown. Without
    // this a creature that cannot swing charges between casts and ends up in melee reach with
    // nothing to do there.
    "type": "ai_schedule",
    "id": "cast_spell",
    "tasks": ["FaceTarget", { "task": "CastSpell", "giveUpAfter": 2 }, { "task": "Wait", "seconds": 0.8 }],
    "interrupts": ["LostEnemy", "NoEnemy"]
  },
  {
    "type": "ai_schedule",
    "id": "melee_attack",
    // MeleeAttack presses the Attack action and waits: what the swing does, how long it takes and
    // how often it may happen are the attack record's business (16 §3.2). The number is how long to
    // keep trying before giving up and thinking again.
    "tasks": ["FaceTarget", { "task": "MeleeAttack", "giveUpAfter": 1.5 }, { "task": "Wait", "seconds": 0.5 }],
    "interrupts": ["LostEnemy", "NoEnemy"]
  },
  {
    // Hearing (issue #386): what it does about a noise it cannot see the cause of. Face it, walk to
    // where it was, look round, and let it go. A new noise starts it again; seeing somebody ends it.
    "type": "ai_schedule",
    "id": "investigate",
    "tasks": ["FaceNoise", { "task": "MoveToNoise", "distance": 1.5 }, { "task": "Wait", "seconds": 3 }, "ForgetNoise"],
    "interrupts": ["SeeEnemy", "HearNoise"]
  }
]
