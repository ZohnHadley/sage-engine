[
  // AI profile and schedules (docs/design/16 §3.4). A schedule is an ordered task list plus the
  // conditions that interrupt it; tasks are registered by name and may take a number after a colon.
  {
    "type": "ai_profile",
    "id": "default_ai",
    "sightRange": 22,
    "sightAngleDegrees": 200,
    "meleeRange": 1.8,
    "thinkRate": 6,
    "turnSpeedDegrees": 360
  },
  {
    "type": "ai_schedule",
    "id": "idle",
    "tasks": ["Wait:1.5"],
    "interrupts": ["SeeEnemy"]
  },
  {
    "type": "ai_schedule",
    "id": "chase",
    "tasks": ["MoveToTarget:1.6"],
    "interrupts": ["EnemyInMeleeRange", "LostEnemy", "NoEnemy"]
  },
  {
    "type": "ai_schedule",
    "id": "melee_attack",
    // MeleeAttack presses the Attack action and waits: what the swing does, how long it takes and
    // how often it may happen are the attack record's business (16 §3.2). The number is how long to
    // keep trying before giving up and thinking again.
    "tasks": ["FaceTarget", "MeleeAttack:1.5", "Wait:0.5"],
    "interrupts": ["LostEnemy", "NoEnemy"]
  }
]
