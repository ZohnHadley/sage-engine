[
  // What the engine's gameplay means by its words (REDESIGN §3.1, issue #26). Gameplay code reads this
  // record instead of knowing an id: which attribute is life, which tag is death, what a hit or a swing
  // is when nobody said, which schedules a creature runs, which buttons do what.
  //
  // A kit or a game changes any of it by patching this record, from its own content:
  //   { "type": "gameplay_conventions", "id": "sage:default_conventions", "patch": true, "health": "hp" }
  // ("hp" is then the game's own attribute: an id in a patch resolves in the patch's namespace). A field
  // set to "" means the game has no such thing — no `health`, and nothing dies.
  {
    "type": "gameplay_conventions",
    "id": "default_conventions",
    "health": "health",
    "dead": "state.dead",
    "invulnerable": "state.invulnerable",
    "damageType": "physical",
    "attack": "default_attack",
    "hitboxBudget": "default_hitbox_budget",
    "movement": "default_movement",
    "aiProfile": "default_ai",
    "playerFaction": "player",
    "costAttribute": "mana",
    // What a footstep, a landing or a jump on ground with no surface (or a surface with no cue) sounds
    // like: this physics_material's cues (physics.json; a game patches either, issue #327).
    "surface": "default",
    "schedules": {
      "idle": "idle",
      "chase": "chase",
      "meleeAttack": "melee_attack",
      "castSpell": "cast_spell",
      "holdGround": "hold_ground",
      // Something heard and not yet looked into (issue #386): turn to it, walk there, look round.
      "investigate": "investigate"
    },
    // Input actions by name. Modules register these in Init, before content loads; a game that wants
    // its own registers them in its module and names them here.
    "actions": { "attack": "Attack", "use": "Use", "jump": "Jump", "run": "Run", "crouch": "Crouch" },
    // What combat and animation share (issues #27, #119, #121): the trigger a swing sets on the fighter's
    // animator (and its first-person arms'), the clip event that lands the blow, and the trigger Reload
    // sets on the arms. Which clip plays is the anim_graph's business. (`attack` and `idle`, the clip
    // names combat used to play, are obsolete: see 12 "As built (animation events)".)
    "animations": { "attackTrigger": "attack", "hit": "hit", "reload": "reload" }
  }
]
