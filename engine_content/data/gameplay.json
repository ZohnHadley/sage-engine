[
  // Attributes, tags and effects (docs/design/16 3.3). Games add their own and patch these.
  { "type": "attribute", "id": "health",  "start": 100, "min": 0, "max": 100 },
  { "type": "attribute", "id": "mana",    "start": 50,  "min": 0, "max": 50, "spendEffect": "spend_mana" },
  { "type": "attribute", "id": "stamina", "start": 100, "min": 0, "max": 100 },
  { "type": "attribute", "id": "armor",   "start": 0,   "min": 0, "max": 95 },

  // Resistances are percentages of the damage they stop (16 §3.2), capped below immunity.
  { "type": "attribute", "id": "fire_resist", "start": 0, "min": -100, "max": 90 },

  { "type": "tag", "id": "state.dead",         "description": "Health ran out" },
  { "type": "tag", "id": "state.invulnerable", "description": "Takes no damage (the god cheat)" },
  { "type": "tag", "id": "state.burning",      "description": "On fire" },
  { "type": "tag", "id": "element.fire",       "description": "This hit or effect is fire" },

  {
    // Fire damage over time: a timed effect that applies its modifier every period (16 3.3). It
    // changes health directly rather than going through the damage pipeline, so fire_resist does not
    // reduce it yet — periodic damage routed through Combat.ApplyDamage comes with abilities (F21).
    "type": "effect",
    "id": "burning",
    "duration": "Timed",
    "time": 4,
    "period": 1,
    "stacking": "Refresh",
    "grantTags": ["state.burning"],
    "blockTags": ["state.invulnerable"],
    "modifiers": [ { "attribute": "health", "op": "Add", "value": -4 } ]
  },
  {
    // How mana leaves you. A spell's cost is this effect at the cost's magnitude, so "free casting"
    // or "double cost" are effects on top rather than special cases in the caster (16 §3.3).
    "type": "effect",
    "id": "spend_mana",
    "modifiers": [ { "attribute": "mana", "op": "Add", "value": -1 } ]
  },
  {
    // A buff: while it runs, health's maximum contribution is raised.
    "type": "effect",
    "id": "vigour",
    "duration": "Timed",
    "time": 10,
    "modifiers": [ { "attribute": "stamina", "op": "Add", "value": 25 } ]
  }
]
