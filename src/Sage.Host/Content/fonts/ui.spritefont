<?xml version="1.0" encoding="utf-8"?>
<!--
  The HUD font (docs/design/13 §3). Built by MGCB from a system font, which is why this is the one
  piece of content that needs a font installed on the build machine; bundling a licensed TTF here
  would remove that.
-->
<XnaContent xmlns:Graphics="Microsoft.Xna.Framework.Content.Pipeline.Graphics">
  <Asset Type="Graphics:FontDescription">
    <FontName>Consolas</FontName>
    <Size>15</Size>
    <Spacing>0</Spacing>
    <UseKerning>true</UseKerning>
    <Style>Regular</Style>
    <CharacterRegions>
      <CharacterRegion>
        <Start>&#32;</Start>
        <End>&#126;</End>
      </CharacterRegion>
      <!-- What the screens draw (13 §3, F38): multiplication sign for stack counts, bullet for the
           equipped/readied tick, en and em dashes, ellipsis, and the four arrows a hint line uses.
           Anything outside these regions draws as '?' rather than throwing (ContentService). -->
      <CharacterRegion>
        <Start>&#215;</Start>
        <End>&#215;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#8211;</Start>
        <End>&#8212;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#8226;</Start>
        <End>&#8226;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#8230;</Start>
        <End>&#8230;</End>
      </CharacterRegion>
      <CharacterRegion>
        <Start>&#8592;</Start>
        <End>&#8595;</End>
      </CharacterRegion>
    </CharacterRegions>
  </Asset>
</XnaContent>
