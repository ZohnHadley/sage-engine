<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The executable: boot + main loop + content. For now it is both the game and the editor
    (today's app draws the ImGui editor panels), so it references Sage.Editor. A separate
    game host without the editor comes with the editor host work (docs/design/15, TODO F28).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Sage.Host</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Icon.ico" />
    <None Remove="Icon.bmp" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Icon.ico">
      <LogicalName>Icon.ico</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Icon.bmp">
      <LogicalName>Icon.bmp</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sage.Engine\Sage.Engine.csproj" />
    <ProjectReference Include="..\Sage.Client\Sage.Client.csproj" />
    <!--
      The editor and ImGui are referenced only where `SAGE_DEV` is defined (F28). A Shipping build of the
      game host therefore contains no editor, no developer console and no ImGui at all — which is what
      "a game host without the editor" has meant in this file's comments since the beginning.
    -->
    <ProjectReference Include="..\Sage.Editor\Sage.Editor.csproj" Condition="'$(Configuration)' != 'Shipping'" />
    <ProjectReference Include="..\..\third_party\MonoGame.ImGuiNet\Monogame.ImGuiNet.csproj" Condition="'$(Configuration)' != 'Shipping'" />
  </ItemGroup>

  <!-- engine_content/ → Content/ (shaders compiled with dotnet-mgfxc, data and textures copied). -->
  <Import Project="..\..\build\Sage.EngineContent.targets" />

  <!-- Only mgfxc now: shaders are the one thing still compiled at build time (R12). -->
  <Target Name="RestoreDotnetTools" BeforeTargets="Restore">
    <Message Text="Restoring dotnet tools" Importance="High" />
    <Exec Command="dotnet tool restore" />
  </Target>
</Project>
