<Project Sdk="Microsoft.NET.Sdk">
  <!--
    3D physics, a base plugin (REDESIGN §0.5, §3.1, issue #24): one BepuPhysics space per world
    (installed as IPhysicsWorld too), its tick systems, the kinematic character controller and the
    first-person rig. No MonoGame.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <SageSimulationOnly>true</SageSimulationOnly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sage.Simulation\Sage.Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sage.Tests" />
  </ItemGroup>

  <!-- The layers below, for every file (one namespace per assembly, REDESIGN §3.1). -->
  <ItemGroup>
    <Using Include="Sage.Core" />
    <Using Include="Sage.Simulation" />
    <!-- Friflo has a Transform too; this one is Sage's (docs/design/03 §3.1). -->
    <Using Include="Sage.Simulation.Transform" Alias="Transform" />
  </ItemGroup>
</Project>
