<Project Sdk="Microsoft.NET.Sdk">
  <!--
    3D physics, a base plugin (REDESIGN §0.5, §3.1, issue #24): one BepuPhysics space per world
    (installed as IPhysicsWorld too), its tick systems and the kinematic character controller; the
    first-person rig it installs is the simulation's (FirstPersonCameraSystem, issue #27). No MonoGame.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <SageBaseAssembly>true</SageBaseAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BepuPhysics" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sage.Simulation\Sage.Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sage.Tests" />
  </ItemGroup>

  <!-- The layers below, for every file (one namespace per assembly, REDESIGN §3.1). -->
  <ItemGroup>
    <Using Include="Sage.Core" />
    <Using Include="Sage.Simulation" />
  </ItemGroup>
</Project>
