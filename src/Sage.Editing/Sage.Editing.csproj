<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The editor's model (phase 10a, issue #216; REDESIGN §4.6, docs/design/15): commands and the undo
    log, documents, picking and gizmo maths, forms, wiring and play sessions — everything an editor does
    that is not drawing. Headless on purpose, like Sage.UI beside the client: a test opens a document,
    places a prefab, undoes it and plays the level through HeadlessApp, and `Sage.Editor` (ImGui) only
    draws what this decides. A base assembly (SageBaseAssembly): it never references a kit.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <SageBaseAssembly>true</SageBaseAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sage.Simulation\Sage.Simulation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sage.Tests" />
  </ItemGroup>

  <!-- The layers below, for every file (one namespace per assembly, REDESIGN §3.1). -->
  <ItemGroup>
    <Using Include="Sage.Core" />
    <Using Include="Sage.Simulation" />
  </ItemGroup>

  <!-- Experimental API (docs/MAKING_A_GAME.md §10b): the whole assembly is SAGE0133 while phase 10a
       builds on it; it uses its own types freely, and scenes and placements (SAGE0121) and saves'
       overrides (SAGE0131) are what it edits, with who wrote them (SAGE0132); a play session asks which scene
       the edit world is in (SAGE0129); the animation preview runs graphs and samples clips (SAGE0126, #362); the AI graph view asks which states a machine is in (SAGE0124, #369). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);SAGE0133;SAGE0123;SAGE0121;SAGE0131;SAGE0132;SAGE0129;SAGE0126;SAGE0124</NoWarn>
  </PropertyGroup>
</Project>
