<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Generic gameplay, the base plugins every genre can use (REDESIGN §0.5, §3.1, issue #24):
    attributes, effects, combat, items, abilities, AI, navigation, factions, dialogue and quest
    models, movers, sprite animation and lights; BasePlugins, the one list of the base's plugins.
    The RPG screens, the spellmaker and the readied spell are the RPG kit's (src/Sage.Kits.Rpg, #27),
    which this never references (SAGE0025). Gameplay code reaches physics
    only through IPhysicsWorld (Sage.Simulation, issue #30); the reference to Sage.Physics3D is there
    for BasePlugins and GameplayModules.All, the composition lists that name PhysicsModule and
    CharacterModule, and AssemblyLayeringTests holds it to that. No MonoGame.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <SageBaseAssembly>true</SageBaseAssembly>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sage.Physics3D\Sage.Physics3D.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sage.Tests" />
  </ItemGroup>

  <!-- The layers below, for every file (one namespace per assembly, REDESIGN §3.1). -->
  <ItemGroup>
    <Using Include="Sage.Core" />
    <Using Include="Sage.Simulation" />
  </ItemGroup>
</Project>
