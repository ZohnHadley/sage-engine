<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Simulation layer: core, world/ECS, components. Must never reference MonoGame
    (ARCHITECTURE.md §2 rule 2); math is System.Numerics (decision D2).
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <!-- ECS storage (decision D4; spike results in docs/design/03 §3.1). Components are structs
         implementing Friflo.Engine.ECS.IComponent; World (ECS/World.cs) is the thin wrapper. -->
    <PackageReference Include="BepuPhysics" />
    <PackageReference Include="Friflo.Engine.ECS" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sage.Client" />
    <InternalsVisibleTo Include="Sage.Editor" />
    <InternalsVisibleTo Include="Sage.Host" />
    <InternalsVisibleTo Include="Sage.Tests" />
  </ItemGroup>
</Project>
