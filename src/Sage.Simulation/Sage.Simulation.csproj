<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The simulation (REDESIGN §3.1, issue #24): the engine and its app (Engine, SageApp, modules), the
    World and its ECS (Sage's vocabulary over Friflo), systems and events, prefabs, saves, levels, streaming, entity I/O, and
    the data the client presents (render, audio, input and UI view-models). Must never reference
    MonoGame (ARCHITECTURE.md §2 rule 2); math is System.Numerics (decision D2). Physics is a plugin
    on top of it (Sage.Physics3D), reached through IPhysicsWorld.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <SageBaseAssembly>true</SageBaseAssembly>
    <!-- The one project that may name Friflo (SAGE0050, issue #25): it implements Sage's ECS vocabulary
         over it, in ECS/Api and World, behind `using F = Friflo.Engine.ECS;`. -->
    <SageEcsImplementation>true</SageEcsImplementation>
  </PropertyGroup>

  <ItemGroup>
    <!-- ECS storage (decision D4; spike results in docs/design/03 §3.1), under Sage's own types: Entity,
         IComponent, ITag, Tags, Query<…>, EntityCommands (ECS/Api, issue #25). Its compile assets still
         flow to every project above, because Sage's IComponent extends Friflo's (the schema scan and
         the generic constraints need it) and a derived interface needs its base to compile; SAGE0050
         is what keeps them from naming it. -->
    <PackageReference Include="Friflo.Engine.ECS" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sage.Core\Sage.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sage.Tests" />
    <!-- The one internal the client uses: RenderViewPlan (issue #77), the planning half of multi-view
         drawing, kept here so the headless tests can reach it. -->
    <InternalsVisibleTo Include="Sage.Client" />
  </ItemGroup>

  <!-- The layers below, for every file (one namespace per assembly, REDESIGN §3.1). -->
  <ItemGroup>
    <Using Include="Sage.Core" />
  </ItemGroup>
  <!-- Experimental API (issue #31, docs/MAKING_A_GAME.md §10b): the conditions and actions (SAGE0120, moved here from Sage.Gameplay by issue #89), scenes and placements (SAGE0121), brush maps (SAGE0122), cameras as entities (SAGE0123) and phase 4b's logic (SAGE0124: stage 2's condition and action language, easing) and skeletal animation (SAGE0126: GPU skinning's SkinMath and SkinnedMeshRenderer, #117) are declared here, and an assembly uses its own experimental types freely. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);SAGE0120;SAGE0121;SAGE0122;SAGE0123;SAGE0124;SAGE0126</NoWarn>
  </PropertyGroup>
</Project>
