<Project>
  <!-- Shared settings for every Sage engine project under src/. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <Import Project="..\build\Sage.Configurations.props" />
  <Import Project="..\build\Sage.Version.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <PublishReadyToRun>false</PublishReadyToRun>
    <TieredCompilation>false</TieredCompilation>
    <!-- Every engine project is simulation-only (no MonoGame, SAGE0024) unless it says otherwise:
         Sage.Client, Sage.Editor and Sage.Host do (issue #24). -->
    <SageSimulationOnly Condition="'$(SageSimulationOnly)' == ''">true</SageSimulationOnly>
  </PropertyGroup>

  <!-- Said in the assembly too, so a test can check every base assembly is what its project claims. -->
  <ItemGroup Condition="'$(SageSimulationOnly)' == 'true'">
    <AssemblyMetadata Include="SageSimulationOnly" Value="true" />
  </ItemGroup>

  <!-- The declarations generator (issue #16): registration written from [Record] and
       [SavedResource], and the component id table from [Component] / [Tag]. A project opts out with
       <SageGenerators>false</SageGenerators>. -->
  <ItemGroup Condition="'$(SageGenerators)' != 'false'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)Sage.Generators\Sage.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Project switches the Sage analyzers read (issue #19): SageSimulationOnly=true makes a MonoGame
       type an error (SAGE0024); SageStrictSaves=true asks every public component field for a
       [Property] or [Transient] decision (SAGE0023, off by default); SageBaseAssembly=true (the base
       engine's projects) makes a reference to a Sage.Kits.* assembly an error (SAGE0025, issue #24);
       SageEcsImplementation=true (Sage.Simulation only) lets a project name Friflo, which is otherwise
       an error (SAGE0050, issue #25). -->
  <ItemGroup Condition="'$(SageGenerators)' != 'false'">
    <CompilerVisibleProperty Include="SageSimulationOnly" />
    <CompilerVisibleProperty Include="SageStrictSaves" />
    <CompilerVisibleProperty Include="SageBaseAssembly" />
    <CompilerVisibleProperty Include="SageEcsImplementation" />
  </ItemGroup>

  <!--
    Public API discipline (issue #31, docs/RELEASING.md): every assembly a game, kit or mod compiles
    against keeps its public API in PublicAPI.Shipped.txt (what released versions had) and
    PublicAPI.Unshipped.txt (what changed since). Microsoft.CodeAnalysis.PublicApiAnalyzers compares the
    code with them, and since warnings are errors a public symbol added (RS0016), removed or changed
    (RS0017) without the files agreeing fails the build, on every job and platform. The host, the CLI,
    the editor and the generators are not compiled against by games, so they have no files.
  -->
  <PropertyGroup>
    <SagePublicApi Condition="'$(SagePublicApi)' == '' And ('$(MSBuildProjectName)' == 'Sage.Core' Or '$(MSBuildProjectName)' == 'Sage.Simulation'
                              Or '$(MSBuildProjectName)' == 'Sage.Physics3D' Or '$(MSBuildProjectName)' == 'Sage.Gameplay'
                              Or '$(MSBuildProjectName)' == 'Sage.Client' Or '$(MSBuildProjectName)' == 'Sage.Kits.Rpg'
                              Or '$(MSBuildProjectName)' == 'Sage.Kits.Rpg.Client')">true</SagePublicApi>
  </PropertyGroup>
  <!-- The package's two API-design rules about optional parameters (RS0026, RS0027) are advice, not
       declaration: Log.Info(cat, message, [CallerFilePath] file = "", ...) and friends are meant that way. -->
  <PropertyGroup Condition="'$(SagePublicApi)' == 'true'">
    <NoWarn>$(NoWarn);RS0026;RS0027</NoWarn>
  </PropertyGroup>
  <ItemGroup Condition="'$(SagePublicApi)' == 'true'">
    <!-- The package adds both files as AdditionalFiles when they exist; without them it checks nothing. -->
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" PrivateAssets="all" />
  </ItemGroup>
  <Target Name="SageCheckPublicApiFiles" BeforeTargets="CoreCompile" Condition="'$(SagePublicApi)' == 'true'">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/PublicAPI.Shipped.txt') Or !Exists('$(MSBuildProjectDirectory)/PublicAPI.Unshipped.txt')"
           Text="$(MSBuildProjectName) has no PublicAPI.Shipped.txt / PublicAPI.Unshipped.txt: its public API must be declared (docs/RELEASING.md)" />
  </Target>
</Project>
