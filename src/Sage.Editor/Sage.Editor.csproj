<Project Sdk="Microsoft.NET.Sdk">
  <!-- Editor/dev tools: ImGui panels, the free-fly dev camera, editor state. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <SageSimulationOnly>false</SageSimulationOnly>
    <SageBaseAssembly>true</SageBaseAssembly>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>   <!-- the ImGui input-text callback takes a pointer (#299) -->
  </PropertyGroup>

  <!-- Experimental API (issue #31, docs/MAKING_A_GAME.md §10b): the editor's free camera and viewport are camera entities drawing into a render target (SAGE0123, issue #81). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);SAGE0123</NoWarn>
    <!-- The editor's model (Sage.Editing, phase 10a) is SAGE0133 while 10a builds it. -->
    <NoWarn>$(NoWarn);SAGE0133</NoWarn>
    <!-- The inspector's placement form edits a placement's fields (scenes and placements, SAGE0121; #223). -->
    <NoWarn>$(NoWarn);SAGE0121</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sage.Client\Sage.Client.csproj" />
    <!-- The editor's model (phase 10a): this assembly only draws what Sage.Editing decides. -->
    <ProjectReference Include="..\Sage.Editing\Sage.Editing.csproj" />
    <ProjectReference Include="..\..\third_party\MonoGame.ImGuiNet\Monogame.ImGuiNet.csproj" />
  </ItemGroup>

  <!-- The layers below, for every file (one namespace per assembly, REDESIGN §3.1). -->
  <ItemGroup>
    <Using Include="Sage.Core" />
    <Using Include="Sage.Simulation" />
    <Using Include="Sage.Physics3D" />
    <Using Include="Sage.Gameplay" />
    <Using Include="Sage.Client" />
    <Using Include="Sage.Editing" />
  </ItemGroup>
</Project>
