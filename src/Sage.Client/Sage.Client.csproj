<Project Sdk="Microsoft.NET.Sdk">
  <!-- Client layer: rendering, input, client-side assets. The only engine layer that uses MonoGame. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <SageSimulationOnly>false</SageSimulationOnly>
    <SageBaseAssembly>true</SageBaseAssembly>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MonoGame.Framework.DesktopGL" />
    <PackageReference Include="SharpGLTF.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- The base engine it presents: the simulation and every base plugin (issue #24). -->
    <ProjectReference Include="..\Sage.Gameplay\Sage.Gameplay.csproj" />
    <!-- The retained widgets it will draw (issue #95; the drawing is #97): Simulation ← UI ← Client. -->
    <ProjectReference Include="..\Sage.UI\Sage.UI.csproj" />
  </ItemGroup>

  <!-- The layers below, for every file (one namespace per assembly, REDESIGN §3.1). -->
  <ItemGroup>
    <Using Include="Sage.Core" />
    <Using Include="Sage.Simulation" />
    <Using Include="Sage.Physics3D" />
    <Using Include="Sage.Gameplay" />
  </ItemGroup>
  <!-- Experimental API (issue #31, docs/MAKING_A_GAME.md §10b): the client draws brush maps (SAGE0122, MapLevels) and the views of camera entities (SAGE0123, CameraViews),
       and widget screens (SAGE0125, Sage.UI; #97), whose transitions ease with 4b's curves (SAGE0124), and skinned meshes (SAGE0126, #117). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);SAGE0122;SAGE0123;SAGE0124;SAGE0125;SAGE0126</NoWarn>
  </PropertyGroup>
</Project>
