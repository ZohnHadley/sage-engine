<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The kernel (REDESIGN §3.1, issue #24): cvars and the console, logging, diagnostics, the virtual
    file system, records, plugin identity and versions, and the declaration attributes the metadata
    table reads. No ECS, no physics, no MonoGame: nothing here knows what a World is.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <SageBaseAssembly>true</SageBaseAssembly>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sage.Tests" />
  </ItemGroup>
  <!-- Experimental API (docs/MAKING_A_GAME.md §10b): the vocabulary shorthand of stage 2's condition and action language (SAGE0124, issue #89) is declared here, as are merge provenance and the content report (SAGE0132, 4j-2) and the editor's file-preserving write-back (SAGE0133, JsonFileEdit, #218), and an assembly uses its own experimental API freely. -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);SAGE0124;SAGE0132;SAGE0133</NoWarn>
  </PropertyGroup>
</Project>
