<Project Sdk="Microsoft.NET.Sdk">
  <!--
    `sage`, the engine's command line (REDESIGN §4.2, §4.8). Headless: it references the base engine
    (Sage.Gameplay and below) and nothing with a window, so it runs on a build machine. Verbs:
      sage validate (game folder) [mounts ...] [engine content folder]; Program.cs has the options
    Build it with the solution and run src/Sage.Cli/bin/(config)/net8.0/sage, or run it through
    `dotnet run` with the project path (MAKING_A_GAME.md, "Checking content").
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>sage</AssemblyName>
    <!-- Declares nothing, so there is nothing to generate. -->
    <SageGenerators>false</SageGenerators>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sage.Gameplay\Sage.Gameplay.csproj" />
  </ItemGroup>

  <!-- The layers below, for every file (one namespace per assembly, REDESIGN §3.1). -->
  <ItemGroup>
    <Using Include="Sage.Core" />
    <Using Include="Sage.Simulation" />
    <Using Include="Sage.Physics3D" />
    <Using Include="Sage.Gameplay" />
  </ItemGroup>
</Project>
