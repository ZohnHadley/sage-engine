<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The RPG kit's simulation half (REDESIGN §0.5, §3.1, issue #27): what the action-RPG family —
    Daggerfall, Morrowind, S.T.A.L.K.E.R. — shares and a platformer does not. The spellmaker and its
    book, the readied spell a Cast button fires, the bag and spellbook panels, and the journal,
    conversation and spellmaker screens. Built on the base with its public API only; the base never
    references it (SAGE0025). Plugin `sage.kits.rpg`; a game opts in with game.json's "kits".

    Not a base assembly (no SageBaseAssembly), and not in BasePlugins.All(). No MonoGame: the screens
    here are the simulation's (Screen, Panel); drawing them is the client's, and the client half
    (Sage.Kits.Rpg.Client) says which screen is which.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Sage.Kits.Rpg</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sage.Gameplay\Sage.Gameplay.csproj" />
    <!-- The retained UI (issue #95/#96): the inventory, equipment, loot, topics,
         journal, map and shop screens are view-models over it, built from the kit's own ui_layout and
         screen records (issues #98, #99). -->
    <ProjectReference Include="..\Sage.UI\Sage.UI.csproj" />
  </ItemGroup>

  <!-- The kit's content (issue #98, [PluginContent("rpg")]): records and string tables carried in the
       assembly, mounted after engine content and before the game's, so a game patches them. -->
  <ItemGroup>
    <EmbeddedResource Include="content/**/*" LogicalName="content/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Experimental API (docs/MAKING_A_GAME.md §10b): the screens are Sage.UI's (SAGE0125) and the topics
       screen reads DialogueTopics (SAGE0124); the ammunition readout reads the 4e magazine (SAGE0127); the rest
       screen and the map's fast travel read the open world's time and travel (SAGE0129, issue 4g-7). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);SAGE0124;SAGE0125;SAGE0127;SAGE0129</NoWarn>
  </PropertyGroup>

  <!-- The layers below, for every file. -->
  <ItemGroup>
    <Using Include="Sage.Core" />
    <Using Include="Sage.Simulation" />
    <Using Include="Sage.Gameplay" />
  </ItemGroup>
</Project>
