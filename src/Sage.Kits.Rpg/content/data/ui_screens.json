[
  // The RPG kit's screens (issue #98): each a `screen` naming its layout and its view-model (the kit's
  // C#, src/Sage.Kits.Rpg/*View.cs), and each layout a flat tree of named nodes (13 "As built
  // (style and layout records)"). A game moves, restyles, retranslates or adds to any node with a patch:
  //   { "type": "ui_layout", "id": "rpg:inventory", "patch": true, "nodes": { "hint": { "visible": false } } }
  //
  // A grid binds its rows to an ItemGrid's `cells` (one square each: `label`, `style`, `tooltip`) and its
  // width to its `columns`; its row template is the one node inside it. A stack's square at its top left
  // spans its footprint and shows its picture (`columnSpan`, `rowSpan`, `icon`, `iconTurned`), its other
  // squares hide (`shown`), and a square can be dragged (issue #346).

  // ---- inventory: the bag as a grid, with its weight ----------------------------------------------
  { "type": "screen", "id": "inventory", "layout": "inventory", "viewModel": "rpg_inventory" },
  { "type": "ui_layout", "id": "inventory", "style": "panel",
    "nodes": {
      "window":     { "widget": "stack", "anchors": "center", "spacing": 6 },
      "title":      { "widget": "label", "parent": "window", "text": "@rpg.inventory.title", "style": "title" },
      "weight":     { "widget": "label", "parent": "window", "style": "text", "text": "@rpg.inventory.weight",
                      "args": { "current": "bag.weight", "max": "bag.capacity" }, "bindings": { "visible": "bag.limited" } },
      "weight_any": { "widget": "label", "parent": "window", "style": "text", "text": "@rpg.inventory.weight_unlimited",
                      "args": { "current": "bag.weight" }, "bindings": { "visible": "bag.unlimited" } },
      "weight_bar": { "widget": "bar", "parent": "window", "style": "weight_bar", "bind": "bag.weight",
                      "bindings": { "max": "bag.capacity", "visible": "bag.limited" }, "minSize": [0, 8] },
      "cells":      { "widget": "grid", "parent": "window", "bind": "bag.cells", "bindings": { "columns": "bag.columns" },
                      "uniform": true, "spacing": 2 },
      "cell":       { "widget": "button", "parent": "cells", "style": "cell", "bind": "label",
                      "draggable": true,
                      "bindings": { "style": "style", "tooltip": "tooltip", "visible": "shown", "columnSpan": "columnSpan",
                                    "rowSpan": "rowSpan", "icon": "icon", "iconTurned": "iconTurned" }, "minSize": [56, 56] },
      "holding":    { "widget": "label", "parent": "window", "style": "text", "text": "@rpg.grid.holding",
                      "args": { "item": "heldLabel" }, "bindings": { "visible": "holding" } },
      "message":    { "widget": "label", "parent": "window", "style": "warning", "bind": "message" },
      "hint":       { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.inventory.hint" }
    } },

  // ---- equipment: what is worn, slot by slot, and what could be -----------------------------------
  { "type": "screen", "id": "equipment", "layout": "equipment", "viewModel": "rpg_equipment" },
  { "type": "ui_layout", "id": "equipment", "style": "panel",
    "nodes": {
      "window":     { "widget": "stack", "anchors": "center", "spacing": 6, "minSize": [420, 0] },
      "title":      { "widget": "label", "parent": "window", "text": "@rpg.equipment.title", "style": "title" },
      "slots":      { "widget": "item_list", "parent": "window", "bind": "slots", "spacing": 2 },
      "slot":       { "widget": "button", "parent": "slots", "style": "button", "bind": "text", "textAlign": "start" },
      "ammo":       { "widget": "label", "parent": "window", "style": "text", "text": "@rpg.equipment.ammo",
                      "args": { "rounds": "ammo.text" }, "bindings": { "visible": "ammo.has" } },
      "wearable":   { "widget": "label", "parent": "window", "style": "text", "text": "@rpg.equipment.wearable" },
      "candidates": { "widget": "item_list", "parent": "window", "bind": "candidates", "spacing": 2 },
      "candidate":  { "widget": "button", "parent": "candidates", "style": "button", "bind": "text", "textAlign": "start" },
      "message":    { "widget": "label", "parent": "window", "style": "warning", "bind": "message" },
      "hint":       { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.equipment.hint" }
    } },

  // ---- loot: a corpse's or a chest's grid beside the bag's, and take all ---------------------------
  { "type": "screen", "id": "loot", "layout": "loot", "viewModel": "rpg_loot" },
  { "type": "ui_layout", "id": "loot", "style": "panel",
    "nodes": {
      "window":      { "widget": "stack", "anchors": "center", "spacing": 6 },
      "sides":       { "widget": "stack", "parent": "window", "direction": "row", "spacing": 16 },

      "theirs":      { "widget": "stack", "parent": "sides", "spacing": 4 },
      "their_title": { "widget": "label", "parent": "theirs", "style": "title", "text": "@rpg.loot.title",
                       "args": { "who": "containerName" } },
      "their_cells": { "widget": "grid", "parent": "theirs", "bind": "container.cells",
                       "bindings": { "columns": "container.columns" }, "uniform": true, "spacing": 2 },
      "their_cell":  { "widget": "button", "parent": "their_cells", "style": "cell", "bind": "label",
                       "draggable": true,
                      "bindings": { "style": "style", "tooltip": "tooltip", "visible": "shown", "columnSpan": "columnSpan",
                                    "rowSpan": "rowSpan", "icon": "icon", "iconTurned": "iconTurned" }, "minSize": [48, 48] },
      "empty":       { "widget": "label", "parent": "theirs", "style": "hint", "text": "@rpg.loot.empty",
                       "bindings": { "visible": "isEmpty" } },

      "yours":       { "widget": "stack", "parent": "sides", "spacing": 4 },
      "your_title":  { "widget": "label", "parent": "yours", "style": "title", "text": "@rpg.loot.yours" },
      "weight":      { "widget": "label", "parent": "yours", "style": "text", "text": "@rpg.inventory.weight",
                       "args": { "current": "bag.weight", "max": "bag.capacity" }, "bindings": { "visible": "bag.limited" } },
      "weight_bar":  { "widget": "bar", "parent": "yours", "style": "weight_bar", "bind": "bag.weight",
                       "bindings": { "max": "bag.capacity", "visible": "bag.limited" }, "minSize": [0, 8] },
      "your_cells":  { "widget": "grid", "parent": "yours", "bind": "bag.cells",
                       "bindings": { "columns": "bag.columns" }, "uniform": true, "spacing": 2 },
      "your_cell":   { "widget": "button", "parent": "your_cells", "style": "cell", "bind": "label",
                       "draggable": true,
                      "bindings": { "style": "style", "tooltip": "tooltip", "visible": "shown", "columnSpan": "columnSpan",
                                    "rowSpan": "rowSpan", "icon": "icon", "iconTurned": "iconTurned" }, "minSize": [48, 48] },

      "take_all":    { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.loot.take_all", "hAlign": "center" },
      "holding":     { "widget": "label", "parent": "window", "style": "text", "text": "@rpg.grid.holding",
                       "args": { "item": "heldLabel" }, "bindings": { "visible": "holding" } },
      "message":     { "widget": "label", "parent": "window", "style": "warning", "bind": "message" },
      "hint":        { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.loot.hint" }
    } },

  // ---- topics: Morrowind's keywords down one side, the answer beside them --------------------------
  { "type": "screen", "id": "topics", "layout": "topics", "viewModel": "rpg_topics" },
  { "type": "ui_layout", "id": "topics", "style": "panel",
    "nodes": {
      "window":  { "widget": "stack", "anchors": "center", "spacing": 6 },
      "title":   { "widget": "label", "parent": "window", "style": "title", "text": "@rpg.topics.title",
                   "args": { "who": "speaker" } },
      "body":    { "widget": "stack", "parent": "window", "direction": "row", "spacing": 12 },
      "scroll":  { "widget": "scroll", "parent": "body", "minSize": [220, 320] },
      "list":    { "widget": "item_list", "parent": "scroll", "bind": "topics", "spacing": 1 },
      "topic":   { "widget": "button", "parent": "list", "style": "topic", "bind": "keyword",
                   "bindings": { "style": "style" }, "textAlign": "start" },
      "answer":  { "widget": "label", "parent": "body", "style": "text", "bind": "answer", "minSize": [420, 0], "vAlign": "start",
                   "wrap": true, "maxWidth": 420 },
      "none":    { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.topics.none",
                   "bindings": { "visible": "noTopics" } },
      "hint":    { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.topics.hint" }
    } },

  // ---- shop: the shell of #99 — the merchant's goods beside the bag, each move across priced by a stub
  // rule (ShopView.Prices) and added to a balance; barter proper is phase 4f ---------------------------
  { "type": "screen", "id": "shop", "layout": "shop", "viewModel": "rpg_shop" },
  { "type": "ui_layout", "id": "shop", "style": "panel",
    "nodes": {
      "window":      { "widget": "stack", "anchors": "center", "spacing": 6 },
      "sides":       { "widget": "stack", "parent": "window", "direction": "row", "spacing": 16 },

      "stock":       { "widget": "stack", "parent": "sides", "spacing": 4 },
      "stock_title": { "widget": "label", "parent": "stock", "style": "title", "text": "@rpg.shop.title",
                       "args": { "who": "merchantName" } },
      "stock_cells": { "widget": "grid", "parent": "stock", "bind": "stock.cells",
                       "bindings": { "columns": "stock.columns" }, "uniform": true, "spacing": 2 },
      "stock_cell":  { "widget": "button", "parent": "stock_cells", "style": "cell", "bind": "label",
                       "draggable": true,
                      "bindings": { "style": "style", "tooltip": "tooltip", "visible": "shown", "columnSpan": "columnSpan",
                                    "rowSpan": "rowSpan", "icon": "icon", "iconTurned": "iconTurned" }, "minSize": [48, 48] },

      "yours":       { "widget": "stack", "parent": "sides", "spacing": 4 },
      "your_title":  { "widget": "label", "parent": "yours", "style": "title", "text": "@rpg.shop.yours" },
      "your_cells":  { "widget": "grid", "parent": "yours", "bind": "bag.cells",
                       "bindings": { "columns": "bag.columns" }, "uniform": true, "spacing": 2 },
      "your_cell":   { "widget": "button", "parent": "your_cells", "style": "cell", "bind": "label",
                       "draggable": true,
                      "bindings": { "style": "style", "tooltip": "tooltip", "visible": "shown", "columnSpan": "columnSpan",
                                    "rowSpan": "rowSpan", "icon": "icon", "iconTurned": "iconTurned" }, "minSize": [48, 48] },

      "buying":      { "widget": "label", "parent": "window", "style": "text", "text": "@rpg.shop.buy",
                       "args": { "item": "heldLabel", "price": "heldPrice" }, "bindings": { "visible": "heldIsStock" } },
      "balance":     { "widget": "label", "parent": "window", "style": "text", "text": "@rpg.shop.balance",
                       "args": { "balance": "balance" } },
      "message":     { "widget": "label", "parent": "window", "style": "warning", "bind": "message" },
      "hint":        { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.shop.hint" }
    } },

  // ---- rest: how many hours, then sleep or wait (issue 4g-7) ---------------------------------------
  // The slider is a bar between `less` and `more`; `sleep` is enabled when the kit's rule allows it
  // (Rest.Can: no enemy near), and `refused` says why not.
  { "type": "screen", "id": "rest", "layout": "rest", "viewModel": "rpg_rest" },
  { "type": "ui_layout", "id": "rest", "style": "panel",
    "nodes": {
      "window":   { "widget": "stack", "anchors": "center", "spacing": 6, "minSize": [360, 0] },
      "title":    { "widget": "label", "parent": "window", "style": "title", "text": "@rpg.rest.title" },
      "now":      { "widget": "label", "parent": "window", "style": "text", "bind": "now" },
      "hours":    { "widget": "label", "parent": "window", "style": "text", "text": "@rpg.rest.hours",
                    "args": { "count": "hours", "hours": "hours" } },
      "slider":   { "widget": "stack", "parent": "window", "direction": "row", "spacing": 6 },
      "less":     { "widget": "button", "parent": "slider", "style": "button", "text": "@rpg.rest.less" },
      "bar":      { "widget": "bar", "parent": "slider", "style": "weight_bar", "bind": "hours",
                    "bindings": { "max": "maxHours" }, "minSize": [200, 8], "expand": 1, "vAlign": "center" },
      "more":     { "widget": "button", "parent": "slider", "style": "button", "text": "@rpg.rest.more" },
      "buttons":  { "widget": "stack", "parent": "window", "direction": "row", "spacing": 8 },
      "sleep":    { "widget": "button", "parent": "buttons", "style": "button", "text": "@rpg.rest.sleep",
                    "bindings": { "enabled": "canSleep" } },
      "wait":     { "widget": "button", "parent": "buttons", "style": "button", "text": "@rpg.rest.wait",
                    "bindings": { "enabled": "canWait" } },
      "refused":  { "widget": "label", "parent": "window", "style": "warning", "bind": "refused" },
      "message":  { "widget": "label", "parent": "window", "style": "text", "bind": "message" },
      "hint":     { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.rest.hint" }
    } },

  // ---- mods: what was found, switched on and off, in what order, and where they conflict (issue 4j-6) --
  // Over `ui_mods` (Sage.UI ModsView), a view of the engine's ModManager: a switch and earlier/later per
  // mod write user://mods.json, and apply at the next start. The second tab is `mod_conflicts`' conflicts.
  { "type": "screen", "id": "mods", "layout": "mods", "viewModel": "ui_mods" },
  { "type": "ui_layout", "id": "mods", "style": "panel",
    "nodes": {
      "window":     { "widget": "stack", "anchors": "center", "spacing": 6, "minSize": [560, 0] },
      "title":      { "widget": "label", "parent": "window", "style": "title", "text": "@rpg.mods.title" },
      "tabs":       { "widget": "stack", "parent": "window", "direction": "row", "spacing": 8 },
      "tabMods":    { "widget": "button", "parent": "tabs", "style": "button", "text": "@rpg.mods.tab_mods", "args": { "count": "modCount" } },
      "tabConflicts": { "widget": "button", "parent": "tabs", "style": "button", "text": "@rpg.mods.tab_conflicts", "args": { "count": "conflictCount" } },

      "none":       { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.mods.none",
                      "bindings": { "visible": "noMods" } },
      "list":       { "widget": "scroll", "parent": "window", "minSize": [0, 240], "bindings": { "visible": "showMods" } },
      "mods":       { "widget": "item_list", "parent": "list", "bind": "mods", "spacing": 2 },
      "mod":        { "widget": "stack", "parent": "mods", "direction": "row", "spacing": 8 },
      "place":      { "widget": "label", "parent": "mod", "style": "hint", "bind": "place", "minSize": [24, 0] },
      "name":       { "widget": "label", "parent": "mod", "style": "text", "text": "@rpg.mods.name",
                      "args": { "name": "name", "version": "version" }, "expand": 1 },
      "reason":     { "widget": "label", "parent": "mod", "style": "warning", "bind": "reason", "bindings": { "visible": "hasReason" } },
      "state":      { "widget": "label", "parent": "mod", "style": "hint", "bind": "state" },
      "earlier":    { "widget": "button", "parent": "mod", "style": "button", "text": "@rpg.mods.earlier", "bindings": { "visible": "canMove" } },
      "later":      { "widget": "button", "parent": "mod", "style": "button", "text": "@rpg.mods.later", "bindings": { "visible": "canMove" } },
      "toggle":     { "widget": "button", "parent": "mod", "style": "button", "bind": "toggleLabel", "bindings": { "visible": "canToggle" } },

      "noConflicts": { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.mods.no_conflicts",
                      "bindings": { "visible": "showConflicts" } },
      "clist":      { "widget": "scroll", "parent": "window", "minSize": [0, 240], "bindings": { "visible": "showConflicts" } },
      "conflicts":  { "widget": "item_list", "parent": "clist", "bind": "conflicts", "spacing": 2 },
      "conflict":   { "widget": "label", "parent": "conflicts", "style": "text", "bind": "line" },

      "restart":    { "widget": "label", "parent": "window", "style": "warning", "text": "@rpg.mods.restart",
                      "bindings": { "visible": "restartNeeded" } },
      "message":    { "widget": "label", "parent": "window", "style": "text", "bind": "message", "args": { "mod": "messageMod" } },
      "hint":       { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.mods.hint" }
    } }
  ,

  // ---- controls: the buttons of each input context and the keys they have, rebound by pressing one (#328) --
  // Over `ui_controls` (Sage.UI ControlsView), a view of the engine's InputRebinds: Rebind waits for the next
  // key, mouse or pad button; a conflict asks to replace or keep; every change is written to
  // user://input.json and is in force at once (the console's bind / unbind / bind_reset do the same).
  { "type": "screen", "id": "controls", "layout": "controls", "viewModel": "ui_controls" },
  { "type": "ui_layout", "id": "controls", "style": "panel",
    "nodes": {
      "window":     { "widget": "stack", "anchors": "center", "spacing": 6, "minSize": [560, 0] },
      "title":      { "widget": "label", "parent": "window", "style": "title", "text": "@rpg.controls.title" },
      "tabs":       { "widget": "stack", "parent": "window", "direction": "row", "spacing": 8 },
      "tabGameplay": { "widget": "button", "parent": "tabs", "style": "button", "text": "@rpg.controls.ctx_Gameplay" },
      "tabUI":      { "widget": "button", "parent": "tabs", "style": "button", "text": "@rpg.controls.ctx_UI" },
      "tabEditor":  { "widget": "button", "parent": "tabs", "style": "button", "text": "@rpg.controls.ctx_Editor" },
      "tabConsole": { "widget": "button", "parent": "tabs", "style": "button", "text": "@rpg.controls.ctx_Console" },
      "context":    { "widget": "label", "parent": "window", "style": "hint", "bind": "contextLabel" },

      "none":       { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.controls.none", "bindings": { "visible": "noRows" } },
      "list":       { "widget": "scroll", "parent": "window", "minSize": [0, 240] },
      "rows":       { "widget": "item_list", "parent": "list", "bind": "rows", "spacing": 2 },
      "row":        { "widget": "stack", "parent": "rows", "direction": "row", "spacing": 8 },
      "action":     { "widget": "label", "parent": "row", "style": "text", "bind": "action", "minSize": [160, 0] },
      "bindings":   { "widget": "label", "parent": "row", "style": "hint", "bind": "bindings", "expand": 1 },
      "rebind":     { "widget": "button", "parent": "row", "style": "button", "bind": "rebindLabel" },
      "reset":      { "widget": "button", "parent": "row", "style": "button", "text": "@rpg.controls.reset", "bindings": { "visible": "overridden" } },

      "capturing":  { "widget": "label", "parent": "window", "style": "warning", "text": "@rpg.controls.capturing",
                      "args": { "action": "captureAction" }, "bindings": { "visible": "capturing" } },
      "conflict":   { "widget": "label", "parent": "window", "style": "warning", "text": "@rpg.controls.conflict",
                      "args": { "input": "conflictInput", "others": "conflictOthers" }, "bindings": { "visible": "conflictPending" } },
      "choice":     { "widget": "stack", "parent": "window", "direction": "row", "spacing": 8, "bindings": { "visible": "canReplace" } },
      "replace":    { "widget": "button", "parent": "choice", "style": "button", "text": "@rpg.controls.replace" },
      "keep":       { "widget": "button", "parent": "choice", "style": "button", "text": "@rpg.controls.keep" },
      "message":    { "widget": "label", "parent": "window", "style": "text", "bind": "message",
                      "args": { "others": "messageDetail" }, "bindings": { "visible": "hasMessage" } },
      "resetAll":   { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.controls.reset_all" },
      "hint":       { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.controls.hint" }
    } }
  ,

  // ---- options: graphics, audio, controls and gameplay, each setting a ui_option record over a cvar (#339) --
  // Over `ui_options` (Sage.UI OptionsView): a page of rows per tab, each row a slider, a toggle or a choice
  // as its option's kind says. Changes are staged (a `*` marks one) until Apply writes them to the cvars;
  // Revert puts back what the cvars say, Defaults stages every default, and Back with changes asks. The
  // options themselves are content: data/ui_options.json. Key bindings opens rpg:controls (#328).
  { "type": "screen", "id": "options", "layout": "options", "viewModel": "ui_options" },
  { "type": "ui_layout", "id": "options", "style": "panel",
    "nodes": {
      "window":     { "widget": "stack", "anchors": "center", "spacing": 6, "minSize": [640, 0] },
      "title":      { "widget": "label", "parent": "window", "style": "title", "text": "@rpg.options.title" },
      "pages":      { "widget": "tabs", "parent": "window", "bind": "page", "spacing": 6, "tabStyle": "tab" },

      "graphics":   { "widget": "stack", "parent": "pages", "title": "@rpg.options.graphics", "spacing": 2 },
      "g_list":   { "widget": "item_list", "parent": "graphics", "bind": "graphics", "spacing": 2 },
      "g_row":    { "widget": "stack", "parent": "g_list", "direction": "row", "spacing": 8 },
      "g_label":  { "widget": "label", "parent": "g_row", "style": "text", "bind": "label", "minSize": [220, 0], "vAlign": "center" },
      "g_slider": { "widget": "slider", "parent": "g_row", "style": "slider", "bind": "value",
                     "bindings": { "min": "min", "max": "max", "visible": "isSlider" }, "minSize": [200, 12], "vAlign": "center" },
      "g_value":  { "widget": "label", "parent": "g_row", "style": "hint", "bind": "valueText",
                     "bindings": { "visible": "isSlider" }, "minSize": [90, 0], "vAlign": "center" },
      "g_toggle": { "widget": "checkbox", "parent": "g_row", "style": "button", "bind": "checked",
                     "bindings": { "visible": "isToggle" } },
      "g_choice": { "widget": "dropdown", "parent": "g_row", "style": "button", "bind": "selected",
                     "bindings": { "options": "choices", "visible": "isChoice" }, "minSize": [200, 0] },
      "g_dirty":  { "widget": "label", "parent": "g_row", "style": "warning", "text": "*",
                     "bindings": { "visible": "dirty" }, "vAlign": "center" },

      "audio":      { "widget": "stack", "parent": "pages", "title": "@rpg.options.audio", "spacing": 2 },
      "a_list":   { "widget": "item_list", "parent": "audio", "bind": "audio", "spacing": 2 },
      "a_row":    { "widget": "stack", "parent": "a_list", "direction": "row", "spacing": 8 },
      "a_label":  { "widget": "label", "parent": "a_row", "style": "text", "bind": "label", "minSize": [220, 0], "vAlign": "center" },
      "a_slider": { "widget": "slider", "parent": "a_row", "style": "slider", "bind": "value",
                     "bindings": { "min": "min", "max": "max", "visible": "isSlider" }, "minSize": [200, 12], "vAlign": "center" },
      "a_value":  { "widget": "label", "parent": "a_row", "style": "hint", "bind": "valueText",
                     "bindings": { "visible": "isSlider" }, "minSize": [90, 0], "vAlign": "center" },
      "a_toggle": { "widget": "checkbox", "parent": "a_row", "style": "button", "bind": "checked",
                     "bindings": { "visible": "isToggle" } },
      "a_choice": { "widget": "dropdown", "parent": "a_row", "style": "button", "bind": "selected",
                     "bindings": { "options": "choices", "visible": "isChoice" }, "minSize": [200, 0] },
      "a_dirty":  { "widget": "label", "parent": "a_row", "style": "warning", "text": "*",
                     "bindings": { "visible": "dirty" }, "vAlign": "center" },

      "controls":   { "widget": "stack", "parent": "pages", "title": "@rpg.options.controls", "spacing": 2 },
      "c_list":   { "widget": "item_list", "parent": "controls", "bind": "controls", "spacing": 2 },
      "c_row":    { "widget": "stack", "parent": "c_list", "direction": "row", "spacing": 8 },
      "c_label":  { "widget": "label", "parent": "c_row", "style": "text", "bind": "label", "minSize": [220, 0], "vAlign": "center" },
      "c_slider": { "widget": "slider", "parent": "c_row", "style": "slider", "bind": "value",
                     "bindings": { "min": "min", "max": "max", "visible": "isSlider" }, "minSize": [200, 12], "vAlign": "center" },
      "c_value":  { "widget": "label", "parent": "c_row", "style": "hint", "bind": "valueText",
                     "bindings": { "visible": "isSlider" }, "minSize": [90, 0], "vAlign": "center" },
      "c_toggle": { "widget": "checkbox", "parent": "c_row", "style": "button", "bind": "checked",
                     "bindings": { "visible": "isToggle" } },
      "c_choice": { "widget": "dropdown", "parent": "c_row", "style": "button", "bind": "selected",
                     "bindings": { "options": "choices", "visible": "isChoice" }, "minSize": [200, 0] },
      "c_dirty":  { "widget": "label", "parent": "c_row", "style": "warning", "text": "*",
                     "bindings": { "visible": "dirty" }, "vAlign": "center" },
      "keys":       { "widget": "button", "parent": "controls", "style": "button", "text": "@rpg.options.keys",
                      "bindings": { "visible": "hasControls" }, "hAlign": "start" },

      "gameplay":   { "widget": "stack", "parent": "pages", "title": "@rpg.options.gameplay", "spacing": 2 },
      "p_list":   { "widget": "item_list", "parent": "gameplay", "bind": "gameplay", "spacing": 2 },
      "p_row":    { "widget": "stack", "parent": "p_list", "direction": "row", "spacing": 8 },
      "p_label":  { "widget": "label", "parent": "p_row", "style": "text", "bind": "label", "minSize": [220, 0], "vAlign": "center" },
      "p_slider": { "widget": "slider", "parent": "p_row", "style": "slider", "bind": "value",
                     "bindings": { "min": "min", "max": "max", "visible": "isSlider" }, "minSize": [200, 12], "vAlign": "center" },
      "p_value":  { "widget": "label", "parent": "p_row", "style": "hint", "bind": "valueText",
                     "bindings": { "visible": "isSlider" }, "minSize": [90, 0], "vAlign": "center" },
      "p_toggle": { "widget": "checkbox", "parent": "p_row", "style": "button", "bind": "checked",
                     "bindings": { "visible": "isToggle" } },
      "p_choice": { "widget": "dropdown", "parent": "p_row", "style": "button", "bind": "selected",
                     "bindings": { "options": "choices", "visible": "isChoice" }, "minSize": [200, 0] },
      "p_dirty":  { "widget": "label", "parent": "p_row", "style": "warning", "text": "*",
                     "bindings": { "visible": "dirty" }, "vAlign": "center" },

      "buttons":    { "widget": "stack", "parent": "window", "direction": "row", "spacing": 8 },
      "apply":      { "widget": "button", "parent": "buttons", "style": "button", "text": "@rpg.options.apply", "bindings": { "enabled": "hasChanges" } },
      "revert":     { "widget": "button", "parent": "buttons", "style": "button", "text": "@rpg.options.revert", "bindings": { "enabled": "hasChanges" } },
      "defaults":   { "widget": "button", "parent": "buttons", "style": "button", "text": "@rpg.options.defaults" },
      "message":    { "widget": "label", "parent": "window", "style": "text", "bind": "message",
                      "args": { "problems": "messageDetail" }, "bindings": { "visible": "hasMessage" } },
      "hint":       { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.options.hint" }
    } }
,
  // ---- the title, the pause menu, and the save and load slots (issue #342) --------------------------
  // `rpg:title` is what game.json's `"title": "rpg:title"` opens over a world that waits (Scenes.Title)
  // until New game or a save starts it. `rpg:pause` stands the world still while it is open (`pauses`).
  // `rpg:save` and `rpg:load` share one layout over SaveGameView and LoadGameView: every slot, newest
  // first, with when, where, the mods and the kind; overwrite, delete and load-over-a-game ask first.
  { "type": "screen", "id": "title", "layout": "title", "viewModel": "rpg_title" },
  { "type": "ui_layout", "id": "title", "style": "panel",
    "nodes": {
      "window":   { "widget": "stack", "anchors": "center", "spacing": 8, "minSize": [320, 0] },
      "title":    { "widget": "label", "parent": "window", "style": "title", "text": "@rpg.menu.game_title" },
      "new_game": { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.new_game" },
      "continue": { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.continue",
                    "args": { "slot": "continueSlot" }, "bindings": { "visible": "canContinue" } },
      "load":     { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.load" },
      "options":  { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.options",
                    "bindings": { "visible": "hasOptions" } },
      "mods":     { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.mods",
                    "bindings": { "visible": "hasMods" } },
      "quit":     { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.quit" },
      "message":  { "widget": "label", "parent": "window", "style": "warning", "bind": "message", "args": { "slot": "messageSlot" } }
    } },

  { "type": "screen", "id": "pause", "layout": "pause", "viewModel": "rpg_pause", "pauses": true },
  { "type": "ui_layout", "id": "pause", "style": "panel",
    "nodes": {
      "window":   { "widget": "stack", "anchors": "center", "spacing": 8, "minSize": [320, 0] },
      "title":    { "widget": "label", "parent": "window", "style": "title", "text": "@rpg.menu.paused" },
      "resume":   { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.resume" },
      "save":     { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.save" },
      "load":     { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.load" },
      "options":  { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.options",
                    "bindings": { "visible": "hasOptions" } },
      "mods":     { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.mods",
                    "bindings": { "visible": "hasMods" } },
      "quit":     { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.menu.quit" },
      "hint":     { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.menu.hint" }
    } },

  { "type": "screen", "id": "save", "layout": "saves", "viewModel": "rpg_save", "pauses": true },
  { "type": "screen", "id": "load", "layout": "saves", "viewModel": "rpg_load", "pauses": true },
  { "type": "ui_layout", "id": "saves", "style": "panel",
    "nodes": {
      "window":   { "widget": "stack", "anchors": "center", "spacing": 6, "minSize": [600, 0] },
      "title":    { "widget": "label", "parent": "window", "style": "title", "bind": "heading" },
      "new":      { "widget": "button", "parent": "window", "style": "button", "text": "@rpg.saves.new",
                    "bindings": { "visible": "saving" } },
      "count":    { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.saves.count", "args": { "count": "slotCount" },
                    "bindings": { "visible": "hasSaves" } },
      "none":     { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.saves.none",
                    "bindings": { "visible": "noSaves" } },
      "list":     { "widget": "scroll", "parent": "window", "minSize": [0, 260], "bindings": { "visible": "hasSaves" } },
      "slots":    { "widget": "item_list", "parent": "list", "bind": "slots", "spacing": 4 },
      "slot":     { "widget": "stack", "parent": "slots", "spacing": 2 },
      "top":      { "widget": "stack", "parent": "slot", "direction": "row", "spacing": 8 },
      "slotTitle": { "widget": "label", "parent": "top", "style": "text", "bind": "title", "expand": 1 },
      "slotKind": { "widget": "label", "parent": "top", "style": "hint", "bind": "kind" },
      "use":      { "widget": "button", "parent": "top", "style": "button", "bind": "use", "bindings": { "enabled": "canUse" } },
      "delete":   { "widget": "button", "parent": "top", "style": "button", "text": "@rpg.saves.delete" },
      "details":  { "widget": "stack", "parent": "slot", "direction": "row", "spacing": 8 },
      "slotWhen": { "widget": "label", "parent": "details", "style": "hint", "bind": "when" },
      "slotWhere": { "widget": "label", "parent": "details", "style": "hint", "bind": "location" },
      "slotMods": { "widget": "label", "parent": "details", "style": "hint", "text": "@rpg.saves.mods", "args": { "mods": "mods" },
                    "bindings": { "visible": "hasMods" } },
      "unreadable": { "widget": "label", "parent": "slot", "style": "warning", "text": "@rpg.saves.unreadable",
                    "bindings": { "visible": "cannotLoad" } },
      "mismatch": { "widget": "label", "parent": "slot", "style": "warning", "bind": "mismatch", "bindings": { "visible": "hasMismatch" } },
      "message":  { "widget": "label", "parent": "window", "style": "text", "bind": "message", "args": { "slot": "messageSlot" } },
      "hint":     { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.saves.hint" }
    } },

  // ---- journal: the story so far, and the quests tracked (issue #349) -----------------------------
  // JournalView's lines: a quest's (with `tracked` and `done`), the stages it moved on from (`past`), and
  // the stage it is on with its objectives. Activating an unfinished quest's line tracks it or stops.
  { "type": "screen", "id": "journal", "layout": "journal", "viewModel": "rpg_journal" },
  { "type": "ui_layout", "id": "journal", "style": "panel",
    "nodes": {
      "window":    { "widget": "stack", "anchors": "center", "spacing": 6, "minSize": [600, 0] },
      "title":     { "widget": "label", "parent": "window", "style": "title", "text": "@rpg.journal.title" },
      "summary":   { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.journal.summary",
                     "args": { "count": "active", "finished": "finished" } },
      "empty":     { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.journal.empty",
                     "bindings": { "visible": "empty" } },
      "page":      { "widget": "scroll", "parent": "window", "minSize": [0, 320] },
      "lines":     { "widget": "item_list", "parent": "page", "bind": "lines" },
      "line":      { "widget": "stack", "parent": "lines", "direction": "row", "spacing": 8, "style": "journal_line" },
      "tracked":   { "widget": "label", "parent": "line", "style": "journal_quest", "text": "@rpg.journal.tracked",
                     "bindings": { "visible": "tracked" } },
      "quest":     { "widget": "label", "parent": "line", "style": "journal_quest", "bind": "text", "bindings": { "visible": "quest" } },
      "done":      { "widget": "label", "parent": "line", "style": "hint", "text": "@rpg.journal.done", "bindings": { "visible": "done" } },
      "past":      { "widget": "label", "parent": "line", "style": "hint", "bind": "text", "margin": [16, 0, 0, 0],
                     "bindings": { "visible": "past" } },
      "stage":     { "widget": "label", "parent": "line", "style": "text", "bind": "text", "margin": [16, 0, 0, 0],
                     "bindings": { "visible": "stage" } },
      "objective": { "widget": "label", "parent": "line", "style": "text", "bind": "text", "margin": [32, 0, 0, 0], "expand": 1,
                     "bindings": { "visible": "objective" } },
      "progress":  { "widget": "label", "parent": "line", "style": "hint", "bind": "progress", "textAlign": "end",
                     "bindings": { "visible": "objective" } },
      "hint":      { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.journal.hint" }
    } },

  // ---- map: the scene's picture under its fog, the markers, zoom and pan (issues #99, #349) --------
  // MapView: `picture` and each square of `fog` are rects in the `clip` box (the x, y, w and h bindings);
  // markers and you are points in it. A marker in the fog is hidden; a tracked quest's target never is.
  { "type": "screen", "id": "map", "layout": "map", "viewModel": "rpg_map" },
  { "type": "ui_layout", "id": "map", "style": "panel",
    "nodes": {
      "window":   { "widget": "stack", "anchors": "center", "spacing": 6 },
      "title":    { "widget": "label", "parent": "window", "style": "title", "text": "@rpg.map.title" },
      "area":     { "widget": "box", "parent": "window", "style": "map_area", "minSize": [440, 440], "hAlign": "center", "clip": true },
      "picture":  { "widget": "image", "parent": "area", "bind": "picture", "keepAspect": false,
                    "bindings": { "x": "pictureX", "y": "pictureY", "w": "pictureW", "h": "pictureH", "visible": "hasPicture" } },
      "fog":      { "widget": "box", "parent": "area", "anchors": "fill", "bindings": { "rows": "fog", "visible": "hasFog" } },
      "fogSquare": { "widget": "box", "parent": "fog", "style": "map_fog", "bindings": { "x": "x", "y": "y", "w": "w", "h": "h" } },
      "markers":  { "widget": "box", "parent": "area", "anchors": "fill", "bindings": { "rows": "markers" } },
      "marker":   { "widget": "stack", "parent": "markers", "direction": "row", "spacing": 4,
                    "bindings": { "x": "x", "y": "y", "visible": "discovered" } },
      "dot":      { "widget": "label", "parent": "marker", "style": "map_dot", "text": "", "minSize": [8, 8], "vAlign": "center",
                    "bindings": { "style": "style" } },
      "name":     { "widget": "label", "parent": "marker", "style": "map_label", "bind": "label" },
      "go":       { "widget": "button", "parent": "marker", "style": "button", "text": "@rpg.map.travel", "args": { "hours": "travelHours" },
                    "bindings": { "visible": "canTravel" } },
      "you":      { "widget": "stack", "parent": "area", "direction": "row", "spacing": 4, "bindings": { "x": "youX", "y": "youY" } },
      "youDot":   { "widget": "label", "parent": "you", "style": "map_you", "text": "", "minSize": [10, 10], "vAlign": "center" },
      "youName":  { "widget": "label", "parent": "you", "style": "map_label", "text": "@rpg.map.you" },

      "controls": { "widget": "stack", "parent": "window", "direction": "row", "spacing": 4, "hAlign": "center" },
      "zoom_in":  { "widget": "button", "parent": "controls", "style": "button", "text": "@rpg.map.zoom_in", "bindings": { "enabled": "canZoomIn" } },
      "zoom_out": { "widget": "button", "parent": "controls", "style": "button", "text": "@rpg.map.zoom_out", "bindings": { "enabled": "canZoomOut" } },
      "pan_west": { "widget": "button", "parent": "controls", "style": "button", "text": "@rpg.map.west" },
      "pan_north": { "widget": "button", "parent": "controls", "style": "button", "text": "@rpg.map.north" },
      "pan_south": { "widget": "button", "parent": "controls", "style": "button", "text": "@rpg.map.south" },
      "pan_east": { "widget": "button", "parent": "controls", "style": "button", "text": "@rpg.map.east" },
      "recentre": { "widget": "button", "parent": "controls", "style": "button", "text": "@rpg.map.recentre" },

      "travelTitle": { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.map.destinations",
                       "bindings": { "visible": "hasDestinations" } },
      "destinations": { "widget": "item_list", "parent": "window", "bind": "destinations", "direction": "row", "spacing": 6 },
      "destination":  { "widget": "button", "parent": "destinations", "style": "button", "text": "@rpg.map.destination",
                        "args": { "label": "label", "hours": "travelHours" } },

      "range":    { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.map.range", "args": { "range": "range", "count": "count" } },
      "hint":     { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.map.hint" }
    } }
  ,

  // ---- the screens that were panels (issue #350): a titled list of rows -----------------------------
  // PanelListView's rows (ListViews.cs): `text` (with "×N" for a stack), `detail`, `tick` (readied, equipped,
  // chosen), and `style` / `detailStyle`, greyed while the row cannot be used; `reason` is why the focused one
  // cannot. The spellbook (B) and the bag share `rpg:list`; a conversation and the spellmaker have their own.
  { "type": "screen", "id": "spellbook", "layout": "list", "viewModel": "rpg_spellbook" },
  { "type": "screen", "id": "bag", "layout": "list", "viewModel": "rpg_bag" },
  { "type": "ui_layout", "id": "list", "style": "panel",
    "nodes": {
      "window":  { "widget": "stack", "anchors": "center", "spacing": 6, "minSize": [480, 0] },
      "title":   { "widget": "label", "parent": "window", "style": "title", "bind": "title" },
      "problem": { "widget": "label", "parent": "window", "style": "hint", "bind": "problem", "bindings": { "visible": "hasProblem" } },
      "empty":   { "widget": "label", "parent": "window", "style": "hint", "text": "@rpg.list.empty", "bindings": { "visible": "empty" } },
      "page":    { "widget": "scroll", "parent": "window", "minSize": [0, 240] },
      "rows":    { "widget": "item_list", "parent": "page", "bind": "rows", "spacing": 1 },
      "row":     { "widget": "stack", "parent": "rows", "direction": "row", "spacing": 6, "style": "list_row" },
      "tick":    { "widget": "label", "parent": "row", "style": "list_tick", "bind": "tick", "minSize": [12, 0] },
      "name":    { "widget": "label", "parent": "row", "bind": "text", "bindings": { "style": "style" }, "expand": 1 },
      "detail":  { "widget": "label", "parent": "row", "bind": "detail", "bindings": { "style": "detailStyle" }, "textAlign": "end" },
      "reason":  { "widget": "label", "parent": "window", "style": "warning", "bind": "reason" },
      "message": { "widget": "label", "parent": "window", "style": "warning", "bind": "message" },
      "hint":    { "widget": "label", "parent": "window", "style": "hint", "bind": "hint" }
    } },

  // ---- dialogue: what was just said, and what you may say back ------------------------------------
  // DialogueView: the node's line wraps across the top; each option is a row, greyed with its refusal.
  { "type": "screen", "id": "dialogue", "layout": "dialogue", "viewModel": "rpg_dialogue" },
  { "type": "ui_layout", "id": "dialogue", "style": "panel",
    "nodes": {
      "window":  { "widget": "stack", "anchors": "center", "spacing": 6, "minSize": [620, 0] },
      "speaker": { "widget": "label", "parent": "window", "style": "hint", "bind": "speaker" },
      "line":    { "widget": "label", "parent": "window", "style": "title", "bind": "title", "wrap": true, "maxWidth": 600 },
      "problem": { "widget": "label", "parent": "window", "style": "hint", "bind": "problem", "bindings": { "visible": "hasProblem" } },
      "rows":    { "widget": "item_list", "parent": "window", "bind": "rows", "spacing": 1 },
      "row":     { "widget": "stack", "parent": "rows", "direction": "row", "spacing": 6, "style": "list_row" },
      "name":    { "widget": "label", "parent": "row", "bind": "text", "bindings": { "style": "style" }, "expand": 1 },
      "detail":  { "widget": "label", "parent": "row", "bind": "detail", "bindings": { "style": "detailStyle" }, "textAlign": "end" },
      "hint":    { "widget": "label", "parent": "window", "style": "hint", "bind": "hint" }
    } },

  // ---- spellmaker: a name, a delivery, a power and the effects, then make it -----------------------
  // SpellmakerView: the name field writes `name` as it is typed; Delivery and Power cycle, an effect goes in
  // or out, and "make it" is greyed with what is missing (Spellmaker.CanCompose).
  { "type": "screen", "id": "spellmaker", "layout": "spellmaker", "viewModel": "rpg_spellmaker" },
  { "type": "ui_layout", "id": "spellmaker", "style": "panel",
    "nodes": {
      "window":  { "widget": "stack", "anchors": "center", "spacing": 6, "minSize": [620, 0] },
      "title":   { "widget": "label", "parent": "window", "style": "title", "bind": "title" },
      "name":    { "widget": "text_field", "parent": "window", "style": "field", "bind": "name", "placeholder": "@rpg.spellmaker.name",
                   "maxLength": 28 },
      "page":    { "widget": "scroll", "parent": "window", "minSize": [0, 240] },
      "rows":    { "widget": "item_list", "parent": "page", "bind": "rows", "spacing": 1 },
      "row":     { "widget": "stack", "parent": "rows", "direction": "row", "spacing": 6, "style": "list_row" },
      "tick":    { "widget": "label", "parent": "row", "style": "list_tick", "bind": "tick", "minSize": [12, 0] },
      "label":   { "widget": "label", "parent": "row", "bind": "text", "bindings": { "style": "style" }, "expand": 1 },
      "detail":  { "widget": "label", "parent": "row", "bind": "detail", "bindings": { "style": "detailStyle" }, "textAlign": "end" },
      "reason":  { "widget": "label", "parent": "window", "style": "warning", "bind": "reason" },
      "hint":    { "widget": "label", "parent": "window", "style": "hint", "bind": "hint" }
    } }
]
