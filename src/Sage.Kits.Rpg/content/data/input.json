[
  // The kit's default keys (issues #354, #600): B the spellbook, M the spellmaker, J the journal, T rest,
  // P perks, G factions, N the map; I (the engine's Inventory) opens the kit's inventory and Escape (Menu)
  // its pause menu. Bound in the UI and the Gameplay contexts so the key that opened a screen also closes
  // it (Escape is MenuBack in UI). Maps add up per context, so a game rebinds with its own `input_map` (a
  // patch of `rpg:ui` / `rpg:gameplay`, or its own map for another key; the player's `bind` and the
  // controls screen write `user://input.json` over both). RpgKitModule binds each action to its screen; a
  // game that binds one to a screen of its own replaces it.
  {
    "type": "input_map",
    "id": "ui",
    "context": "UI",
    "actions": {
      "Spellbook":  [ { "key": "B" } ],
      "Spellmaker": [ { "key": "M" } ],
      "Journal":    [ { "key": "J" } ],
      "Rest":       [ { "key": "T" } ],
      "Perks":      [ { "key": "P" } ],
      "Factions":   [ { "key": "G" } ],
      "Map":        [ { "key": "N" } ],
      "Inventory":  [ { "key": "I" } ]
    }
  },
  {
    "type": "input_map",
    "id": "gameplay",
    "context": "Gameplay",
    "actions": {
      "Spellbook":  [ { "key": "B" } ],
      "Spellmaker": [ { "key": "M" } ],
      "Journal":    [ { "key": "J" } ],
      "Rest":       [ { "key": "T" } ],
      "Perks":      [ { "key": "P" } ],
      "Factions":   [ { "key": "G" } ],
      "Map":        [ { "key": "N" } ]
    }
  }
]
