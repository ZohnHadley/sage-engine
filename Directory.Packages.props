<Project>
  <!-- Every NuGet package version in one place (central package management, issue #4). -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup>
    <!-- Simulation -->
    <PackageVersion Include="BepuPhysics" Version="2.4.0" />
    <PackageVersion Include="Friflo.Engine.ECS" Version="3.6.0" />
    <!-- Headless decoding for cooked assets (issue #302): images for `sage cook`, Ogg Vorbis for sounds.
         NVorbis is the version MonoGame.Framework.DesktopGL already brings, so the client has one copy. -->
    <PackageVersion Include="StbImageSharp" Version="2.30.16" />
    <PackageVersion Include="NVorbis" Version="0.10.4" />
    <!-- Fonts (issue #338): TTF/OTF read and rasterised at run time, headlessly, so layout measures
         with the same metrics the client draws with. The same StbSharp family as StbImageSharp. -->
    <PackageVersion Include="StbTrueTypeSharp" Version="1.26.12" />
    <!-- Client and tools -->
    <PackageVersion Include="MonoGame.Framework.DesktopGL" Version="3.8.5.1" />
    <PackageVersion Include="SharpGLTF.Core" Version="1.0.7" />
    <PackageVersion Include="ImGui.NET" Version="1.90.1.1" />
    <!-- The declarations generator (src/Sage.Generators). 4.8 runs in every compiler since the
         .NET 8 SDK; the engine builds with a newer one (global.json), which loads older generators. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="4.8.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="3.3.4" />
    <!-- The engine's version from git tags (build/Sage.Version.props, issue #31) and the public API
         files every engine assembly keeps (PublicAPI.Shipped.txt / Unshipped.txt, issue #31). -->
    <PackageVersion Include="MinVer" Version="6.0.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="3.3.4" />
    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
</Project>
