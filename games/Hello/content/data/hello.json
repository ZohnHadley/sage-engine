[
  // The player. A prefab is components and parts; the `character` part brings the kinematic character
  // controller, and the `PlayerControlled` tag is what makes the rest of the engine treat this one as
  // the local player — the first-person camera follows it for nothing, and the cheats act on it.
  {
    "type": "prefab",
    "id": "player",
    "name": "player",
    "tags": ["PlayerControlled"],
    "parts": {
      // The layer matters more than it looks: a character sweeps against everything *except* its own
      // layer, and terrain collision is on "default" — so a character left on the default layer walks
      // through the world and falls for ever. The engine warns about it now; this is the fix.
      "character": { "layer": "player" },
      "attributes": {}
    }
  }
]
