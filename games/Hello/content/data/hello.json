[
  // The player. A prefab is components and parts; the `character` part brings the kinematic character
  // controller, and the `player_controlled` tag is what makes the rest of the engine treat this one as
  // the local player — the first-person camera follows it for nothing, and the cheats act on it.
  {
    "type": "prefab",
    "id": "player",
    "name": "player",
    "tags": ["player_controlled"],
    "parts": {
      // The layer matters more than it looks: a character sweeps against everything *except* its own
      // layer, and terrain collision is on "default" — so a character left on the default layer walks
      // through the world and falls for ever. The engine warns about it now; this is the fix.
      "character": { "layer": "player" },
      "attributes": {}
    }
  },

  // Where it starts. A scene is the engine's (issue #29): game.json's "scene" names this one, and every
  // world starts in it. The player stands 2 m above the ground in the middle of the first sector: "at" is
  // measured from "origin", and "relativeTo": "Ground" makes its y a height above the terrain there —
  // which is the conversion the old C# made by hand, both halves of it (the world's frame, R6, and the
  // ground under the feet). A scene can also place prefabs ("place"), load maps and set the weather.
  {
    "type": "scene",
    "id": "main",
    "origin": [512, 0, 512],
    "relativeTo": "Ground",
    "player": { "prefab": "player", "at": [0, 2, 0] }
  }
]
