<Project>
  <!-- Shared settings for game projects under games/. -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />
  <Import Project="..\build\Sage.Configurations.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Every game file sees the engine and ECS namespaces. Friflo ships its own Transform (and Position,
       Rotation, Scale3) components; the alias makes `Transform` mean Sage's (docs/design/03 §3.1). -->
  <ItemGroup>
    <Using Include="Sage.Core" />
    <Using Include="Sage.Simulation" />
    <Using Include="Sage.Physics3D" />
    <Using Include="Sage.Gameplay" />
    <Using Include="Friflo.Engine.ECS" />
    <Using Include="Sage.Simulation.Transform" Alias="Transform" />
  </ItemGroup>

  <!-- The base engine, compile-time only (Private=false): at run time the host's own copies are used,
       so a game's bin holds its own dll and nothing else. All four by name, because a transitive
       reference would be copied (issue #24). A game's client half adds Sage.Client itself. -->
  <ItemGroup>
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Sage.Core\Sage.Core.csproj" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Sage.Simulation\Sage.Simulation.csproj" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Sage.Physics3D\Sage.Physics3D.csproj" Private="false" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Sage.Gameplay\Sage.Gameplay.csproj" Private="false" />
  </ItemGroup>

  <!-- The declarations generator (issue #16): a game's [Record] types register themselves, and its
       components and tags get their id table ([Component] / [Tag]). -->
  <ItemGroup Condition="'$(SageGenerators)' != 'false'">
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\src\Sage.Generators\Sage.Generators.csproj"
                      OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <!-- Project switches the Sage analyzers read (issue #19): SageSimulationOnly=true makes a MonoGame
       type an error (SAGE0024); SageStrictSaves=true asks every public component field for a
       [Property] or [Transient] decision (SAGE0023, off by default). -->
  <ItemGroup Condition="'$(SageGenerators)' != 'false'">
    <CompilerVisibleProperty Include="SageSimulationOnly" />
    <CompilerVisibleProperty Include="SageStrictSaves" />
  </ItemGroup>
</Project>
