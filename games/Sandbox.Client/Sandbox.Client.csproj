<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Sandbox's client half (docs/design/01 §3.1, TODO R15). Everything that needs a screen: the
    HUD, and the one prefab part that builds a mesh at run time. The simulation half is `Sandbox`,
    which references only the base engine — so the game's own rules, spawning and combat log can be
    tested headlessly, the way the engine's can.

    The host loads this through `game.json`'s `modules.add`. Engine references are compile-time only
    (Private=false): at run time the host's own copies are used.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Sandbox</RootNamespace>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sage.Client\Sage.Client.csproj" Private="false" />
    <ProjectReference Include="..\Sandbox\Sandbox.csproj" Private="false" />
    <!-- The RPG kit, both halves by name (a transitive reference would be copied): its screens and the
         actions that open them (issue #27). The host loads its own copies. -->
    <ProjectReference Include="..\..\src\Sage.Kits.Rpg\Sage.Kits.Rpg.csproj" Private="false" />
    <ProjectReference Include="..\..\src\Sage.Kits.Rpg.Client\Sage.Kits.Rpg.Client.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Sage.Client" />
    <Using Include="Sage.Kits.Rpg" />
  </ItemGroup>
</Project>
