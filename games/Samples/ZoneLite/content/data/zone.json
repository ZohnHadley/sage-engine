  // ---- the checkpoint: loners hold it, bandits raid it by day, seen or not ---------------------------
  // Both sides have the `offscreen` part: while their sector sleeps they walk their routines a game minute at a
  // time and fight (strength × health against a roll, the same every run), and come back as they are.
  { "type": "ai_schedule", "id": "keep_to_routine", "tasks": ["MoveToAnchor", "FaceAnchor", "StayAt"], "interrupts": ["SeeEnemy"] },
  { "type": "routine", "id": "raid",
    "entries": [ { "from": 8, "to": 20, "schedule": "keep_to_routine", "at": "checkpoint" },
                 { "from": 20, "to": 8, "schedule": "keep_to_routine", "at": "bandit_camp" } ] },
  { "type": "prefab", "id": "loner", "name": "loner",
    "parts": { "character": { "layer": "enemy" }, "attributes": {}, "faction": "loners", "offscreen": { "speed": 1.2, "strength": 6 } } },
  { "type": "prefab", "id": "bandit", "name": "bandit",
    "parts": { "character": { "layer": "enemy" }, "attributes": {}, "faction": "bandits", "routine": "raid",
               "offscreen": { "speed": 1.5, "strength": 5 } } },
  { "type": "prefab", "id": "marker", "name": "marker" },

