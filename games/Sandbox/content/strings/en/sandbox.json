{
  // The Sandbox's text (05 §3.7): `@sandbox.<key>` in any record. English only for now.
  "status": {
    "title": "Status",
    "health": "Health",
    "carrying": { "zero": "Carrying nothing", "one": "Carrying {count} thing", "other": "Carrying {count} things" },
    "close": "Close",
    "hint": "Arrows or D-pad move, Enter picks, Esc or C closes"
  },
  // The HUD (issue #99): what Use would do under the crosshair, what V does, and your empty hands.
  // {action:Use} is the key or pad button the player presses for it now (issue #352).
  "hud": {
    "use": "{action:Use}   Use",
    "pick_up": "{action:Use}   Pick up {item}",
    "third_person": "{action:ToggleView}   third person",
    "first_person": "{action:ToggleView}   first person",
    "bare_hands": "bare hands"
  },
  // The map's markers (the map itself is the RPG kit's, `rpg:map`, with its own words: issue #349).
  "map": {
    "hut": "the hut",
    "campfire": "campfire",
    "stranger": "the stranger",
    "watcher": "watcher",
    // The open world (4g-7): the crypt, the smith, the road, and travelling from the map.
    "crypt": "the crypt",
    "smith": "the smith",
    "road": "the road east"
  },
  "menu": {
    "title": "Sandbox",
    "resume": "Resume",
    "save": "Save",
    "mods": "Mods",
    "quit": "Quit",
    "saves": { "zero": "No saves", "one": "{count} save", "other": "{count} saves" },
    "no_saves": "Save once and it is listed here.",
    "unreadable": "(cannot load)",
    "saved": "Saved as {slot}.",
    "save_failed": "Could not save {slot}: see the log.",
    "loaded": "Loaded {slot}.",
    "load_failed": "Could not load {slot}: see the log.",
    "cannot_load": "{slot} was saved in a format this build does not read.",
    "overwrite": "Overwrite",
    "delete": "Delete",
    "overwritten": "Saved over {slot}.",
    "deleted": "Deleted {slot}.",
    "delete_failed": "Could not delete {slot}: see the log.",
    "kind_quick": "quick",
    "kind_auto": "auto",
    "hint": "Enter loads the save chosen. F5 quick-saves, F9 quick-loads. Esc or F10 closes."
  }
