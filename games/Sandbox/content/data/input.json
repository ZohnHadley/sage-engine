[
  // This game's own keys. The RPG kit's (Spellbook B, Spellmaker M, Journal J, Rest T) are its default
  // maps (`rpg:ui`, `rpg:gameplay`, issue #354) and need no line here. Maps add up per context, so these
  // sit beside the engine's own `ui` and `gameplay` maps (engine_content/data/input.json). Bound in both,
  // so the key that opened a screen also closes it.
  {
    "type": "input_map",
    "id": "rpg_ui",
    "context": "UI",
    "actions": {
      // The Sandbox's own widget screens (issues #97, #99): SandboxModule registers the actions.
      "Status":        [ { "key": "C" } ],
      "Map":           [ { "key": "N" } ],
      "MainMenu":      [ { "key": "F10" } ]
    }
  },
  {
    "type": "input_map",
    "id": "rpg_gameplay",
    "context": "Gameplay",
    "actions": {
      "Status":        [ { "key": "C" } ],
      "Map":           [ { "key": "N" } ],
      "MainMenu":      [ { "key": "F10" } ]
    }
  }
]
