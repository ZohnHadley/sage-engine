[
  // The test scene, as data (docs/design/05 §3.5). Edit while the game runs: with `developer 1`,
  // record files hot-reload and the scene respawns. Press Space (Jump) to make things hop.

  // ---- materials -------------------------------------------------------------------------------
  {
    // A game material inheriting from the engine's (07 §3.3): same effect and params, another colour.
    "type": "material",
    "id": "bunny",
    "base": "sage:lit_default",
    "params": { "AlbedoColor": [0.92, 0.86, 0.78, 1] }
  },

  // ---- sprite sheets (06 §3.8, 12 §3) ------------------------------------------------------------
  {
    // 8 view directions x 2 idle frames of 64x96. Frame index = row * 8 + column, so the second row
    // (8..15) is the second frame of each direction. The art is placeholder: the "nose" shows which
    // way it faces and the bars at its feet count the direction group.
    "type": "sprite_sheet",
    "id": "creature",
    "texture": "textures/creature.png",
    "directions": 8,
    "size": [1.2, 1.8],
    "material": "sage:sprite_lit",   // in the world's light: dark at night, lit by the campfire
    "frames": [
      { "rect": [0, 0, 64, 96], "pivot": [32, 94] },   { "rect": [64, 0, 64, 96], "pivot": [32, 94] },
      { "rect": [128, 0, 64, 96], "pivot": [32, 94] }, { "rect": [192, 0, 64, 96], "pivot": [32, 94] },
      { "rect": [256, 0, 64, 96], "pivot": [32, 94] }, { "rect": [320, 0, 64, 96], "pivot": [32, 94] },
      { "rect": [384, 0, 64, 96], "pivot": [32, 94] }, { "rect": [448, 0, 64, 96], "pivot": [32, 94] },
      { "rect": [0, 96, 64, 96], "pivot": [32, 94] },   { "rect": [64, 96, 64, 96], "pivot": [32, 94] },
      { "rect": [128, 96, 64, 96], "pivot": [32, 94] }, { "rect": [192, 96, 64, 96], "pivot": [32, 94] },
      { "rect": [256, 96, 64, 96], "pivot": [32, 94] }, { "rect": [320, 96, 64, 96], "pivot": [32, 94] },
      { "rect": [384, 96, 64, 96], "pivot": [32, 94] }, { "rect": [448, 96, 64, 96], "pivot": [32, 94] }
    ],
    "animations": {
      "idle": {
        "fps": 3,
        "loop": true,
        "dirs": [[0, 8], [1, 9], [2, 10], [3, 11], [4, 12], [5, 13], [6, 14], [7, 15]]
      },
      "attack": {
        // Placeholder art (the same two frames), but a real swing: the blow lands on the "hit" event
        // at step 1, a quarter of a second in, and the attack record's windupTime is only the
        // fallback for a fighter with no animation (12 §3, 16 §3.2).
        "fps": 4,
        "loop": false,
        "dirs": [[0, 8], [1, 9], [2, 10], [3, 11], [4, 12], [5, 13], [6, 14], [7, 15]],
        "events": [ { "frame": 1, "name": "hit" } ]
      }
    }
  },
  {
    // What the creature's sprite plays (12 "As built (animation events)", issue #119): sprites are the
    // leaves of an animation graph like a skinned model's clips. A swing sets the `attack` trigger (the
    // conventions' attackTrigger) and the graph picks the clip; its "hit" frame lands the blow, and the
    // creature stands again when the clip is done. No cross-fades: a sprite cannot blend.
    "type": "anim_graph",
    "id": "creature",
    "initial": "idle",
    "fade": 0,
    "params": { "attack": { "kind": "Trigger" } },
    "states": {
      "idle": { "clip": "idle" },
      "attack": {
        "clip": "attack",
        "loop": false,
        "transitions": [ { "to": "attack", "on": "attack" }, { "to": "idle", "when": { "anim_finished": "base" } } ]
      }
    },
    "transitions": [ { "to": "attack", "on": "attack" } ]
  },
  {
    // One direction, one frame, no animation: a tree always looks the same from every side.
    "type": "sprite_sheet",
    "id": "tree",
    "texture": "textures/tree.png",
    "directions": 1,
    "size": [2.2, 2.9],
    "material": "sage:sprite_lit",
    "frames": [ { "rect": [0, 0, 96, 128] } ]
  },

  // ---- what the scene is made of (docs/design/05 §3.5, F31) --------------------------------------
  //
  // A prefab describes a *kind*; where instances of it go is the `scene` record at the bottom of this
  // file. Until F31 the two were one `spawn` record, so "a creature" and "the creature at (0,0,-3)"
  // were the same thing, and a second one meant a second copy of the description.
  //
  // A prefab's body is "components" (data by component id: a bare name is this game's own or the
  // engine's, issue #16) and "parts" (setups a plugin declared, issue #17).
  // Nothing below names a field the engine invented for the Sandbox's benefit: `sprite`, `body`,
  // `character`, `attributes`, `melee`, `inventory`, `pickup` and `effects` are the engine's parts,
  // and `box_mesh` and `hop` are the Sandbox's own, declared as BoxMeshPart and HopPart.
  {
    "type": "prefab",
    "id": "creature",
    "abstract": true,
    "parts": { "sprite": { "sheet": "creature", "graph": "creature" } }
  },
  {
    // The one that fights: a body the engine moves, attributes, what it swings, and the hide that
    // armours it. The sprite's `graph` is inherited: combat sets its trigger and never names a clip.
    "type": "prefab", "id": "watcher", "base": "creature", "name": "watcher",
    "components": { "ai_state": { "schedule": "sage:idle" },
                    "map_marker": { "label": "@sandbox.map.watcher", "style": "sandbox:map_danger" } },
    "parts": {
      "character": { "layer": "enemy" },
      "attributes": {},
      "faction": "beasts",
      "melee": { "attack": "claws" },
      "effects": ["tough_hide"],
      // What its body gives up (issue #344): Use on a dead watcher opens the RPG kit's loot screen.
      "inventory": { "items": [ { "item": "pelt" } ] }
    }
  },
  {
    // The two that don't: an animated billboard with the Sandbox's own `hop` part on it, which is
    // what registering a game part looks like from the data side.
    "type": "prefab", "id": "hopper", "base": "creature", "name": "hopper",
    "parts": { "hop": {} }
  },
  {
    // A capsule body's size is [radius, total height]: it stands *on* the placement point, like the
    // art above it, where a box or a sphere is centred on it (review #44).
    "type": "prefab", "id": "tree", "name": "tree",
    "parts": { "sprite": { "sheet": "tree" }, "body": { "shape": "Capsule", "radius": 0.35, "height": 2.2 } }
  },

  // ---- factions (docs/design/16 §3.5, F24) ---------------------------------------------------------
  //
  // Two kinds of creature that hate each other and both hate you: the watchers of the wood and the
  // firebugs. `standing: -50` is below `hostileBelow`, so they come for the player from the start — a
  // faction that merely *knows* you is neutral, and neutral means it leaves you alone.
  {
    "type": "faction", "id": "beasts", "label": "beasts of the wood", "standing": -50, "killCost": 10,
    "relations": [ { "faction": "sandbox:firebugs", "stance": "Hostile" } ]
  },
  {
    "type": "faction", "id": "firebugs", "label": "firebugs", "standing": -50, "killCost": 10,
    "relations": [ { "faction": "sandbox:beasts", "stance": "Hostile" } ]
  },
  {
    // Neutral to everybody, which is what most of a world is: he does not come for you, and nothing
    // comes for him. Killing him costs you dearly, because he is the only one of him.
    "type": "faction", "id": "hermits", "label": "the hermit", "standing": 0, "killCost": 40
  },

  // ---- talking (docs/design/16 \u00a73.5, F24) -----------------------------------------------------------
  {
    // An errand: kill two of the wood's beasts and come back. The stage after the killing has no
    // objectives of its own — it waits to be *told*, which is what the conversation's "it is done" does
    // (16 §3.5). A quest watches; it never moves anybody.
    "type": "quest",
    "id": "thin_the_wood",
    "label": "Thin the Wood",
    "start": "hunt",
    "stages": [
      {
        "id": "hunt",
        "text": "The hermit asked you to thin the watchers below.",
        "objectives": [ { "kind": "Kill", "faction": "sandbox:beasts", "count": 2 } ],
        "next": "report"
      },
      { "id": "report", "text": "Tell the hermit it is done." }
    ]
  },
  {
    // Four nodes and a trade. What the options *do* is machinery that already existed \u2014 taking an item,
    // giving one, moving a reputation \u2014 which is the whole design: dialogue reaches the rest of the
    // game rather than having rules of its own.
    "type": "dialogue",
    "id": "hermit_talk",
    "label": "the hermit",
    "start": "greet",
    "nodes": [
      {
        "id": "greet",
        "text": "You are the first to come up here in a long while.",
        "options": [
          { "text": "What is this place?", "goto": "place" },
          { "text": "The beasts are getting bolder.", "goto": "beasts" },
          {
            "text": "Take this sword. I have no use for it.",
            "goto": "thanks",
            "requires": { "item": "sandbox:practice_sword" },
            "refusal": "you are carrying no sword",
            "then": { "takeItem": "sandbox:practice_sword", "faction": "sandbox:hermits", "standing": 40 }
          },
          {
            "text": "Is there anything I can do for you?",
            "goto": "errand",
            "requires": { "quest": "sandbox:thin_the_wood", "notStarted": true },
            "refusal": "you have already asked"
          },
          {
            "text": "The watchers are thinned, as you asked.",
            "goto": "paid",
            "requires": { "quest": "sandbox:thin_the_wood", "stage": "report" },
            "refusal": "there is nothing to report",
            "then": { "finishQuest": "sandbox:thin_the_wood", "faction": "sandbox:hermits", "standing": 35 }
          },
          // Widget screens about the hermit (issue #344): his goods in the RPG kit's shop, his topics.
          { "text": "Show me what you have.", "end": true, "actions": [ { "open_screen": "rpg:shop" } ] },
          { "text": "I have questions.", "end": true, "actions": [ { "open_screen": "rpg:topics" } ] },
          { "text": "Nothing. Good day.", "end": true }
        ]
      },
      {
        "id": "errand",
        "text": "Two of the watchers, if you can manage it. They come up here at night.",
        "options": [
          {
            "text": "I will see to it.",
            "goto": "greet",
            "then": { "startQuest": "sandbox:thin_the_wood" }
          },
          { "text": "Another time.", "goto": "greet" }
        ]
      },
      {
        "id": "paid",
        "text": "Then the hill is quieter for it. You have my thanks, for whatever that is worth.",
        "options": [ { "text": "Goodbye.", "end": true } ]
      },
      {
        "id": "place",
        "text": "Mine, mostly. The wood below is the watchers', and they do not share it.",
        "options": [ { "text": "I see.", "goto": "greet" } ]
      },
      {
        "id": "beasts",
        "text": "They always are. The firebugs keep them busy, which keeps them off me.",
        "options": [ { "text": "Convenient.", "goto": "greet" } ]
      },
      {
        "id": "thanks",
        "text": "Then I am in your debt. Not a word I use lightly.",
        "options": [ { "text": "Goodbye.", "end": true } ]
      }
    ]
  },
  {
    // Somebody to talk to: a billboard with a body so `Use` can reach him, and a dialogue that says
    // what he has to say. No `AIState`, so he stands there \u2014 an NPC is not a creature with a spear.
    "type": "prefab", "id": "hermit", "base": "creature", "name": "hermit",
    // On the map (issue #99): the RPG kit's marker component, a label and the style its dot is drawn in.
    "components": { "map_marker": { "label": "@sandbox.map.stranger", "style": "sandbox:map_person" } },
    "parts": {
      "body": { "size": [0.6, 1.8, 0.6] },
      "attributes": {},
      "faction": "hermits",
      "dialogue": "hermit_talk",
      // What he trades ("Show me what you have.").
      "inventory": { "items": [ { "item": "bolt", "count": 20 }, { "item": "pistol_rounds", "count": 30 }, { "item": "pelt", "count": 2 } ] }
    }
  },

  // ---- gameplay (docs/design/16) -----------------------------------------------------------------
  {
    // What the creature swings (16 §3.2). Longer reach and harder than bare hands, but slow: the
    // player can back out of it. The hit lands on the "hit" event of whatever clip the creature's graph
    // plays on the `attack` trigger.
    "type": "attack",
    "id": "claws",
    "damage": 12,
    "damageType": "sage:physical",
    "reach": 2.2,
    "radius": 0.45,
    "arcDegrees": 140,
    "windupTime": 0.45,
    "recoverTime": 0.3,
    "cooldown": 1.2
  },
  {
    // Creature hide: an infinite effect granting armour, so the player's fists do 60% damage to it.
    // Resistance as an effect rather than a starting value means a spell could strip it (16 §3.3).
    "type": "effect",
    "id": "tough_hide",
    "duration": "Infinite",
    "modifiers": [ { "attribute": "sage:armor", "op": "Add", "value": 40 } ]
  },

  // ---- first-person hands (docs/design/13 §3) ----------------------------------------------------
  {
    // Three frames: at rest, drawn back, and the strike. The HUD picks one from the swing's phase.
    "type": "sprite_sheet",
    "id": "hands_fp",
    "texture": "textures/hands.png",
    "directions": 1,
    "frames": [
      { "rect": [0, 0, 128, 128] }, { "rect": [128, 0, 128, 128] }, { "rect": [256, 0, 128, 128] }
    ]
  },
  {
    "type": "sprite_sheet",
    "id": "sword_fp",
    "texture": "textures/sword_fp.png",
    "directions": 1,
    "frames": [
      { "rect": [0, 0, 128, 128] }, { "rect": [128, 0, 128, 128] }, { "rect": [256, 0, 128, 128] }
    ]
  },
  {
    // Bare hands are the engine's attack, so the game patches a look onto it rather than redefining
    // it (05 §3.5): the engine ships no character art.
    "type": "attack",
    "id": "sage:default_attack",
    "patch": true,
    "viewmodel": "sandbox:hands_fp"
  },

  // ---- items (docs/design/16 §3.2, F19) ----------------------------------------------------------
  {
    // One frame, one direction: an item on the ground is just a billboard with a Pickup on it.
    "type": "sprite_sheet",
    "id": "sword_flat",
    "texture": "textures/sword.png",
    "directions": 1,
    "size": [0.5, 0.7],
    "material": "sage:sprite_lit",
    "frames": [ { "rect": [0, 0, 48, 64] } ]
  },
  {
    // What swinging a sword does, as an attack record (16 §3.2): longer, harder and slower than
    // fists, which the combat log shows the moment you equip it.
    "type": "attack",
    "id": "sword_swing",
    "base": "sage:default_attack",
    "damage": 22,
    "reach": 2.4,
    "radius": 0.4,
    "windupTime": 0.25,
    "recoverTime": 0.2,
    "cooldown": 0.55,
    "viewmodel": "sword_fp",
    "arms": "sword_arms",                   // 3D arms holding the sword (viewmodel.json, engine #121); the sprite is the fallback
    "swingCue": "weapon_swing"
  },
  {
    // The item itself. Equipping it hands `attack` to the wielder's Melee; nothing in combat knows
    // that a sword exists.
    "type": "item",
    "id": "practice_sword",
    "label": "practice sword",
    "sound": "pickup",
    "sheet": "sword_flat",
    "slot": "MainHand",
    "attack": "sword_swing",
    "weight": 4,
    "value": 20
  },
  {
    // One part, and the engine builds the whole lootable thing from the item record: its sprite, its
    // collider and the Pickup that says what taking it gives you (F19).
    "type": "prefab", "id": "sword_pickup", "name": "practice sword",
    "parts": { "pickup": { "item": "practice_sword" } }
  },

  // ---- ranged weapons (engine issue #138; docs/design/16 "As built (the Sandbox's weapons)") -------
  // A pistol and a crossbow as records only: the engine's hit pipeline (phase 4e) does the rest. Their
  // models are generated (tools/make_weapons.py); the arms that hold them are viewmodel.json's.
  {
    // Hitscan: a `ray` from the eye, eight rounds in a magazine refilled from the bag by Reload (R),
    // which completes on the arms' `mag_in` event (viewmodel.json's anim_events), and a cone that opens
    // with each shot and a kick that lifts the aim.
    "type": "attack",
    "id": "pistol_shot",
    "delivery": "ray",
    "damage": 18,
    "range": 60,
    "windupTime": 0,
    "recoverTime": 0.08,
    "cooldown": 0.22,
    "ammo": "pistol_rounds",
    "magazine": 8,
    "reloadTime": 1.4,                      // with no arms (third person): the reload ends on this clock instead
    "spread": "pistol_spread",
    "recoil": "pistol_recoil",
    "arms": "pistol_arms"
  },
  { "type": "spread", "id": "pistol_spread", "baseDegrees": 0.4, "growthPerShot": 1.2, "maxDegrees": 5, "recoveryPerSecond": 8 },
  { "type": "recoil", "id": "pistol_recoil", "pitchMinDegrees": 1.2, "pitchMaxDegrees": 2, "yawMinDegrees": -0.5, "yawMaxDegrees": 0.5 },
  {
    // A bolt that flies and falls (a `projectile` with gravity), one at a time: every shot is a reload.
    // It lands where it strikes, hitboxes and all.
    "type": "attack",
    "id": "crossbow_shot",
    "delivery": "projectile",
    "damage": 35,
    "range": 80,
    "radius": 0.03,
    "projectile": "bolt_flight",
    "projectileSpeed": 45,
    "projectileGravity": 9.81,
    "windupTime": 0,
    "recoverTime": 0.1,
    "cooldown": 0.3,
    "ammo": "bolt",
    "magazine": 1,
    "reloadTime": 1.4,
    "arms": "crossbow_arms"
  },
  {
    // What a bolt in flight looks like; the attack adds the flight.
    "type": "prefab", "id": "bolt_flight", "name": "bolt",
    "components": { "mesh_renderer": { "mesh": "models/bolt.glb", "material": "wood" } }
  },

  { "type": "item", "id": "pistol", "label": "pistol", "sound": "pickup", "slot": "MainHand", "attack": "pistol_shot", "weight": 1.2, "value": 60 },
  { "type": "item", "id": "crossbow", "label": "crossbow", "sound": "pickup", "slot": "MainHand", "attack": "crossbow_shot", "weight": 4, "value": 45 },
  { "type": "item", "id": "pistol_rounds", "label": "pistol rounds", "sound": "pickup", "weight": 0.01, "maxStack": 100, "value": 1 },
  { "type": "item", "id": "bolt", "label": "bolts", "sound": "pickup", "weight": 0.05, "maxStack": 50, "value": 1 },
  { "type": "item", "id": "pelt", "label": "watcher pelt", "sound": "pickup", "weight": 1.5, "maxStack": 10, "value": 8 },

  // Their colours, in hand (viewmodel.json) and on the ground.
  { "type": "material", "id": "gunmetal", "base": "sage:lit_default", "params": { "AlbedoColor": [0.22, 0.23, 0.25, 1] } },
  { "type": "material", "id": "wood", "base": "sage:lit_default", "params": { "AlbedoColor": [0.48, 0.32, 0.18, 1] } },
  { "type": "material", "id": "brass", "base": "sage:lit_default", "params": { "AlbedoColor": [0.78, 0.62, 0.3, 1] } },

  // On the ground: a model and the pickup part (no sprite sheet, so none is added).
  { "type": "prefab", "id": "pistol_pickup", "name": "pistol",
    "components": { "mesh_renderer": { "mesh": "models/pistol.glb", "material": "gunmetal" } },
    "parts": { "pickup": { "item": "pistol" } } },
  { "type": "prefab", "id": "crossbow_pickup", "name": "crossbow",
    "components": { "mesh_renderer": { "mesh": "models/crossbow.glb", "material": "wood" } },
    "parts": { "pickup": { "item": "crossbow" } } },
  { "type": "prefab", "id": "rounds_pickup", "name": "pistol rounds",
    "components": { "mesh_renderer": { "mesh": "models/pistol_rounds.glb", "material": "brass" } },
    "parts": { "pickup": { "item": "pistol_rounds", "count": 24 } } },
  { "type": "prefab", "id": "bolts_pickup", "name": "bolts",
    "components": { "mesh_renderer": { "mesh": "models/bolt.glb", "material": "wood" } },
    "parts": { "pickup": { "item": "bolt", "count": 12 } } },

  // ---- magic (docs/design/16 §3.3, F21) ----------------------------------------------------------
  {
    // The cooldown is an effect that grants a tag, not a timer: one clock for everything, it shows up
    // in a save, and a dispel would make the spell ready again.
    "type": "tag",
    "id": "cooldown.fireball",
    "description": "Just threw a fireball"
  },
  {
    "type": "effect",
    "id": "fireball_cooldown",
    "duration": "Timed",
    "time": 2.5,
    "grantTags": ["cooldown.fireball"],
    "modifiers": []
  },
  {
    // Presentation only: the simulation says "a fireball went off here" and the client decides what
    // that looks like. Nothing draws it yet (particles and audio are later phases), but the event is
    // already raised, so the day something listens the spell needs no change.
    "type": "cue",
    "id": "fireball_boom",
    "description": "A fireball bursting",
    "sound": "boom_fire",
    "particles": "fire_burst"
  },
  {
    // The casting itself, so a spell leaving the hand is heard as well as its arrival.
    "type": "cue", "id": "fireball_cast", "description": "A fireball thrown", "sound": "cast_fire"
  },
  {
    // A blade going through the air. The *hit* is the damage type's noise (one entry for "physical"
    // covers every club in the game); this is the weapon's own, and it plays whether the blow lands
    // or not — a miss is information too.
    "type": "cue", "id": "weapon_swing", "description": "A weapon swung", "sound": "swing"
  },
  {
    // Sparks where a spell leaves the hand, so casting looks like something even before it lands.
    "type": "cue", "id": "fireball_cast", "patch": true, "particles": "sparks", "particleCount": 6
  },

  {
    // Something that hums on its own (11 §3): a campfire, as data. Nothing in the simulation knows it
    // makes a noise — the component says which sound, and the client's audio system follows it.
    "type": "prefab", "id": "campfire", "name": "campfire",
    "components": { "map_marker": { "label": "@sandbox.map.campfire", "style": "sandbox:map_place" } },
    "parts": {
      "audio": { "sound": "fire_loop", "loop": true, "volume": 0.8 },
      "particles": { "effect": "embers" }
    }
  },

  // The engine's damage types carry no sound, because the engine ships no audio (11 §3). Patching is
  // how a game supplies one without owning the record: `sage:physical` keeps everything else it has.
  // A bare id means this file's namespace even inside a patch of an engine record (R11), so
  // `hit_flesh` is sandbox:hit_flesh. The colour is the damage number's.
  { "type": "damage_type", "id": "sage:physical", "patch": true, "sound": "hit_flesh",
    "particles": "blood", "colour": "#EFE3FF", "decal": "blood_splat" },
  { "type": "damage_type", "id": "sage:fire", "patch": true, "sound": "boom_fire",
    "particles": "fire_burst", "colour": "#FF9800" },

  // ---- marks that stay (engine issue #306) ----------------------------------------------------------
  //
  // The particle dot again, tinted and laid flat: a pistol round leaves a dark hole in the hut's and the
  // crypt's plaster (the surface's `impact` cue names the decal) and a blow that draws blood leaves a
  // splash on the wall or the floor behind (the damage type names it). Both fade, and `r_decals` caps
  // how many there are; the oldest goes first.
  { "type": "decal", "id": "bullet_hole", "texture": "textures/particle.png", "size": 0.12,
    "lifetime": 45, "fade": 5, "colour": "#1A1714" },
  { "type": "decal", "id": "blood_splat", "texture": "textures/particle.png", "size": 0.45,
    "lifetime": 20, "fade": 4, "colour": "#6E0000D0", "reach": 2.5 },
  { "type": "cue", "id": "bullet_impact", "description": "A round meeting plaster",
    "particles": "sparks", "particleCount": 4, "decal": "bullet_hole" },
  // What the maps' walls and roofs are made of (engine #270): the door is left out, because it moves and
  // a mark on it would stay where it was. The floors are planks (footsteps.json, engine #327).
  { "type": "physics_material", "id": "plaster", "impact": "bullet_impact", "textures": ["wall", "roof"] },

  // ---- particles (docs/design/06 \u00a73.9, F39) ------------------------------------------------------
  //
  // One white dot, tinted per effect \u2014 that is the whole texture budget of every spark, ember and gout of
  // blood below. `particle_additive` adds it to what is behind, so a spark glows; blood uses the blended
  // one, because blood does not glow.
  {
    "type": "particle", "id": "sparks",
    "texture": "textures/particle.png",
    "burst": 10, "maxParticles": 120,
    "lifeMin": 0.25, "lifeMax": 0.5,
    "speedMin": 2, "speedMax": 5,
    "shape": "Cone", "angleDegrees": 45,
    "gravity": -12, "drag": 1.5,
    "sizeStart": 0.07, "sizeEnd": 0.01,
    // White-hot, cooling to orange as it fades. (Written as packed numbers until issue #22, these two
    // had their bytes in the wrong order and drew a pale blue spark turning green.)
    "colourStart": "#FFE380", "colourEnd": "#FF7F0000",
    // They skitter off the floor rather than falling through it (issue 4n-6): a ray each a frame.
    "collision": "Bounce", "restitution": 0.35, "friction": 0.3
  },
  {
    "type": "particle", "id": "blood",
    "texture": "textures/particle.png",
    "material": "sage:particle_blend",
    "burst": 8, "maxParticles": 80,
    "lifeMin": 0.3, "lifeMax": 0.6,
    "speedMin": 1, "speedMax": 3,
    "shape": "Cone", "angleDegrees": 60,
    "gravity": -9.8, "drag": 1,
    "sizeStart": 0.1, "sizeEnd": 0.04,
    "colourStart": "#C80000", "colourEnd": "#88FFFF00"
  },
  {
    "type": "particle", "id": "fire_burst",
    "texture": "textures/particle.png",
    "burst": 24, "maxParticles": 200,
    "lifeMin": 0.35, "lifeMax": 0.8,
    "speedMin": 1, "speedMax": 6,
    "shape": "Sphere",
    "gravity": 1.5, "drag": 2,
    "sizeStart": 0.35, "sizeEnd": 0.02,
    "colourStart": "#FFA700", "colourEnd": "#FF000000",
    // Big puffs that burst on the floor: soft (issue 4n-6), so where one cuts the ground it fades out over
    // the last thirty centimetres instead of showing the hard line along the cut.
    "soft": 0.3
  },
  {
    // A steady stream rather than a burst: `rate` instead of `burst`, and that is the only difference
    // between a campfire and an explosion as far as this file is concerned.
    "type": "particle", "id": "embers",
    "texture": "textures/particle.png",
    "rate": 14, "maxParticles": 60,
    "lifeMin": 0.8, "lifeMax": 1.6,
    "speedMin": 0.4, "speedMax": 1.2,
    "shape": "Cone", "angleDegrees": 20,
    "gravity": 0.8, "drag": 0.6,
    "sizeStart": 0.08, "sizeEnd": 0.01,
    "colourStart": "#FFB800", "colourEnd": "#FF010000"
  },

  {
    // Rain: fast, short-lived, and barely affected by drag, so it falls in straight lines. `box` means
    // it starts anywhere in the slab the weather hands it, which is what makes it *weather* rather than
    // a fountain (06 \u00a73.13).
    "type": "particle", "id": "raindrop",
    "texture": "textures/particle.png",
    "material": "sage:particle_blend",
    "maxParticles": 1400,
    "lifeMin": 0.85, "lifeMax": 1.15,
    "speedMin": 14, "speedMax": 18,
    "shape": "Box",
    "gravity": -6, "drag": 0,
    "sizeStart": 0.055, "sizeEnd": 0.055,
    "colourStart": "#FFFFFFB2", "colourEnd": "#FFFFFF62"
  },
  {
    // Snow: slow, drifting, and it keeps its size all the way down.
    "type": "particle", "id": "snowflake",
    "texture": "textures/particle.png",
    "material": "sage:particle_blend",
    "maxParticles": 900,
    "lifeMin": 3.5, "lifeMax": 5,
    "speedMin": 0.7, "speedMax": 1.4,
    "shape": "Box",
    "gravity": -0.4, "drag": 0.8,
    "sizeStart": 0.08, "sizeEnd": 0.07,
    "colourStart": "#FFFFFF", "colourEnd": "#FFFFFF80"
  },

  // ---- weather (docs/design/06 \u00a73.13, F40) --------------------------------------------------------
  //
  // Three skies and the blend between them. `weather rain 8` rolls a storm in over eight seconds: the
  // fog closes, the sun goes out of it, the rain builds up and you start to hear it.
  //
  // Under the sky below (engine issue 4h-2) weather *adjusts* the hour's light rather than replacing it:
  // the scales dim the sun and the ambient and pull the fog in, the tints darken or pale the fog and the
  // sky, and `fogColor`/`skyColor` are only for a world with no sky. So a storm at dusk is dusk, darker.
  {
    "type": "weather", "id": "clear", "label": "clear", "cloudCover": 0.3
  },
  {
    "type": "weather", "id": "rain", "label": "rain",
    "cloudCover": 0.85, "particles": "raindrop", "rate": 900,
    "volume": [26, 14, 26], "ceiling": 10,
    "wind": [-3.5, 0, 1.5],
    "fogColor": [0.30, 0.33, 0.30], "fogStart": 8, "fogEnd": 95,
    "skyColor": [0.26, 0.29, 0.27],
    "sunScale": 0.45, "ambientScale": 0.7,
    "fogTint": [0.55, 0.6, 0.6], "skyTint": [0.5, 0.55, 0.55], "fogStartScale": 0.4, "fogEndScale": 0.5,
    "sound": "rain_loop", "soundVolume": 0.55, "shelteredVolume": 0.25,
    // Wet ground (issue #311): soaked in about forty seconds, then puddles on the flat; the sun dries it after.
    "wetting": 0.025, "drying": 0
  },
  {
    // Rain with lightning (issue #311): a flash on the sky and the ambient every so often, outdoors only, and
    // the thunder some seconds after by how far off it struck. `weather storm 6`.
    "type": "weather", "id": "storm", "label": "storm",
    "cloudCover": 1.0, "particles": "raindrop", "rate": 1400,
    "volume": [26, 14, 26], "ceiling": 10,
    "wind": [-6, 0, 2.5],
    "fogColor": [0.22, 0.24, 0.24], "fogStart": 6, "fogEnd": 75,
    "skyColor": [0.18, 0.2, 0.2],
    "sunScale": 0.3, "ambientScale": 0.55,
    "fogTint": [0.45, 0.5, 0.5], "skyTint": [0.4, 0.45, 0.45], "fogStartScale": 0.3, "fogEndScale": 0.4,
    "sound": "rain_loop", "soundVolume": 0.8, "shelteredVolume": 0.2,
    "lightningRate": 6, "lightningFlash": 0.9, "thunder": "thunder", "thunderVolume": 0.9,
    "wetting": 0.05, "drying": 0
  },
  {
    "type": "weather", "id": "snow", "label": "snow",
    "cloudCover": 0.9, "particles": "snowflake", "rate": 260,
    "volume": [24, 14, 24], "ceiling": 9,
    "wind": [-0.8, 0, 0.4],
    "fogColor": [0.62, 0.65, 0.70], "fogStart": 12, "fogEnd": 110,
    "skyColor": [0.58, 0.61, 0.66],
    "sunScale": 0.7, "ambientScale": 1.15,
    "fogTint": [1.0, 1.05, 1.15], "skyTint": [0.85, 0.9, 0.95], "fogStartScale": 0.5, "fogEndScale": 0.55
  },

  // What the weather can be, by the clock and the region (issue #311). A world draws from its pattern every
  // `slotHours` game hours and rolls into the draw over `transition` seconds; a pick names the hours it can
  // begin in (wrapping past midnight) and, optionally, a region. Nothing uses it until a scene says
  // `"environment": { "weatherPattern": "sandbox:changeable" }` (and `"weatherRegion": "north"` for snow).
  {
    "type": "weather_pattern", "id": "changeable", "label": "changeable", "slotHours": 3, "transition": 40, "picks": [
      { "weather": "clear", "weight": 5, "from": 6, "to": 20 },
      { "weather": "rain", "weight": 2 },
      { "weather": "storm", "weight": 1, "from": 14, "to": 24 },
      { "weather": "snow", "weight": 6, "region": "north" }
    ]
  },

  // ---- the sky (engine issues 4h-2, 4h-5; phase 4h's exit, 4h-7) ------------------------------------
  //
  // The light over a day, by hour; the scene below starts at 18:30, so the Sandbox opens at dusk and the
  // world clock (a game minute a real second; `time_scale`, `time_set 21`) runs it into the night. The sun
  // is geometry (up at 5:30, down at 19:30); the keys say its colour, the ambient, the sky, the fog and how
  // dark shadows are. Exp² fog: soft near, closing in at the end. The lamps in level.json come on at sunset.
  // The Sandbox's calendar: the usual months and weekdays, with the moon eleven days into its cycle at day 0.
  { "type": "calendar", "id": "moon", "moonStart": 11 },
  {
    "type": "sky", "id": "day", "sunrise": 5.5, "sunset": 19.5, "fogMode": "Exp2",
    // Issue 4n-16: a moon whose phase follows the calendar, a cloud layer the weather's cloudCover thickens
    // (tools/make_sky_art.py), stars that turn with the hour, and a thin haze over the whole sky.
    "moon": "textures/moon.png", "moonSize": 6, "clouds": "textures/clouds.png", "cloudSpeed": 0.08, "hazeAbove": 0.05,
    "keys": [
      { "hour": 0,    "sun": [0.0, 0.0, 0.0],    "ambientSky": [0.03, 0.04, 0.09], "ambientGround": [0.01, 0.01, 0.02],
        "horizon": [0.03, 0.04, 0.08], "zenith": [0.005, 0.01, 0.03], "fog": [0.03, 0.04, 0.07], "fogStart": 10, "fogEnd": 140, "shadow": 0 },
      { "hour": 6,    "sun": [0.9, 0.55, 0.35],  "ambientSky": [0.25, 0.23, 0.27], "ambientGround": [0.1, 0.09, 0.08],
        "horizon": [0.75, 0.5, 0.4], "zenith": [0.3, 0.4, 0.6], "fog": [0.6, 0.5, 0.45], "fogStart": 20, "fogEnd": 220, "shadow": 0.6 },
      { "hour": 12,   "sun": [0.85, 0.82, 0.75], "ambientSky": [0.45, 0.47, 0.52], "ambientGround": [0.22, 0.2, 0.17],
        "horizon": [0.62, 0.72, 0.82], "zenith": [0.25, 0.45, 0.8], "fog": [0.6, 0.68, 0.75], "fogStart": 40, "fogEnd": 300, "shadow": 1 },
      { "hour": 17,   "sun": [0.9, 0.75, 0.55],  "ambientSky": [0.38, 0.38, 0.42], "ambientGround": [0.18, 0.15, 0.13],
        "horizon": [0.7, 0.62, 0.5], "zenith": [0.28, 0.4, 0.65], "fog": [0.65, 0.6, 0.52], "fogStart": 35, "fogEnd": 260, "shadow": 0.9 },
      { "hour": 18.5, "sun": [0.95, 0.5, 0.25],  "ambientSky": [0.28, 0.22, 0.26], "ambientGround": [0.12, 0.09, 0.08],
        "horizon": [0.85, 0.45, 0.28], "zenith": [0.22, 0.25, 0.45], "fog": [0.7, 0.42, 0.3], "fogStart": 25, "fogEnd": 220, "shadow": 0.8 },
      { "hour": 20,   "sun": [0.5, 0.2, 0.1],    "ambientSky": [0.1, 0.09, 0.15], "ambientGround": [0.04, 0.03, 0.04],
        "horizon": [0.3, 0.15, 0.15], "zenith": [0.04, 0.05, 0.14], "fog": [0.22, 0.14, 0.14], "fogStart": 15, "fogEnd": 180, "shadow": 0.3 },
      { "hour": 22,   "sun": [0.0, 0.0, 0.0],    "ambientSky": [0.03, 0.04, 0.09], "ambientGround": [0.01, 0.01, 0.02],
        "horizon": [0.03, 0.04, 0.08], "zenith": [0.005, 0.01, 0.03], "fog": [0.03, 0.04, 0.07], "fogStart": 10, "fogEnd": 140, "shadow": 0 }
    ]
  },

  // ---- sounds (docs/design/11 3, F4) --------------------------------------------------------------
  // Generated by tools/make_placeholder_audio.py: the repository ships no audio it does not own.
  {
    // A burst carries a long way, and is worth hearing over everything else.
    "type": "sound", "id": "boom_fire",
    "variations": ["audio/boom_fire.wav"],
    "volume": 0.9, "volumeJitter": 0.05, "pitchJitter": 0.15,
    "minDistance": 6, "maxDistance": 80, "priority": 3, "maxInstances": 4
  },
  {
    "type": "sound", "id": "cast_fire",
    "variations": ["audio/cast_fire.wav"],
    "volume": 0.7, "pitchJitter": 0.2, "minDistance": 4, "maxDistance": 45, "priority": 2
  },
  {
    // Two variations, so a flurry of blows is not one sample on repeat, and a cooldown so two hits in
    // the same tick do not phase against each other (11 3).
    "type": "sound", "id": "hit_flesh",
    "variations": ["audio/hit_flesh_a.wav", "audio/hit_flesh_b.wav"],
    "volume": 0.8, "volumeJitter": 0.1, "pitchJitter": 0.25,
    "cooldown": 0.05, "minDistance": 3, "maxDistance": 35, "priority": 2
  },
  {
    "type": "sound", "id": "swing",
    "variations": ["audio/swing.wav"],
    "volume": 0.5, "pitchJitter": 0.3, "cooldown": 0.05, "minDistance": 2, "maxDistance": 25
  },
  {
    // 2D: a sound about *you* rather than about a place, so it neither pans nor fades.
    "type": "sound", "id": "pickup",
    "variations": ["audio/pickup.wav"],
    "volume": 0.6, "bus": "Ui", "maxDistance": 0, "priority": 4
  },
  {
    "type": "sound", "id": "thunder",
    "variations": ["audio/thunder.wav"],
    "volume": 0.9, "bus": "Ambient", "maxDistance": 0, "maxInstances": 3
  },
  {
    // 2D on purpose: rain is not *somewhere*, it is everywhere, so it neither pans nor fades (11 \u00a73).
    "type": "sound", "id": "rain_loop",
    "variations": ["audio/rain_loop.wav"],
    "volume": 0.9, "bus": "Ambient", "maxDistance": 0
  },
  {
    "type": "sound", "id": "fire_loop",
    "variations": ["audio/fire_loop.wav"],
    "volume": 0.5, "bus": "Ambient", "minDistance": 2, "maxDistance": 20, "maxInstances": 8
  },

  // ---- music (engine issue #325) -----------------------------------------------------------------
  // Generated by tools/make_placeholder_audio.py, as Ogg Vorbis: music streams as it plays. The world has
  // one track at a time and crossfades between them; data changes it. The main scene's environment starts
  // `wander`, the hut yard's trigger (below) switches to `hearth` and back, and the crypt scene has its own
  // (open_world.json). `music_intensity 1` brings in wander's drums; `music crypt 1` changes it by hand.
  {
    // A one-second intro heard once, then the body loops from sample 22050 (one second at 22.05 kHz).
    "type": "music", "id": "wander", "track": "music/wander.ogg", "loopStart": 22050,
    "volume": 0.6, "fadeIn": 3, "fadeOut": 3,
    "layers": [ { "asset": "music/wander_drums.ogg", "intensity": 0.5, "fade": 2 } ]
  },
  { "type": "music", "id": "hearth", "track": "music/hearth.ogg", "volume": 0.6, "fadeIn": 2 },
  { "type": "music", "id": "crypt", "track": "music/crypt.ogg", "volume": 0.7, "fadeIn": 4 },
  {
    // What the fireball looks like on its way: two frames so it flickers, one direction because a ball
    // of fire has no front. The clip loops while it flies.
    "type": "sprite_sheet",
    "id": "fireball_flat",
    "texture": "textures/fireball.png",
    "directions": 1,
    "size": [0.45, 0.45],
    "material": "sage:sprite_lit",
    "frames": [ { "rect": [0, 0, 32, 32] }, { "rect": [32, 0, 32, 32] } ],
    "animations": {
      "idle": { "fps": 12, "loop": true, "dirs": [[0, 1]] }
    }
  },
  {
    // The thing that flies, as a prefab (F31): the spell says how fast and what it does on arrival,
    // and this says what it looks like. No collider — it is the projectile's own sweep that decides
    // what it hits, and giving it a body would make it shove the world on its way.
    "type": "prefab",
    "id": "fireball_bolt",
    "name": "fireball",
    "parts": { "sprite": { "sheet": "fireball_flat", "animation": "idle" } }
  },
  {
    // A fireball: it flies to whatever you are looking at, bursts, and sets what it caught alight.
    // The damage goes through the combat pipeline so `fire_resist` means something, and `burning` is
    // the engine's own effect riding along with it — no part of this spell is new code.
    "type": "ability",
    "id": "fireball",
    "name": "fireball",
    "costAttribute": "sage:mana",
    "cost": 12,
    "cooldown": "fireball_cooldown",
    "targeting": "Projectile",
    "projectile": "fireball_bolt",
    "projectileSpeed": 16,
    "range": 20,
    "radius": 2.5,
    "width": 0.25,
    "castTime": 0.35,
    "damage": 28,
    "damageType": "sage:fire",
    "effects": ["sage:burning"],
    // Two moments, two lists: the throw is heard at the hand and the burst where it lands (11 §3).
    "castCues": ["fireball_cast"],
    "cues": ["fireball_boom"]
  },

  // ---- the player (docs/design/10 §3, 16 §3.1) ---------------------------------------------------
  {
    // A creature's spell: cheaper, weaker and slower than the player's, so a firebug is a nuisance at
    // range rather than an execution. No burst — it hits what it hits.
    "type": "ability",
    "id": "ember_bolt",
    "name": "ember bolt",
    "costAttribute": "sage:mana",
    "cost": 4,
    "cooldown": "ember_cooldown",
    "targeting": "Projectile",
    "projectile": "fireball_bolt",
    "projectileSpeed": 12,
    "range": 16,
    "width": 0.25,
    "castTime": 0.5,
    "damage": 9,
    "damageType": "sage:fire",
    // A creature throwing fire at your back is a sound you want, and from where it is standing.
    "castCues": ["fireball_cast"],
    "cues": ["fireball_boom"]
  },
  { "type": "tag", "id": "cooldown.ember", "description": "Just threw an ember bolt" },
  {
    // Where a firebug's magic comes from: mana back on a timer, for ever. Nothing in the engine
    // regenerates anything (16 §3.3) — it is an infinite effect with a period, which is the same
    // machinery as poison running the other way. Without it the creature spends its fifty mana and
    // then follows the player around unable to act, which is honest and dull.
    "type": "effect",
    "id": "ember_font",
    "duration": "Infinite",
    "period": 2,
    "modifiers": [ { "attribute": "sage:mana", "op": "Add", "value": 5 } ]
  },
  {
    "type": "effect",
    "id": "ember_cooldown",
    "duration": "Timed",
    "time": 2,
    "grantTags": ["cooldown.ember"],
    "modifiers": []
  },
  {
    // The one that casts (16 §3.4, F21). It has no `melee` part on purpose: a creature that cannot
    // swing must not walk into reach to do nothing, and this is what proves it doesn't — it stands at
    // range and throws bolts, because the AI prefers casting to closing when it cannot fight in reach.
    "type": "prefab", "id": "firebug", "base": "creature", "name": "firebug",
    "components": { "ai_state": { "schedule": "sage:idle" } },
    "parts": {
      "character": { "layer": "enemy" },
      "attributes": {},
      "faction": "firebugs",
      "abilities": ["ember_bolt"],
      "effects": ["ember_font"]
    }
  },
  {
    // The same parts as the creature, plus the tag that says the local PlayerCommand drives this one.
    // Where the player starts is the scene's "player" placement, not this record. The sprite is a
    // placeholder body, so the third-person camera (V) has someone to look at; the first-person view
    // does not draw it (engine issue #79). No "graph" and no "animation": a clip with a "hit" event would
    // time the player's swings (12 §3), and these stay on the attack record's wind-up.
    "type": "prefab",
    "id": "player",
    "name": "player",
    "tags": ["player_controlled"],
    "parts": {
      "character": { "layer": "player" },
      "sprite": { "sheet": "creature" },
      "attributes": {},
      "melee": { "attack": "sage:default_attack" },
      "inventory": { "capacity": 60 },
      "abilities": ["fireball"],
      // A step every 1.6 m walked on the ground, and a noise when it jumps and lands, each the sound of
      // what is underfoot (footsteps.json, engine issue #327).
      "footsteps": {}
    }
  },

  // ---- physics (docs/design/10) -----------------------------------------------------------------
  {
    // Crates fall onto the terrain's collision mesh and settle. `box_mesh` is the Sandbox's own part:
    // building a box mesh at runtime needs the renderer, which is client-side and no business of the
    // engine's prefab code. A mass makes it a dynamic body; without one it would be static.
    "type": "prefab",
    "id": "crate",
    "name": "crate",
    "parts": {
      "box_mesh": { "size": [0.6, 0.6, 0.6], "material": "crate" },
      "body": { "size": [0.6, 0.6, 0.6], "mass": 8 }
    }
  },
  // ---- joints (docs/design/10, issue #245): things that hang --------------------------------------
  //
  // A gantry by the start: two posts and a beam, all static, and what is hung from the beam in data. The
  // `joint` part joins a dynamic body to the entity its `target` names (here, the beam's placement name)
  // and measures its anchor in its own space: a hinge about the sign's top edge swings it back and forth
  // (shove it), a ball joint lets the lamp's link turn every way, and a distance joint is a short rope.
  // Where the joint sits is where the thing is placed; its angles count from there.
  {
    "type": "prefab", "id": "gantry_post", "name": "gantry post",
    "parts": {
      "box_mesh": { "size": [0.2, 2.6, 0.2], "material": "crate" },
      "body": { "size": [0.2, 2.6, 0.2] }
    }
  },
  {
    "type": "prefab", "id": "gantry_beam", "name": "gantry beam",
    "parts": {
      "box_mesh": { "size": [2.4, 0.2, 0.2], "material": "crate" },
      "body": { "size": [2.4, 0.2, 0.2] }
    }
  },
  {
    // Hinged about its top edge along X, so it swings towards and away from the player, within 70 degrees
    // either way. `drag` is what stops a swing: the share of its speed it loses a second.
    "type": "prefab", "id": "hanging_sign", "name": "hanging sign",
    "parts": {
      "box_mesh": { "size": [1, 0.5, 0.06], "material": "crate" },
      "body": { "size": [1, 0.5, 0.06], "mass": 3 },
      "joint": { "kind": "Hinge", "target": "gantry beam", "anchor": [0, 0.25, 0], "axis": [1, 0, 0], "min": -70, "max": 70, "drag": 0.6 }
    }
  },
  {
    // A lamp on a chain: the link is a ball joint on the beam (a 50 degree cone), and the lamp hangs from
    // the link's foot on a rope, a distance joint that lets it drop no further than 0.4 m.
    "type": "prefab", "id": "lamp_link", "name": "lamp link",
    "parts": {
      "box_mesh": { "size": [0.06, 0.4, 0.06], "material": "crate" },
      "body": { "size": [0.06, 0.4, 0.06], "mass": 0.5 },
      "joint": { "kind": "Ball", "target": "gantry beam", "anchor": [0, 0.25, 0], "axis": [0, -1, 0], "swing": 50 }
    }
  },
  {
    "type": "prefab", "id": "hanging_lamp", "name": "hanging lamp",
    "parts": {
      "box_mesh": { "size": [0.3, 0.3, 0.3], "material": "crate" },
      "body": { "size": [0.3, 0.3, 0.3], "mass": 2 },
      "joint": { "kind": "Distance", "target": "lamp link", "anchor": [0, 0.15, 0], "targetAnchor": [0, -0.2, 0], "maxDistance": 0.4 }
    }
  },

  {
    // A trigger the crates fall through: it reports overlaps but never pushes anything.
    "type": "prefab", "id": "gate", "name": "gate",
    "parts": { "body": { "size": [4, 0.4, 3], "trigger": true } }
  },
  {
    // A physics layer that only the player's body touches (10 §3): what an HL1 trigger_once is by
    // default. A trigger on it reports the player walking in and never a creature, a crate or a bolt.
    // `layers+` appends to the engine's list rather than replacing it; `ignore` merges.
    "type": "physics_layers", "id": "sage:default", "patch": true,
    "layers+": ["player_zone"],
    "ignore": { "player_zone": ["default", "enemy", "projectile", "trigger", "debris", "player_zone"] }
  },
  {
    // The path up to the hut's door (issue #81, REDESIGN §5 phase 4a's exit criterion "a scripted camera
    // cut from I/O"): walking into it cuts to `hut_cam` for three seconds, once. What it does is the
    // placement's wiring, below.
    "type": "prefab", "id": "hut_path", "name": "hut path",
    "components": { "map_marker": { "label": "@sandbox.map.hut", "style": "sandbox:map_place" } },
    "parts": { "body": { "size": [5, 3, 3], "trigger": true, "layer": "player_zone" } }
  },
  {
    // Round the hut (engine issue #325): walking in switches the music to the hut's, walking out back to
    // the clearing's, with nothing but the placement's wiring below.
    "type": "prefab", "id": "hut_yard", "name": "hut yard",
    "parts": { "body": { "size": [12, 4, 12], "trigger": true, "layer": "player_zone" } }
  },
  {
    // Waist high and eight metres long: something a creature can see you over but not walk through, so
    // it has to find its own way round (16 \u00a73.4, F23). No mass, so it is static and stays where it is
    // put; `nav_enabled 0` turns the pathfinding off and it goes back to leaning on it.
    "type": "prefab", "id": "fence", "name": "fence",
    "parts": {
      "box_mesh": { "size": [8, 1.2, 0.4], "material": "crate" },
      "body": { "size": [8, 1.2, 0.4] }
    }
  },
  {
    "type": "material",
    "id": "crate",
    "base": "sage:lit_default",
    "params": { "AlbedoColor": [0.72, 0.5, 0.26, 1] }
  },

  {
    // The mesh from step 6 is still here: meshes and sprites share the passes and the sort order.
    // A mesh renderer is plain data, so it is a component rather than a part, and `faces_camera` is a
    // tag the Sandbox declares ([Tag("sandbox:faces_camera")]): bare, because it is this game's own.
    "type": "prefab",
    "id": "bunny",
    "name": "bunny",
    "components": { "mesh_renderer": { "mesh": "models/bunny.glb", "material": "bunny" } },
    "tags": ["faces_camera"],
    "parts": { "hop": {} }
  },

  // ---- a normal-mapped wall and a lamp going round in front of it (engine issue #410) ---------------
  //
  // lit.fx draws a material's surface maps: a normal map (the bricks' bevels and the mortar's grooves),
  // a specular map (red: shine, green: gloss) with `specular` and `gloss`, `emissive` (the lamp's glow),
  // `vertexColors` and an `environmentMap`. A map left out changes nothing, so every other material here
  // draws as before. The art is made by tools/make_brick_wall.py; the model carries its own tangents.
  {
    "type": "material",
    "id": "brick_wall",
    "base": "sage:lit_default",
    "params": { "Albedo": "textures/brick_wall.png" },
    "normalMap": "textures/brick_wall_normal.png",
    "specularMap": "textures/brick_wall_spec.png",
    "specular": 0.8,
    "gloss": 0.45
  },
  {
    // Glows the lamp's colour whatever lights it, and in the dark.
    "type": "material",
    "id": "lamp_glow",
    "base": "sage:lit_default",
    "params": { "AlbedoColor": [0.3, 0.25, 0.18, 1] },
    "emissive": [1.0, 0.8, 0.5],
    "castShadows": false
  },
  {
    "type": "prefab", "id": "brick_wall", "name": "brick wall",
    "components": { "mesh_renderer": { "mesh": "models/brick_wall.glb", "material": "brick_wall" } },
    "parts": { "body": { "size": [3, 3, 0.3] } }
  },
  {
    // Lit always, unlike the hut's: it is here to be looked at. `orbit` is the Sandbox's own part
    // (SandboxModule.cs): round a circle about where it is placed, about the axis given.
    "type": "prefab", "id": "wall_lamp", "name": "wall lamp",
    "parts": {
      "light": { "colour": [1.0, 0.8, 0.55], "range": 5, "intensity": 2.5 },
      "box_mesh": { "size": [0.12, 0.12, 0.12], "material": "lamp_glow" },
      "orbit": { "radius": 0.9, "period": 6, "axis": [-0.755, 0, 0.656] }
    }
  },

  // ---- where the instances go --------------------------------------------------------------------
  {
    // Placement is not the prefab's business. Map files with a persistent id and per-entity overrides
    // are F27 (09 §3.4). A `scene` is the engine's (issue #29): game.json's "scene" names this one,
    // and the engine places it, respawns it when a record file is saved, and keeps the player.
    //
    // "at" is measured from the scene's "origin" (the middle of sector 0,0) and, because the scene is
    // "relativeTo": "Ground", its y is height above the terrain: everything stands on the hills. Yaw is
    // the engine's one convention (SageMath): degrees about +Y, 0 faces -Z, growing counter-clockwise
    // seen from above. The player starts away at +Z, so the watcher's "yaw": 180 looks back at them.
    "type": "scene",
    "id": "main",
    "origin": [512, 0, 512],
    "relativeTo": "Ground",

    // Dusk (phase 4h's exit): the world is lit by the sky above, from half past six in the evening.
    // and the clearing's music, faded in as the world starts (engine issue #325).
    "environment": { "sky": "day", "hour": 18.5, "music": "wander" },

    // Brush levels (15 §3, F16): the hut, from maps/hut.map.
    "maps": ["hut"],
    "player": { "prefab": "player", "at": [0, 1, 6] },
    "place": [
      { "prefab": "watcher",      "at": [0, 0, -3],    "yaw": 180 },
      { "prefab": "firebug",      "at": [-7, 0, -6],   "yaw": 150 },
      { "prefab": "campfire",     "at": [3, 0, 2] },
      { "prefab": "hopper",       "at": [2.5, 0, 0],   "yaw": -90, "name": "eastward" },
      { "prefab": "hopper",       "at": [-2.5, 0, 0],  "yaw": 0,   "name": "away" },
      { "prefab": "tree",         "at": [4.5, 0, -3] },
      { "prefab": "tree",         "at": [-4.5, 0, -4] },
      { "prefab": "tree",         "at": [0, 0, -7] },
      { "prefab": "sword_pickup", "at": [0.4, 0, 4.2] },
      // Two ranged weapons and their ammunition beside it (engine issue #138).
      { "prefab": "pistol_pickup",   "at": [-0.6, 0, 4.2] },
      { "prefab": "rounds_pickup",   "at": [-1.1, 0, 4.4] },
      { "prefab": "crossbow_pickup", "at": [1.3, 0, 4.2] },
      { "prefab": "bolts_pickup",    "at": [1.9, 0, 4.4] },
      { "prefab": "bunny",        "at": [0, 0, -2] },
      { "prefab": "crate",        "at": [-0.7, 6, 1.5] },
      { "prefab": "crate",        "at": [0, 8, 1.8] },
      { "prefab": "crate",        "at": [0.7, 10, 1.4] },
      { "prefab": "gate",         "at": [0, 3, 1.6] },
      // The gantry (issue #245): posts, a beam, a sign hung on a hinge and a lamp on a chain; go and shove it.
      { "prefab": "gantry_post", "at": [2.0, 1.3, 8] },
      { "prefab": "gantry_post", "at": [4.4, 1.3, 8] },
      { "prefab": "gantry_beam", "at": [3.2, 2.7, 8], "name": "gantry beam" },
      { "prefab": "hanging_sign", "at": [2.6, 2.3, 8.25] },
      { "prefab": "lamp_link", "at": [3.8, 2.35, 8], "name": "lamp link" },
      { "prefab": "hanging_lamp", "at": [3.8, 1.6, 8] },
      // The brick wall (engine issue #410), turned to face the start, with its lamp circling 0.9 m in front.
      { "prefab": "brick_wall", "at": [7, 1, 0], "yaw": -49, "name": "brick wall" },
      { "prefab": "wall_lamp", "at": [6.32, 1.4, 0.59], "name": "wall lamp" },
      // The fence, and a watcher behind the middle of it: it sees the player over the top, and the only
      // way to reach them is round one end (F23). Walk up and watch it commit to a side.
      { "prefab": "hermit",       "at": [5, 0, 5],     "yaw": 200 },
      { "prefab": "fence",        "at": [0, 0.6, -9] },
      { "prefab": "watcher",      "at": [0, 0, -12],   "yaw": 180, "name": "penned watcher" },

      // A scripted camera cut from entity I/O (issue #81): the path in front of the hut's door turns the
      // engine's `sage:scripted_camera` on for three seconds (CameraOn's parameter), once. It looks at
      // the door from beside the path, holds the player's input while it has the screen, and says what
      // the player is looking at through its own output. The hut is the level at (14, -16) from here.
      {
        "prefab": "hut_path", "at": [14, 1.5, -9], "name": "hut path",
        "outputs": [ { "output": "OnStartTouch", "target": "hut_cam", "input": "CameraOn", "parameter": "3", "times": 1 } ]
      },
      // Music from entity I/O (issue #325): the hut yard's trigger crossfades to `hearth` as the player walks
      // in (over its own fadeIn) and back to `wander` over four seconds as they leave.
      {
        "prefab": "hut_yard", "at": [14, 1.5, -16], "name": "hut yard",
        "outputs": [ { "output": "OnStartTouch", "target": "!self", "input": "PlayMusic", "parameter": "sandbox:hearth" },
                     { "output": "OnEndTouch", "target": "!self", "input": "PlayMusic", "parameter": "sandbox:wander 4" } ]
      },
      {
        "prefab": "sage:scripted_camera", "at": [24, 3.5, -2], "yaw": 46, "name": "hut_cam",
        "outputs": [ { "output": "OnCameraOn", "target": "!self", "input": "Say", "parameter": "A hut on the hill. Somebody lives here." } ]
      },

      // The open world (engine issue 4g-7; content/data/open_world.json). The crypt door behind the hut,
      // and the steps in front of it that its way out leads back to.
      { "prefab": "crypt_door",   "at": [20, 1.2, -24], "name": "crypt_door" },
      { "prefab": "spot",         "at": [20, 1, -22],   "yaw": 180, "name": "crypt_steps" },
      // The smith, at his anvil (`forge`) by day and by the west trees (`smith_home`) by night.
      { "prefab": "anvil",        "at": [-6.2, 0.4, 3] },
      { "prefab": "spot",         "at": [-5.2, 0, 3],   "yaw": 90, "name": "forge" },
      { "prefab": "spot",         "at": [-9, 0, -4],    "yaw": 180, "name": "smith_home" },
      { "prefab": "smith",        "at": [-5.2, 0.1, 3], "yaw": 90, "name": "smith" },
      // The road to the wilds, and where it brings you back to; a waystone by the start.
      { "prefab": "road_sign",    "at": [-10, 0.8, 10], "name": "road_sign" },
      { "prefab": "spot",         "at": [-8.5, 1, 11],  "yaw": 0, "name": "road_end" },
      { "prefab": "waystone",     "at": [-2, 0.8, 9],   "name": "clearing_stone",
        "overrides": { "parts": { "travel_point": { "label": "Clearing" } } } },
      // The lake in the basin east of the clearing (engine issue #411; content/data/water.json): placed
      // from the origin, not the ground, because its surface is a height of its own (-8 m).
      { "prefab": "lake",         "at": [137, -11.75, 13], "relativeTo": "Origin", "name": "lake" }
    ]
  }
]
