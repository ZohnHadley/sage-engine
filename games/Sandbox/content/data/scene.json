[
  // The test scene, as data (docs/design/05 §3.5). Edit while the game runs: with `developer 1`,
  // record files hot-reload and the scene respawns. Press Space (Jump) to make things hop.

  // ---- materials -------------------------------------------------------------------------------
  {
    // A game material inheriting from the engine's (07 §3.3): same effect and params, another colour.
    "type": "material",
    "id": "bunny",
    "base": "sage:lit_default",
    "params": { "AlbedoColor": [0.92, 0.86, 0.78, 1] }
  },

  // ---- sprite sheets (06 §3.8, 12 §3) ------------------------------------------------------------
  {
    // 8 view directions x 2 idle frames of 64x96. Frame index = row * 8 + column, so the second row
    // (8..15) is the second frame of each direction. The art is placeholder: the "nose" shows which
    // way it faces and the bars at its feet count the direction group.
    "type": "sprite_sheet",
    "id": "creature",
    "texture": "textures/creature.png",
    "directions": 8,
    "size": [1.2, 1.8],
    "frames": [
      { "rect": [0, 0, 64, 96], "pivot": [32, 94] },   { "rect": [64, 0, 64, 96], "pivot": [32, 94] },
      { "rect": [128, 0, 64, 96], "pivot": [32, 94] }, { "rect": [192, 0, 64, 96], "pivot": [32, 94] },
      { "rect": [256, 0, 64, 96], "pivot": [32, 94] }, { "rect": [320, 0, 64, 96], "pivot": [32, 94] },
      { "rect": [384, 0, 64, 96], "pivot": [32, 94] }, { "rect": [448, 0, 64, 96], "pivot": [32, 94] },
      { "rect": [0, 96, 64, 96], "pivot": [32, 94] },   { "rect": [64, 96, 64, 96], "pivot": [32, 94] },
      { "rect": [128, 96, 64, 96], "pivot": [32, 94] }, { "rect": [192, 96, 64, 96], "pivot": [32, 94] },
      { "rect": [256, 96, 64, 96], "pivot": [32, 94] }, { "rect": [320, 96, 64, 96], "pivot": [32, 94] },
      { "rect": [384, 96, 64, 96], "pivot": [32, 94] }, { "rect": [448, 96, 64, 96], "pivot": [32, 94] }
    ],
    "animations": {
      "idle": {
        "fps": 3,
        "loop": true,
        "dirs": [[0, 8], [1, 9], [2, 10], [3, 11], [4, 12], [5, 13], [6, 14], [7, 15]]
      },
      "attack": {
        // Placeholder art (the same two frames), but a real swing: the blow lands on the "hit" event
        // at step 1, a quarter of a second in, and the attack record's windupTime is only the
        // fallback for a fighter with no animation (12 §3, 16 §3.2).
        "fps": 4,
        "loop": false,
        "dirs": [[0, 8], [1, 9], [2, 10], [3, 11], [4, 12], [5, 13], [6, 14], [7, 15]],
        "events": [ { "frame": 1, "name": "hit" } ]
      }
    }
  },
  {
    // One direction, one frame, no animation: a tree always looks the same from every side.
    "type": "sprite_sheet",
    "id": "tree",
    "texture": "textures/tree.png",
    "directions": 1,
    "size": [2.2, 2.9],
    "material": "sage:sprite_lit",
    "frames": [ { "rect": [0, 0, 96, 128] } ]
  },

  // ---- what the scene is made of (docs/design/05 §3.5, F31) --------------------------------------
  //
  // A prefab describes a *kind*; where instances of it go is the `scene` record at the bottom of this
  // file. Until F31 the two were one `spawn` record, so "a creature" and "the creature at (0,0,-3)"
  // were the same thing, and a second one meant a second copy of the description.
  //
  // A prefab's body is "components" (data by type name) and "parts" (setups a plugin declared).
  // Nothing below names a field the engine invented for the Sandbox's benefit: `sprite`, `body`,
  // `character`, `attributes`, `melee`, `inventory`, `pickup` and `effects` are the engine's parts,
  // and `box_mesh` and `hop` are the Sandbox's own, declared as BoxMeshPart and HopPart.
  {
    "type": "prefab",
    "id": "creature",
    "abstract": true,
    "parts": { "sprite": { "sheet": "creature", "animation": "idle" } }
  },
  {
    // The one that fights: a body the engine moves, attributes, what it swings, and the hide that
    // armours it. `"animation": "idle"` is inherited, and is a clip *name*: clip 0 is whichever name
    // sorts first, which for a Daggerfall sheet is "attack" (12 §3).
    "type": "prefab", "id": "watcher", "base": "creature", "name": "watcher",
    "components": { "AIState": { "schedule": "sage:idle" } },
    "parts": {
      "character": { "layer": "enemy" },
      "attributes": {},
      "faction": "beasts",
      "melee": { "attack": "claws" },
      "effects": ["tough_hide"]
    }
  },
  {
    // The two that don't: an animated billboard with the Sandbox's own `hop` part on it, which is
    // what registering a game part looks like from the data side.
    "type": "prefab", "id": "hopper", "base": "creature", "name": "hopper",
    "parts": { "hop": {} }
  },
  {
    // A capsule body's size is [radius, total height]: it stands *on* the placement point, like the
    // art above it, where a box or a sphere is centred on it (review #44).
    "type": "prefab", "id": "tree", "name": "tree",
    "parts": { "sprite": { "sheet": "tree" }, "body": { "shape": "Capsule", "radius": 0.35, "height": 2.2 } }
  },

  // ---- factions (docs/design/16 §3.5, F24) ---------------------------------------------------------
  //
  // Two kinds of creature that hate each other and both hate you: the watchers of the wood and the
  // firebugs. `standing: -50` is below `hostileBelow`, so they come for the player from the start — a
  // faction that merely *knows* you is neutral, and neutral means it leaves you alone.
  {
    "type": "faction", "id": "beasts", "label": "beasts of the wood", "standing": -50, "killCost": 10,
    "relations": [ { "faction": "sandbox:firebugs", "stance": "Hostile" } ]
  },
  {
    "type": "faction", "id": "firebugs", "label": "firebugs", "standing": -50, "killCost": 10,
    "relations": [ { "faction": "sandbox:beasts", "stance": "Hostile" } ]
  },
  {
    // Neutral to everybody, which is what most of a world is: he does not come for you, and nothing
    // comes for him. Killing him costs you dearly, because he is the only one of him.
    "type": "faction", "id": "hermits", "label": "the hermit", "standing": 0, "killCost": 40
  },

  // ---- talking (docs/design/16 \u00a73.5, F24) -----------------------------------------------------------
  {
    // An errand: kill two of the wood's beasts and come back. The stage after the killing has no
    // objectives of its own — it waits to be *told*, which is what the conversation's "it is done" does
    // (16 §3.5). A quest watches; it never moves anybody.
    "type": "quest",
    "id": "thin_the_wood",
    "label": "Thin the Wood",
    "start": "hunt",
    "stages": [
      {
        "id": "hunt",
        "text": "The hermit asked you to thin the watchers below.",
        "objectives": [ { "kind": "Kill", "faction": "sandbox:beasts", "count": 2 } ],
        "next": "report"
      },
      { "id": "report", "text": "Tell the hermit it is done." }
    ]
  },
  {
    // Four nodes and a trade. What the options *do* is machinery that already existed \u2014 taking an item,
    // giving one, moving a reputation \u2014 which is the whole design: dialogue reaches the rest of the
    // game rather than having rules of its own.
    "type": "dialogue",
    "id": "hermit_talk",
    "label": "the hermit",
    "start": "greet",
    "nodes": [
      {
        "id": "greet",
        "text": "You are the first to come up here in a long while.",
        "options": [
          { "text": "What is this place?", "goto": "place" },
          { "text": "The beasts are getting bolder.", "goto": "beasts" },
          {
            "text": "Take this sword. I have no use for it.",
            "goto": "thanks",
            "requires": { "item": "sandbox:practice_sword" },
            "refusal": "you are carrying no sword",
            "then": { "takeItem": "sandbox:practice_sword", "faction": "sandbox:hermits", "standing": 40 }
          },
          {
            "text": "Is there anything I can do for you?",
            "goto": "errand",
            "requires": { "quest": "sandbox:thin_the_wood", "notStarted": true },
            "refusal": "you have already asked"
          },
          {
            "text": "The watchers are thinned, as you asked.",
            "goto": "paid",
            "requires": { "quest": "sandbox:thin_the_wood", "stage": "report" },
            "refusal": "there is nothing to report",
            "then": { "finishQuest": "sandbox:thin_the_wood", "faction": "sandbox:hermits", "standing": 35 }
          },
          { "text": "Nothing. Good day.", "end": true }
        ]
      },
      {
        "id": "errand",
        "text": "Two of the watchers, if you can manage it. They come up here at night.",
        "options": [
          {
            "text": "I will see to it.",
            "goto": "greet",
            "then": { "startQuest": "sandbox:thin_the_wood" }
          },
          { "text": "Another time.", "goto": "greet" }
        ]
      },
      {
        "id": "paid",
        "text": "Then the hill is quieter for it. You have my thanks, for whatever that is worth.",
        "options": [ { "text": "Goodbye.", "end": true } ]
      },
      {
        "id": "place",
        "text": "Mine, mostly. The wood below is the watchers', and they do not share it.",
        "options": [ { "text": "I see.", "goto": "greet" } ]
      },
      {
        "id": "beasts",
        "text": "They always are. The firebugs keep them busy, which keeps them off me.",
        "options": [ { "text": "Convenient.", "goto": "greet" } ]
      },
      {
        "id": "thanks",
        "text": "Then I am in your debt. Not a word I use lightly.",
        "options": [ { "text": "Goodbye.", "end": true } ]
      }
    ]
  },
  {
    // Somebody to talk to: a billboard with a body so `Use` can reach him, and a dialogue that says
    // what he has to say. No `AIState`, so he stands there \u2014 an NPC is not a creature with a spear.
    "type": "prefab", "id": "hermit", "base": "creature", "name": "hermit",
    "parts": {
      "body": { "size": [0.6, 1.8, 0.6] },
      "attributes": {},
      "faction": "hermits",
      "dialogue": "hermit_talk"
    }
  },

  // ---- gameplay (docs/design/16) -----------------------------------------------------------------
  {
    // What the creature swings (16 §3.2). Longer reach and harder than bare hands, but slow: the
    // player can back out of it. The hit lands on the attack clip's "hit" event.
    "type": "attack",
    "id": "claws",
    "damage": 12,
    "damageType": "sage:physical",
    "reach": 2.2,
    "radius": 0.45,
    "arcDegrees": 140,
    "windupTime": 0.45,
    "recoverTime": 0.3,
    "cooldown": 1.2,
    "animation": "attack"
  },
  {
    // Creature hide: an infinite effect granting armour, so the player's fists do 60% damage to it.
    // Resistance as an effect rather than a starting value means a spell could strip it (16 §3.3).
    "type": "effect",
    "id": "tough_hide",
    "duration": "Infinite",
    "modifiers": [ { "attribute": "sage:armor", "op": "Add", "value": 40 } ]
  },

  // ---- first-person hands (docs/design/13 §3) ----------------------------------------------------
  {
    // Three frames: at rest, drawn back, and the strike. The HUD picks one from the swing's phase.
    "type": "sprite_sheet",
    "id": "hands_fp",
    "texture": "textures/hands.png",
    "directions": 1,
    "frames": [
      { "rect": [0, 0, 128, 128] }, { "rect": [128, 0, 128, 128] }, { "rect": [256, 0, 128, 128] }
    ]
  },
  {
    "type": "sprite_sheet",
    "id": "sword_fp",
    "texture": "textures/sword_fp.png",
    "directions": 1,
    "frames": [
      { "rect": [0, 0, 128, 128] }, { "rect": [128, 0, 128, 128] }, { "rect": [256, 0, 128, 128] }
    ]
  },
  {
    // Bare hands are the engine's attack, so the game patches a look onto it rather than redefining
    // it (05 §3.5): the engine ships no character art.
    "type": "attack",
    "id": "sage:default_attack",
    "patch": true,
    "viewmodel": "sandbox:hands_fp"
  },

  // ---- items (docs/design/16 §3.2, F19) ----------------------------------------------------------
  {
    // One frame, one direction: an item on the ground is just a billboard with a Pickup on it.
    "type": "sprite_sheet",
    "id": "sword_flat",
    "texture": "textures/sword.png",
    "directions": 1,
    "size": [0.5, 0.7],
    "material": "sage:sprite_lit",
    "frames": [ { "rect": [0, 0, 48, 64] } ]
  },
  {
    // What swinging a sword does, as an attack record (16 §3.2): longer, harder and slower than
    // fists, which the combat log shows the moment you equip it.
    "type": "attack",
    "id": "sword_swing",
    "base": "sage:default_attack",
    "damage": 22,
    "reach": 2.4,
    "radius": 0.4,
    "windupTime": 0.25,
    "recoverTime": 0.2,
    "cooldown": 0.55,
    "viewmodel": "sword_fp",
    "swingCue": "weapon_swing"
  },
  {
    // The item itself. Equipping it hands `attack` to the wielder's Melee; nothing in combat knows
    // that a sword exists.
    "type": "item",
    "id": "practice_sword",
    "label": "practice sword",
    "sound": "pickup",
    "sheet": "sword_flat",
    "slot": "MainHand",
    "attack": "sword_swing",
    "weight": 4,
    "value": 20
  },
  {
    // One part, and the engine builds the whole lootable thing from the item record: its sprite, its
    // collider and the Pickup that says what taking it gives you (F19).
    "type": "prefab", "id": "sword_pickup", "name": "practice sword",
    "parts": { "pickup": { "item": "practice_sword" } }
  },

  // ---- magic (docs/design/16 §3.3, F21) ----------------------------------------------------------
  {
    // The cooldown is an effect that grants a tag, not a timer: one clock for everything, it shows up
    // in a save, and a dispel would make the spell ready again.
    "type": "tag",
    "id": "cooldown.fireball",
    "description": "Just threw a fireball"
  },
  {
    "type": "effect",
    "id": "fireball_cooldown",
    "duration": "Timed",
    "time": 2.5,
    "grantTags": ["cooldown.fireball"],
    "modifiers": []
  },
  {
    // Presentation only: the simulation says "a fireball went off here" and the client decides what
    // that looks like. Nothing draws it yet (particles and audio are later phases), but the event is
    // already raised, so the day something listens the spell needs no change.
    "type": "cue",
    "id": "fireball_boom",
    "description": "A fireball bursting",
    "sound": "boom_fire",
    "particles": "fire_burst"
  },
  {
    // The casting itself, so a spell leaving the hand is heard as well as its arrival.
    "type": "cue", "id": "fireball_cast", "description": "A fireball thrown", "sound": "cast_fire"
  },
  {
    // A blade going through the air. The *hit* is the damage type's noise (one entry for "physical"
    // covers every club in the game); this is the weapon's own, and it plays whether the blow lands
    // or not — a miss is information too.
    "type": "cue", "id": "weapon_swing", "description": "A weapon swung", "sound": "swing"
  },
  {
    // Sparks where a spell leaves the hand, so casting looks like something even before it lands.
    "type": "cue", "id": "fireball_cast", "patch": true, "particles": "sparks", "particleCount": 6
  },

  // The engine's damage types carry no sound, because the engine ships no audio (11 §3). Patching is
  // how a game supplies one without owning the record: `sage:physical` keeps everything else it has.
  //
  // **The ids are written out in full on purpose.** A bare name in a patch resolves against the
  // namespace of the record being patched (`sage:`), not the patch's own file, so `hit_flesh` here
  // would look for a sound the engine does not have. See TODO R11.
  {
    // Something that hums on its own (11 §3): a campfire, as data. Nothing in the simulation knows it
    // makes a noise — the component says which sound, and the client's audio system follows it.
    "type": "prefab", "id": "campfire", "name": "campfire",
    "parts": {
      "audio": { "sound": "fire_loop", "loop": true, "volume": 0.8 },
      "particles": { "effect": "embers" }
    }
  },

  { "type": "damage_type", "id": "sage:physical", "patch": true, "sound": "sandbox:hit_flesh",
    "particles": "sandbox:blood", "colour": 4294960111 },
  { "type": "damage_type", "id": "sage:fire", "patch": true, "sound": "sandbox:boom_fire",
    "particles": "sandbox:fire_burst", "colour": 4278229247 },

  // ---- particles (docs/design/06 \u00a73.9, F39) ------------------------------------------------------
  //
  // One white dot, tinted per effect \u2014 that is the whole texture budget of every spark, ember and gout of
  // blood below. `particle_additive` adds it to what is behind, so a spark glows; blood uses the blended
  // one, because blood does not glow.
  {
    "type": "particle", "id": "sparks",
    "texture": "textures/particle.png",
    "burst": 10, "maxParticles": 120,
    "lifeMin": 0.25, "lifeMax": 0.5,
    "speedMin": 2, "speedMax": 5,
    "shape": "Cone", "angleDegrees": 45,
    "gravity": -12, "drag": 1.5,
    "sizeStart": 0.07, "sizeEnd": 0.01,
    "colourStart": 4294960000, "colourEnd": 8388352
  },
  {
    "type": "particle", "id": "blood",
    "texture": "textures/particle.png",
    "material": "sage:particle_blend",
    "burst": 8, "maxParticles": 80,
    "lifeMin": 0.3, "lifeMax": 0.6,
    "speedMin": 1, "speedMax": 3,
    "shape": "Cone", "angleDegrees": 60,
    "gravity": -9.8, "drag": 1,
    "sizeStart": 0.1, "sizeEnd": 0.04,
    "colourStart": 4278190280, "colourEnd": 16777096
  },
  {
    "type": "particle", "id": "fire_burst",
    "texture": "textures/particle.png",
    "burst": 24, "maxParticles": 200,
    "lifeMin": 0.35, "lifeMax": 0.8,
    "speedMin": 1, "speedMax": 6,
    "shape": "Sphere",
    "gravity": 1.5, "drag": 2,
    "sizeStart": 0.35, "sizeEnd": 0.02,
    "colourStart": 4278233087, "colourEnd": 255
  },
  {
    // A steady stream rather than a burst: `rate` instead of `burst`, and that is the only difference
    // between a campfire and an explosion as far as this file is concerned.
    "type": "particle", "id": "embers",
    "texture": "textures/particle.png",
    "rate": 14, "maxParticles": 60,
    "lifeMin": 0.8, "lifeMax": 1.6,
    "speedMin": 0.4, "speedMax": 1.2,
    "shape": "Cone", "angleDegrees": 20,
    "gravity": 0.8, "drag": 0.6,
    "sizeStart": 0.08, "sizeEnd": 0.01,
    "colourStart": 4278237439, "colourEnd": 511
  },

  {
    // Rain: fast, short-lived, and barely affected by drag, so it falls in straight lines. `box` means
    // it starts anywhere in the slab the weather hands it, which is what makes it *weather* rather than
    // a fountain (06 \u00a73.13).
    "type": "particle", "id": "raindrop",
    "texture": "textures/particle.png",
    "material": "sage:particle_blend",
    "maxParticles": 1400,
    "lifeMin": 0.85, "lifeMax": 1.15,
    "speedMin": 14, "speedMax": 18,
    "shape": "Box",
    "gravity": -6, "drag": 0,
    "sizeStart": 0.055, "sizeEnd": 0.055,
    "colourStart": 3003121663, "colourEnd": 1660944383
  },
  {
    // Snow: slow, drifting, and it keeps its size all the way down.
    "type": "particle", "id": "snowflake",
    "texture": "textures/particle.png",
    "material": "sage:particle_blend",
    "maxParticles": 900,
    "lifeMin": 3.5, "lifeMax": 5,
    "speedMin": 0.7, "speedMax": 1.4,
    "shape": "Box",
    "gravity": -0.4, "drag": 0.8,
    "sizeStart": 0.08, "sizeEnd": 0.07,
    "colourStart": 4294967295, "colourEnd": 2164260863
  },

  // ---- weather (docs/design/06 \u00a73.13, F40) --------------------------------------------------------
  //
  // Three skies and the blend between them. `weather rain 8` rolls a storm in over eight seconds: the
  // fog closes, the sun goes out of it, the rain builds up and you start to hear it.
  {
    "type": "weather", "id": "clear", "label": "clear"
  },
  {
    "type": "weather", "id": "rain", "label": "rain",
    "particles": "raindrop", "rate": 900,
    "volume": [26, 14, 26], "ceiling": 10,
    "wind": [-3.5, 0, 1.5],
    "fogColor": [0.30, 0.33, 0.30], "fogStart": 8, "fogEnd": 95,
    "skyColor": [0.26, 0.29, 0.27],
    "sunScale": 0.45, "ambientScale": 0.7,
    "sound": "rain_loop", "soundVolume": 0.55
  },
  {
    "type": "weather", "id": "snow", "label": "snow",
    "particles": "snowflake", "rate": 260,
    "volume": [24, 14, 24], "ceiling": 9,
    "wind": [-0.8, 0, 0.4],
    "fogColor": [0.62, 0.65, 0.70], "fogStart": 12, "fogEnd": 110,
    "skyColor": [0.58, 0.61, 0.66],
    "sunScale": 0.7, "ambientScale": 1.15
  },

  // ---- sounds (docs/design/11 3, F4) --------------------------------------------------------------
  // Generated by tools/make_placeholder_audio.py: the repository ships no audio it does not own.
  {
    // A burst carries a long way, and is worth hearing over everything else.
    "type": "sound", "id": "boom_fire",
    "variations": ["audio/boom_fire.wav"],
    "volume": 0.9, "volumeJitter": 0.05, "pitchJitter": 0.15,
    "minDistance": 6, "maxDistance": 80, "priority": 3, "maxInstances": 4
  },
  {
    "type": "sound", "id": "cast_fire",
    "variations": ["audio/cast_fire.wav"],
    "volume": 0.7, "pitchJitter": 0.2, "minDistance": 4, "maxDistance": 45, "priority": 2
  },
  {
    // Two variations, so a flurry of blows is not one sample on repeat, and a cooldown so two hits in
    // the same tick do not phase against each other (11 3).
    "type": "sound", "id": "hit_flesh",
    "variations": ["audio/hit_flesh_a.wav", "audio/hit_flesh_b.wav"],
    "volume": 0.8, "volumeJitter": 0.1, "pitchJitter": 0.25,
    "cooldown": 0.05, "minDistance": 3, "maxDistance": 35, "priority": 2
  },
  {
    "type": "sound", "id": "swing",
    "variations": ["audio/swing.wav"],
    "volume": 0.5, "pitchJitter": 0.3, "cooldown": 0.05, "minDistance": 2, "maxDistance": 25
  },
  {
    // 2D: a sound about *you* rather than about a place, so it neither pans nor fades.
    "type": "sound", "id": "pickup",
    "variations": ["audio/pickup.wav"],
    "volume": 0.6, "bus": "Ui", "maxDistance": 0, "priority": 4
  },
  {
    // 2D on purpose: rain is not *somewhere*, it is everywhere, so it neither pans nor fades (11 \u00a73).
    "type": "sound", "id": "rain_loop",
    "variations": ["audio/rain_loop.wav"],
    "volume": 0.9, "bus": "Ambient", "maxDistance": 0
  },
  {
    "type": "sound", "id": "fire_loop",
    "variations": ["audio/fire_loop.wav"],
    "volume": 0.5, "bus": "Ambient", "minDistance": 2, "maxDistance": 20, "maxInstances": 8
  },
  {
    // What the fireball looks like on its way: two frames so it flickers, one direction because a ball
    // of fire has no front. The clip loops while it flies.
    "type": "sprite_sheet",
    "id": "fireball_flat",
    "texture": "textures/fireball.png",
    "directions": 1,
    "size": [0.45, 0.45],
    "material": "sage:sprite_lit",
    "frames": [ { "rect": [0, 0, 32, 32] }, { "rect": [32, 0, 32, 32] } ],
    "animations": {
      "idle": { "fps": 12, "loop": true, "dirs": [[0, 1]] }
    }
  },
  {
    // The thing that flies, as a prefab (F31): the spell says how fast and what it does on arrival,
    // and this says what it looks like. No collider — it is the projectile's own sweep that decides
    // what it hits, and giving it a body would make it shove the world on its way.
    "type": "prefab",
    "id": "fireball_bolt",
    "name": "fireball",
    "parts": { "sprite": { "sheet": "fireball_flat", "animation": "idle" } }
  },
  {
    // A fireball: it flies to whatever you are looking at, bursts, and sets what it caught alight.
    // The damage goes through the combat pipeline so `fire_resist` means something, and `burning` is
    // the engine's own effect riding along with it — no part of this spell is new code.
    "type": "ability",
    "id": "fireball",
    "name": "fireball",
    "costAttribute": "sage:mana",
    "cost": 12,
    "cooldown": "fireball_cooldown",
    "targeting": "Projectile",
    "projectile": "fireball_bolt",
    "projectileSpeed": 16,
    "range": 20,
    "radius": 2.5,
    "width": 0.25,
    "castTime": 0.35,
    "damage": 28,
    "damageType": "sage:fire",
    "effects": ["sage:burning"],
    // Two moments, two lists: the throw is heard at the hand and the burst where it lands (11 §3).
    "castCues": ["fireball_cast"],
    "cues": ["fireball_boom"]
  },

  // ---- the player (docs/design/10 §3, 16 §3.1) ---------------------------------------------------
  {
    // A creature's spell: cheaper, weaker and slower than the player's, so a firebug is a nuisance at
    // range rather than an execution. No burst — it hits what it hits.
    "type": "ability",
    "id": "ember_bolt",
    "name": "ember bolt",
    "costAttribute": "sage:mana",
    "cost": 4,
    "cooldown": "ember_cooldown",
    "targeting": "Projectile",
    "projectile": "fireball_bolt",
    "projectileSpeed": 12,
    "range": 16,
    "width": 0.25,
    "castTime": 0.5,
    "damage": 9,
    "damageType": "sage:fire",
    // A creature throwing fire at your back is a sound you want, and from where it is standing.
    "castCues": ["fireball_cast"],
    "cues": ["fireball_boom"]
  },
  { "type": "tag", "id": "cooldown.ember", "description": "Just threw an ember bolt" },
  {
    // Where a firebug's magic comes from: mana back on a timer, for ever. Nothing in the engine
    // regenerates anything (16 §3.3) — it is an infinite effect with a period, which is the same
    // machinery as poison running the other way. Without it the creature spends its fifty mana and
    // then follows the player around unable to act, which is honest and dull.
    "type": "effect",
    "id": "ember_font",
    "duration": "Infinite",
    "period": 2,
    "modifiers": [ { "attribute": "sage:mana", "op": "Add", "value": 5 } ]
  },
  {
    "type": "effect",
    "id": "ember_cooldown",
    "duration": "Timed",
    "time": 2,
    "grantTags": ["cooldown.ember"],
    "modifiers": []
  },
  {
    // The one that casts (16 §3.4, F21). It has no `melee` part on purpose: a creature that cannot
    // swing must not walk into reach to do nothing, and this is what proves it doesn't — it stands at
    // range and throws bolts, because the AI prefers casting to closing when it cannot fight in reach.
    "type": "prefab", "id": "firebug", "base": "creature", "name": "firebug",
    "components": { "AIState": { "schedule": "sage:idle" } },
    "parts": {
      "character": { "layer": "enemy" },
      "attributes": {},
      "faction": "firebugs",
      "abilities": ["ember_bolt"],
      "effects": ["ember_font"]
    }
  },
  {
    // The same parts as the creature, plus the tag that says the local PlayerCommand drives this one.
    // Where the player starts is the scene's "player" placement, not this record.
    "type": "prefab",
    "id": "player",
    "name": "player",
    "tags": ["PlayerControlled"],
    "parts": {
      "character": { "layer": "player" },
      "attributes": {},
      "melee": { "attack": "sage:default_attack" },
      "inventory": { "capacity": 60 },
      "abilities": ["fireball"]
    }
  },

  // ---- physics (docs/design/10) -----------------------------------------------------------------
  {
    // Crates fall onto the terrain's collision mesh and settle. `box_mesh` is the Sandbox's own part:
    // building a box mesh at runtime needs the renderer, which is client-side and no business of the
    // engine's prefab code. A mass makes it a dynamic body; without one it would be static.
    "type": "prefab",
    "id": "crate",
    "name": "crate",
    "parts": {
      "box_mesh": { "size": [0.6, 0.6, 0.6], "material": "crate" },
      "body": { "size": [0.6, 0.6, 0.6], "mass": 8 }
    }
  },
  {
    // A trigger the crates fall through: it reports overlaps but never pushes anything.
    "type": "prefab", "id": "gate", "name": "gate",
    "parts": { "body": { "size": [4, 0.4, 3], "trigger": true } }
  },
  {
    // Waist high and eight metres long: something a creature can see you over but not walk through, so
    // it has to find its own way round (16 \u00a73.4, F23). No mass, so it is static and stays where it is
    // put; `nav_enabled 0` turns the pathfinding off and it goes back to leaning on it.
    "type": "prefab", "id": "fence", "name": "fence",
    "parts": {
      "box_mesh": { "size": [8, 1.2, 0.4], "material": "crate" },
      "body": { "size": [8, 1.2, 0.4] }
    }
  },
  {
    "type": "material",
    "id": "crate",
    "base": "sage:lit_default",
    "params": { "AlbedoColor": [0.72, 0.5, 0.26, 1] }
  },

  {
    // The mesh from step 6 is still here: meshes and sprites share the passes and the sort order.
    // A MeshRenderer is plain data, so it is a component rather than a part, and `FacesCamera` is a
    // tag the Sandbox declares — addressable by name because Friflo's schema already knows it.
    "type": "prefab",
    "id": "bunny",
    "name": "bunny",
    "components": { "MeshRenderer": { "mesh": "models/bunny.glb", "material": "bunny" } },
    "tags": ["FacesCamera"],
    "parts": { "hop": {} }
  },

  // ---- where the instances go --------------------------------------------------------------------
  {
    // Placement is not the prefab's business. Map files with a persistent id and per-entity overrides
    // are F27 (09 §3.4); until then this is the Sandbox's own list, and it is four fields wide
    // instead of the twenty the old `spawn` record had grown.
    //
    // "at" is relative to the scene's spot in the sector, and its y is height above the ground:
    // everything stands on the terrain. Yaw is the engine's one convention (SageMath): degrees about
    // +Y, 0 faces -Z, growing counter-clockwise seen from above. The player starts away at +Z, so
    // the watcher's "yaw": 180 looks back at them.
    "type": "scene",
    "id": "main",

    // Brush levels (15 §3, F16): the hut, from maps/hut.map.
    "maps": ["hut"],
    "player": { "prefab": "player", "at": [0, 1, 6] },
    "place": [
      { "prefab": "watcher",      "at": [0, 0, -3],    "yaw": 180 },
      { "prefab": "firebug",      "at": [-7, 0, -6],   "yaw": 150 },
      { "prefab": "campfire",     "at": [3, 0, 2] },
      { "prefab": "hopper",       "at": [2.5, 0, 0],   "yaw": -90, "name": "eastward" },
      { "prefab": "hopper",       "at": [-2.5, 0, 0],  "yaw": 0,   "name": "away" },
      { "prefab": "tree",         "at": [4.5, 0, -3] },
      { "prefab": "tree",         "at": [-4.5, 0, -4] },
      { "prefab": "tree",         "at": [0, 0, -7] },
      { "prefab": "sword_pickup", "at": [0.4, 0, 4.2] },
      { "prefab": "bunny",        "at": [0, 0, -2] },
      { "prefab": "crate",        "at": [-0.7, 6, 1.5] },
      { "prefab": "crate",        "at": [0, 8, 1.8] },
      { "prefab": "crate",        "at": [0.7, 10, 1.4] },
      { "prefab": "gate",         "at": [0, 3, 1.6] },
      // The fence, and a watcher behind the middle of it: it sees the player over the top, and the only
      // way to reach them is round one end (F23). Walk up and watch it commit to a side.
      { "prefab": "hermit",       "at": [5, 0, 5],     "yaw": 200 },
      { "prefab": "fence",        "at": [0, 0.6, -9] },
      { "prefab": "watcher",      "at": [0, 0, -12],   "yaw": 180, "name": "penned watcher" }
    ]
  }
]
