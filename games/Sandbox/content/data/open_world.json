[
  // The Sandbox's open world (engine issue 4g-7, phase 4g): a crypt behind a door on the hut's hill, a
  // smith who keeps the hours of his forge, a road to the wilds — a scene that streams sector by sector —
  // and waystones to fast travel between them. All data: the door, the routine, the scenes and the stones
  // are the engine's parts and records, and resting is the RPG kit's (T, the `rpg:rest` screen).
  //
  //   main ── crypt door (Use) ──> crypt            an interior: no sun, no terrain, lit by its torches
  //   main ── road sign (Use, 2 h) ──> wilds        streamed: placed as the ring reaches each sector
  //   waystones: walk near one and it is on the map (N), where choosing it travels there

  // ---- the crypt (`"space": "Interior"`) ------------------------------------------------------------
  // Generated by tools/make_crypt.py. Placed far from everything else, though nothing outside is placed
  // while you are in it: the village goes to sleep with its state and the terrain unloads (4g-5).
  { "type": "map", "id": "crypt", "file": "maps/crypt.map", "at": [512, 0, 6656] },
  {
    "type": "scene", "id": "crypt", "space": "Interior", "maps": ["crypt"],
    // No sky inside: this and the torches are all the light there is.
    "environment": { "ambient": [0.05, 0.045, 0.05] }
  },
  {
    // A torch on the crypt's wall: a point light that is always lit and flickers (the `flicker` preset, a
    // Quake light style; engine issue #314), and its embers.
    "type": "prefab", "id": "crypt_torch", "name": "torch",
    "parts": {
      "light": { "colour": [1.0, 0.62, 0.32], "range": 9, "intensity": 2.6, "pattern": "flicker" },
      "particles": { "effect": "embers" }
    }
  },
  {
    // The way out: Use it and you are on the hill again, on the steps in front of the crypt door.
    "type": "prefab", "id": "crypt_exit", "name": "way out",
    "parts": {
      "box_mesh": { "size": [1.6, 2.4, 0.3], "material": "door" },
      "body": { "size": [1.6, 2.4, 0.3] },
      "load_door": { "scene": "main", "entry": "crypt_steps" }
    }
  },
  {
    // The crypt door on the hut's hill, and its way in (the map's `crypt_in` point).
    "type": "prefab", "id": "crypt_door", "name": "crypt door",
    "components": { "map_marker": { "label": "@sandbox.map.crypt", "style": "sandbox:map_place" } },
    "parts": {
      "box_mesh": { "size": [1.6, 2.4, 0.3], "material": "door" },
      "body": { "size": [1.6, 2.4, 0.3] },
      "load_door": { "scene": "crypt", "entry": "crypt_in" }
    }
  },
  // Where a door or a routine says to stand: a name and a place, nothing else.
  { "type": "prefab", "id": "spot", "name": "spot" },

  // ---- the smith (an NPC routine, 4g-4) ---------------------------------------------------------------
  // At the forge from eight to eight, at home by the west trees the rest of the night. The Sandbox opens at
  // dusk (18:30), so he is at work; `time_set 20` (or resting past it) and he walks home. A fight would
  // come first, but nobody is his enemy.
  {
    "type": "faction", "id": "village", "label": "the village", "standing": 0, "killCost": 30
  },
  {
    "type": "ai_schedule", "id": "keep_routine",
    "tasks": ["MoveToAnchor", "FaceAnchor", "StayAt"],
    "interrupts": ["SeeEnemy"]
  },
  {
    "type": "routine", "id": "smith",
    "entries": [ { "from": 8, "to": 20, "schedule": "keep_routine", "at": "forge" },
                 { "from": 20, "to": 8, "schedule": "keep_routine", "at": "smith_home" } ]
  },
  {
    "type": "prefab", "id": "smith", "base": "creature", "name": "smith",
    "components": { "ai_state": { "schedule": "sage:idle" },
                    "map_marker": { "label": "@sandbox.map.smith", "style": "sandbox:map_person" } },
    "parts": {
      "character": { "layer": "enemy" },
      "attributes": {},
      "faction": "village",
      "routine": "smith"
    }
  },
  {
    // The anvil he works at (the routine's anchor is the spot in front of it, `forge`).
    "type": "prefab", "id": "anvil", "name": "anvil",
    "parts": {
      "box_mesh": { "size": [0.9, 0.8, 0.5], "material": "gunmetal" },
      "body": { "size": [0.9, 0.8, 0.5] }
    }
  },

  // ---- the wilds (`"streamed": true`, 4g-3) -----------------------------------------------------------
  // Four kilometres east of the clearing, along a road two kilometres long: three sectors, each placed when
  // the ring reaches it and asleep, with whatever happened in it, when the ring leaves. The ground is the
  // Sandbox's own hills (no `terrain` record: the game's C# generator).
  {
    "type": "scene", "id": "wilds", "streamed": true,
    "origin": [4608, 0, 512],
    "relativeTo": "Ground",
    "environment": { "sky": "day" },
    "place": [
      { "prefab": "spot",       "at": [0, 1, 2],     "yaw": -90, "name": "wilds_start" },
      { "prefab": "road_sign",  "at": [-2, 0.8, 4],  "yaw": -90, "name": "road home" },
      { "prefab": "waystone",   "at": [3, 0.8, -1],  "name": "old_road_stone",
        "overrides": { "parts": { "travel_point": { "label": "Old Road" } } } },
      { "prefab": "tree",       "at": [-6, 0, -5] },
      { "prefab": "tree",       "at": [10, 0, 8] },
      { "prefab": "tree",       "at": [420, 0, -14] },
      { "prefab": "tree",       "at": [760, 0, 22] },
      { "prefab": "tree",       "at": [1500, 0, -9] },
      { "prefab": "tree",       "at": [1900, 0, 14] },
      // The hunters' camp, in the next sector east: a fire, a stone to come back to, and a hopper.
      { "prefab": "campfire",   "at": [1100, 0, 0] },
      { "prefab": "waystone",   "at": [1103, 0.8, 3], "name": "camp_stone",
        "overrides": { "parts": { "travel_point": { "label": "Hunters' Camp" } } } },
      { "prefab": "hopper",     "at": [1097, 0, -3], "name": "camp hopper" },
      // And past it, in the sector after, something that does not want company.
      { "prefab": "watcher",    "at": [2100, 0, 0],  "yaw": 90, "name": "far watcher" }
    ]
  },
  {
    // A signpost at the edge of the clearing: Use it and two hours later you are on the road east.
    "type": "prefab", "id": "road_sign", "name": "road sign",
    "components": { "map_marker": { "label": "@sandbox.map.road", "style": "sandbox:map_place" } },
    "parts": {
      "box_mesh": { "size": [0.2, 1.6, 0.2], "material": "wood" },
      "body": { "size": [0.4, 1.6, 0.4] },
      "load_door": { "scene": "wilds", "entry": "wilds_start", "hours": 2 }
    }
  },

  // ---- fast travel (`travel_point`, 4g-5; the kit's map, 4g-7) ----------------------------------------
  // A standing stone: come within eight metres and it is discovered, and the map (N) shows it as a place
  // you can travel to. No map_marker of its own: the kit's map draws a discovered point itself.
  { "type": "material", "id": "stone", "base": "sage:lit_default", "params": { "AlbedoColor": [0.5, 0.5, 0.52, 1] } },
  {
    "type": "prefab", "id": "waystone", "name": "waystone",
    "parts": {
      "box_mesh": { "size": [0.5, 1.6, 0.5], "material": "stone" },
      "body": { "size": [0.5, 1.6, 0.5] },
      "travel_point": { "label": "Waystone", "radius": 8 }
    }
  },

  // ---- resting (the RPG kit's rule, 4g-7) -------------------------------------------------------------
  // T opens the rest screen. Sleeping is refused with a hostile creature within 25 m (the watcher by the
  // start is one); waking heals five health an hour slept, through this effect.
  { "type": "rpg_conventions", "id": "rpg", "restEnemyRange": 25, "restMaxHours": 24, "restEffect": "rest_heal" },
  {
    "type": "effect", "id": "rest_heal",
    "modifiers": [ { "attribute": "sage:health", "op": "Add", "value": 5 } ]
  }
]
