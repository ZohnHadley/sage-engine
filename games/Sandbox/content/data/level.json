[
  // The Sandbox's brush level (docs/design/15 §3, TODO F16): a hut drawn in TrenchBroom's format and
  // generated by `tools/make_hut.py`. It sits on the hillside north-east of the scene's centre, which is
  // near enough to walk to and far enough to see from outside first.
  {
    "type": "map",
    "id": "hut",
    "file": "maps/hut.map",
    // Absolute metres. A scene placement's `at` is relative to the scene centre; a level's is not,
    // because a level is a place rather than a thing standing in one — so this is the scene centre
    // (half a sector, 512 m) plus the offset that puts the hut a short walk north-east of the player.
    // `onTerrain` stands it on the ground and reads y as the height above it.
    "at": [526, 0, 496],
    "onTerrain": true
  },

  // A lamp (06 §3.9, F2). The hut places two of these by classname, which is all a `.map` needs to say:
  // what a lamp *is* — how warm, how far it reaches — lives here, so changing it changes every one.
  //
  // And when it is lit (phase 4h's exit, engine issue 4h-7): it starts dark, and `sandbox:lamp` below
  // switches it on from sunset to sunrise by the world's clock. No C#: a state machine, a `time_between`
  // condition and the light's TurnOn/TurnOff inputs.
  {
    "type": "prefab",
    "id": "light",
    "name": "lamp",
    "parts": {
      "light": { "colour": [1.0, 0.82, 0.55], "range": 7, "intensity": 2.2, "off": true },
      "state_machine": { "machine": "lamp" }
    }
  },
  {
    // The night is the Sandbox sky's (scene.json `sandbox:day`): the sun is down at 19:30 and up at 5:30.
    // Transitions from any state never go to the state the lamp is in, so each fires once a dusk or dawn.
    "type": "state_machine",
    "id": "lamp",
    "initial": "off",
    "states": {
      "off": { "enter": [ { "fire": "!self", "input": "TurnOff" } ] },
      "on":  { "enter": [ { "fire": "!self", "input": "TurnOn" } ] }
    },
    "transitions": [
      { "to": "on",  "when": { "time_between": { "from": 19.5, "to": 5.5 } } },
      { "to": "off", "when": { "not": { "time_between": { "from": 19.5, "to": 5.5 } } } }
    ]
  },

  // A face's texture name becomes a material in the map's namespace: `wall` in `sandbox:hut` looks for
  // `sandbox:wall`. They are ordinary materials, so a mod overrides the look of a level without touching
  // the level (07 §3.3, 17 §3).
  {
    "type": "material",
    "id": "wall",
    "base": "sage:lit_default",
    "params": { "Albedo": "textures/hut_wall.png" }
  },
  {
    "type": "material",
    "id": "floor",
    "base": "sage:lit_default",
    "params": { "Albedo": "textures/hut_floor.png" }
  },
  {
    // The door's own look. Its texture name is `door`, so this is the material it finds.
    "type": "material",
    "id": "door",
    "base": "sage:lit_default",
    "params": { "Albedo": "textures/hut_door.png" }
  },

  // The door itself (04 §3.4, F17). The map says where it is and what using it does; this says what a
  // door *is* — geometry that slides two metres aside over a second and a half and shuts again five
  // seconds later. Change it here and every door in every level changes.
  //
  // Two metres east, which is its own width, so it clears the opening and ends up behind the wall
  // beside it. (Up works too, and is what it did first — but a three-metre door in a four-metre wall
  // comes out through the roof.)
  {
    "type": "prefab",
    "id": "door",
    "name": "door",
    "parts": {
      "mover": { "open": [2, 0, 0], "seconds": 1.5, "closeAfter": 5 }
    }
  },

  {
    "type": "material",
    "id": "roof",
    "base": "sage:lit_default",
    "params": { "Albedo": "textures/hut_roof.png" }
  }
]
