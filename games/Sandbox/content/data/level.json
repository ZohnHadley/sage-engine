[
  // The Sandbox's brush level (docs/design/15 §3, TODO F16): a hut drawn in TrenchBroom's format and
  // generated by `tools/make_hut.py`. It sits on the hillside north-east of the scene's centre, which is
  // near enough to walk to and far enough to see from outside first.
  {
    "type": "map",
    "id": "hut",
    "file": "maps/hut.map",
    // Absolute metres. A scene placement's `at` is relative to the scene centre; a level's is not,
    // because a level is a place rather than a thing standing in one — so this is the scene centre
    // (half a sector, 512 m) plus the offset that puts the hut a short walk north-east of the player.
    // `onTerrain` stands it on the ground and reads y as the height above it.
    "at": [526, 0, 496],
    "onTerrain": true
  },

  // A face's texture name becomes a material in the map's namespace: `wall` in `sandbox:hut` looks for
  // `sandbox:wall`. They are ordinary materials, so a mod overrides the look of a level without touching
  // the level (07 §3.3, 17 §3).
  {
    "type": "material",
    "id": "wall",
    "base": "sage:lit_default",
    "params": { "Albedo": "textures/hut_wall.png" }
  },
  {
    "type": "material",
    "id": "floor",
    "base": "sage:lit_default",
    "params": { "Albedo": "textures/hut_floor.png" }
  },
  {
    "type": "material",
    "id": "roof",
    "base": "sage:lit_default",
    "params": { "Albedo": "textures/hut_roof.png" }
  }
]
