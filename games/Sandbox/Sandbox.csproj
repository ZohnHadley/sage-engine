<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The Sandbox game's *simulation* (docs/design/01 §3.3, ARCHITECTURE §7, TODO R15): the scene, the
    rules, spawning, the combat log. It references the base engine (games/Directory.Build.props) and nothing else, so the compiler
    enforces what used to be a habit — no MonoGame in here — and the game's own rules can be ticked
    in a headless test. Anything needing a screen is in `Sandbox.Client`.

    A plain library; the host loads bin/<config>/net8.0/Sandbox.dll through game.json. The engine
    references are compile-time only (Private=false): at run time the host's own copies are used.
  -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Sandbox</RootNamespace>
    <!-- The simulation half: a MonoGame type here is a build error (SAGE0024). -->
    <SageSimulationOnly>true</SageSimulationOnly>
    <!-- Don't copy MonoGame/Friflo etc. next to the game dll: the host already has them loaded. -->
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <!-- The RPG kit it is built on (game.json "kits", issue #27). Compile-time only, like the base: the
       host loads the kit's own copy, from beside itself. -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\Sage.Kits.Rpg\Sage.Kits.Rpg.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <None Include="game.json" />
    <None Include="content\**\*" />
  </ItemGroup>
</Project>
