{
  // The Sandbox game (docs/design/01 §3.3). Loaded by the host with -game games/Sandbox (no build loads
  // a game by default any more). Mounts are relative to this folder and come after engine content, in order.
  "name": "Sandbox",
  "id": "sandbox",
  "assembly": "bin/{config}/net8.0/Sandbox.dll",
  "mounts": ["content"],
  "modsDirectory": "mods",
  // Built on the RPG kit (issue #27): the readied spell, the spellmaker, the bag and spellbook panels,
  // the journal and conversation screens. Not part of the base engine, so a game names it; the host
  // finds Sage.Kits.Rpg.dll (and, with a window, Sage.Kits.Rpg.Client.dll) beside itself.
  "kits": ["sage.kits.rpg"],
  // The scene every world starts in (issue #29): content/data/scene.json's `sandbox:main`.
  "scene": "main",
  // The client half (R15): the simulation is Sandbox.dll, anything needing a screen is here. A
  // dedicated server would leave this out.
  "modules": { "disable": [], "add": ["../Sandbox.Client/bin/{config}/net8.0/Sandbox.Client.dll"] }
}
