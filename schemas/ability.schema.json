{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage ability record",
  "description": "A ability record (AbilityRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "ability"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another ability record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:ability"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "name": {
      "description": "(string, default \"\")",
      "default": "",
      "type": "string"
    },
    "costAttribute": {
      "description": "Names a attribute record. (RecordRef<AttributeRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:attribute"
        }
      ]
    },
    "cost": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "cooldown": {
      "description": "Names a effect record. (RecordRef<EffectRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:effect"
        }
      ]
    },
    "targeting": {
      "description": "(AbilityTargeting, default \"Self\")",
      "default": "Self",
      "type": "string",
      "enum": [
        "Self",
        "Touch",
        "Area",
        "TouchArea",
        "Projectile"
      ]
    },
    "range": {
      "description": "(float, default 8)",
      "default": 8,
      "type": "number"
    },
    "radius": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "width": {
      "description": "(float, default 0.2)",
      "default": 0.2,
      "type": "number"
    },
    "castTime": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "damage": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "damageType": {
      "description": "Names a damage_type record. (RecordRef<DamageTypeRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:damage_type"
        }
      ]
    },
    "effects": {
      "description": "Names a effect record. (List<RecordRef<EffectRecord>>)",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:effect"
      }
    },
    "effects+": {
      "description": "Adds to \"effects\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:effect"
      }
    },
    "effects-": {
      "description": "Removes these from \"effects\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:effect"
      }
    },
    "magnitude": {
      "description": "(float, default 1)",
      "default": 1,
      "type": "number"
    },
    "requireTags": {
      "description": "Names a tag record. (List<RecordRef<TagRecord>>)",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "requireTags+": {
      "description": "Adds to \"requireTags\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "requireTags-": {
      "description": "Removes these from \"requireTags\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "blockTags": {
      "description": "Names a tag record. (List<RecordRef<TagRecord>>)",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "blockTags+": {
      "description": "Adds to \"blockTags\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "blockTags-": {
      "description": "Removes these from \"blockTags\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "castCues": {
      "description": "Names a cue record. (List<RecordRef<CueRecord>>)",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:cue"
      }
    },
    "castCues+": {
      "description": "Adds to \"castCues\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:cue"
      }
    },
    "castCues-": {
      "description": "Removes these from \"castCues\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:cue"
      }
    },
    "cues": {
      "description": "Names a cue record. (List<RecordRef<CueRecord>>)",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:cue"
      }
    },
    "cues+": {
      "description": "Adds to \"cues\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:cue"
      }
    },
    "cues-": {
      "description": "Removes these from \"cues\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:cue"
      }
    },
    "animation": {
      "description": "(string, default \"\")",
      "default": "",
      "type": "string"
    },
    "projectile": {
      "description": "Names a prefab record. (RecordRef<PrefabRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:prefab"
        }
      ]
    },
    "projectileSpeed": {
      "description": "(float, default 18)",
      "default": 18,
      "type": "number"
    }
  },
  "additionalProperties": false
}
