{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage material record",
  "description": "A material record (MaterialRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "material"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another material record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:material"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "effect": {
      "description": "A shader path. (AssetPath)",
      "type": "string"
    },
    "technique": {
      "description": "(string, default \"Default\")",
      "default": "Default",
      "type": "string"
    },
    "pass": {
      "description": "(RenderPass, default \"Opaque\")",
      "default": "Opaque",
      "type": "string",
      "enum": [
        "Opaque",
        "AlphaTested",
        "Transparent"
      ]
    },
    "blend": {
      "description": "(MaterialBlend, default \"Opaque\")",
      "default": "Opaque",
      "type": "string",
      "enum": [
        "Opaque",
        "AlphaBlend",
        "Additive"
      ]
    },
    "cull": {
      "description": "(MaterialCull, default \"Back\")",
      "default": "Back",
      "type": "string",
      "enum": [
        "Back",
        "None"
      ]
    },
    "depthWrite": {
      "description": "(bool, default true)",
      "default": true,
      "type": "boolean"
    },
    "depthTest": {
      "description": "(bool, default true)",
      "default": true,
      "type": "boolean"
    },
    "fog": {
      "description": "(bool, default true)",
      "default": true,
      "type": "boolean"
    },
    "sampler": {
      "description": "(SamplerDesc)",
      "type": "object",
      "properties": {
        "filter": {
          "description": "(SamplerFilter)",
          "type": "string",
          "enum": [
            "Point",
            "Linear",
            "Anisotropic"
          ]
        },
        "address": {
          "description": "(SamplerAddress)",
          "type": "string",
          "enum": [
            "Wrap",
            "Clamp"
          ]
        }
      },
      "additionalProperties": false
    },
    "params": {
      "description": "(Dictionary<string, MaterialParam>)",
      "type": "object",
      "additionalProperties": {
        "description": "A material parameter: a number, 1 to 16 numbers, a texture path, or rt:<name> for one of the renderer's render targets.",
        "anyOf": [
          {
            "type": "number"
          },
          {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 1,
            "maxItems": 16
          },
          {
            "type": "string"
          }
        ]
      }
    }
  },
  "additionalProperties": false
}
