{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage item record",
  "description": "A item record (ItemRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "item"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another item record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:item"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "label": {
      "description": "(string, default \"\")",
      "default": "",
      "type": "string"
    },
    "sheet": {
      "description": "Names a sprite_sheet record. (RecordRef<SpriteSheetRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:sprite_sheet"
        }
      ]
    },
    "size": {
      "description": "(Vector2, default [0,0])",
      "default": [
        0,
        0
      ],
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "slot": {
      "description": "(EquipSlot, default \"None\")",
      "default": "None",
      "type": "string",
      "enum": [
        "None",
        "MainHand",
        "OffHand"
      ]
    },
    "attack": {
      "description": "Names a attack record. (RecordRef<AttackRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:attack"
        }
      ]
    },
    "effects": {
      "description": "Names a effect record. (List<RecordRef<EffectRecord>>)",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:effect"
      }
    },
    "effects+": {
      "description": "Adds to \"effects\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:effect"
      }
    },
    "effects-": {
      "description": "Removes these from \"effects\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:effect"
      }
    },
    "weight": {
      "description": "(float, default 1)",
      "default": 1,
      "type": "number"
    },
    "value": {
      "description": "(int, default 0)",
      "default": 0,
      "type": "integer"
    },
    "maxStack": {
      "description": "(int, default 1)",
      "default": 1,
      "type": "integer"
    },
    "sound": {
      "description": "Names a sound record. (RecordRef<SoundRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:sound"
        }
      ]
    },
    "uses": {
      "description": "(List<IItemUse>)",
      "type": "array",
      "items": {
        "$ref": "vocabularies.schema.json#/definitions/item_use"
      }
    },
    "uses+": {
      "description": "Adds to \"uses\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "vocabularies.schema.json#/definitions/item_use"
      }
    },
    "uses-": {
      "description": "Removes these from \"uses\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "vocabularies.schema.json#/definitions/item_use"
      }
    }
  },
  "additionalProperties": false
}
