{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage damage_type record",
  "description": "A damage_type record (DamageTypeRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "damage_type"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another damage_type record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:damage_type"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "sound": {
      "description": "Names a sound record. (RecordRef<SoundRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:sound"
        }
      ]
    },
    "particles": {
      "description": "Names a particle record. (RecordRef<ParticleRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:particle"
        }
      ]
    },
    "colour": {
      "description": "(uint, default \"#00000000\")",
      "default": "#00000000",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\s*#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})\\s*$"
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 4
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      ]
    },
    "resist": {
      "description": "Names a attribute record. (RecordRef<AttributeRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:attribute"
        }
      ]
    },
    "effect": {
      "description": "Names a effect record. (RecordRef<EffectRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:effect"
        }
      ]
    }
  },
  "additionalProperties": false
}
