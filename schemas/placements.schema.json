{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage placements record",
  "description": "A placements record (PlacementsRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "placements"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another placements record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:placements"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "place": {
      "description": "(List<Placement>)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefab": {
            "description": "Names a prefab record. (RecordRef<PrefabRecord>)",
            "allOf": [
              {
                "$ref": "ids.schema.json#/definitions/record:prefab"
              }
            ]
          },
          "at": {
            "description": "(Vector3)",
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "yaw": {
            "description": "(float)",
            "type": "number"
          },
          "name": {
            "description": "(string)",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "place+": {
      "description": "Adds to \"place\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefab": {
            "description": "Names a prefab record. (RecordRef<PrefabRecord>)",
            "allOf": [
              {
                "$ref": "ids.schema.json#/definitions/record:prefab"
              }
            ]
          },
          "at": {
            "description": "(Vector3)",
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "yaw": {
            "description": "(float)",
            "type": "number"
          },
          "name": {
            "description": "(string)",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "place-": {
      "description": "Removes these from \"place\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "prefab": {
            "description": "Names a prefab record. (RecordRef<PrefabRecord>)",
            "allOf": [
              {
                "$ref": "ids.schema.json#/definitions/record:prefab"
              }
            ]
          },
          "at": {
            "description": "(Vector3)",
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 3,
            "maxItems": 3
          },
          "yaw": {
            "description": "(float)",
            "type": "number"
          },
          "name": {
            "description": "(string)",
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
