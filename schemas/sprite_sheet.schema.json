{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage sprite_sheet record",
  "description": "A sprite_sheet record (SpriteSheetRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "sprite_sheet"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another sprite_sheet record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:sprite_sheet"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "texture": {
      "description": "A texture path. (AssetPath)",
      "type": "string"
    },
    "material": {
      "description": "Names a material record. (RecordRef<MaterialRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:material"
        }
      ]
    },
    "directions": {
      "description": "(int, default 1)",
      "default": 1,
      "type": "integer"
    },
    "size": {
      "description": "(Vector2, default [1,1])",
      "default": [
        1,
        1
      ],
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 2,
      "maxItems": 2
    },
    "mode": {
      "description": "(BillboardMode, default \"Cylindrical\")",
      "default": "Cylindrical",
      "type": "string",
      "enum": [
        "Cylindrical",
        "Spherical"
      ]
    },
    "frames": {
