        "properties": {
          "rect": {
            "description": "(int[])",
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "rect+": {
            "description": "Adds to \"rect\": what a base or an earlier definition listed, then these.",
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "rect-": {
            "description": "Removes these from \"rect\" (as a base or an earlier definition listed it).",
            "type": "array",
            "items": {
              "type": "integer"
            }
          },
          "pivot": {
            "description": "(int[])",
