{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage weather record",
  "description": "A weather record (WeatherRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "weather"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another weather record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:weather"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "label": {
      "description": "(string, default \"\")",
      "default": "",
      "type": "string"
    },
    "particles": {
      "description": "Names a particle record. (RecordRef<ParticleRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:particle"
        }
      ]
    },
    "rate": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "volume": {
      "description": "(Vector3, default [28,16,28])",
      "default": [
        28,
        16,
        28
      ],
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "ceiling": {
      "description": "(float, default 9)",
      "default": 9,
      "type": "number"
    },
    "wind": {
      "description": "(Vector3, default [0,0,0])",
      "default": [
        0,
        0,
        0
      ],
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "fogColor": {
      "description": "(Vector3, default [0.333,0.42,0.184])",
      "default": [
        0.333,
        0.42,
        0.184
      ],
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "fogStart": {
      "description": "(float, default 30)",
      "default": 30,
      "type": "number"
    },
    "fogEnd": {
      "description": "(float, default 200)",
      "default": 200,
      "type": "number"
    },
    "skyColor": {
      "description": "(Vector3, default [0.333,0.42,0.184])",
      "default": [
        0.333,
        0.42,
        0.184
      ],
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "sunScale": {
      "description": "(float, default 1)",
      "default": 1,
      "type": "number"
    },
    "ambientScale": {
      "description": "(float, default 1)",
      "default": 1,
      "type": "number"
    },
    "sound": {
      "description": "Names a sound record. (RecordRef<SoundRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:sound"
        }
      ]
    },
    "soundVolume": {
      "description": "(float, default 1)",
      "default": 1,
      "type": "number"
    }
  },
  "additionalProperties": false
}
