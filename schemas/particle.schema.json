{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage particle record",
  "description": "A particle record (ParticleRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "particle"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another particle record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:particle"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "texture": {
      "description": "A texture path. (AssetPath)",
      "type": "string"
    },
    "material": {
      "description": "Names a material record. (RecordRef<MaterialRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:material"
        }
      ]
    },
    "burst": {
      "description": "(int, default 0)",
      "default": 0,
      "type": "integer"
    },
    "rate": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "maxParticles": {
      "description": "(int, default 256)",
      "default": 256,
      "type": "integer"
    },
    "lifeMin": {
      "description": "(float, default 0.5)",
      "default": 0.5,
      "type": "number"
    },
    "lifeMax": {
      "description": "(float, default 1)",
      "default": 1,
      "type": "number"
    },
    "speedMin": {
      "description": "(float, default 1)",
      "default": 1,
      "type": "number"
    },
    "speedMax": {
      "description": "(float, default 3)",
      "default": 3,
      "type": "number"
    },
    "shape": {
      "description": "(EmitShape, default \"Cone\")",
      "default": "Cone",
      "type": "string",
      "enum": [
        "Point",
        "Cone",
        "Sphere",
        "Box"
      ]
    },
    "angleDegrees": {
      "description": "(float, default 25)",
      "default": 25,
      "type": "number"
    },
    "extents": {
      "description": "(Vector3, default [0,0,0])",
      "default": [
        0,
        0,
        0
      ],
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "gravity": {
      "description": "(float, default -9.81)",
      "default": -9.81,
      "type": "number"
    },
    "wind": {
      "description": "(Vector3, default [0,0,0])",
      "default": [
        0,
        0,
        0
      ],
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "drag": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "sizeStart": {
      "description": "(float, default 0.15)",
      "default": 0.15,
      "type": "number"
    },
    "sizeEnd": {
      "description": "(float, default 0.05)",
      "default": 0.05,
      "type": "number"
    },
    "colourStart": {
      "description": "(uint, default \"#FFFFFFFF\")",
      "default": "#FFFFFFFF",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\s*#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})\\s*$"
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 4
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      ]
    },
    "colourEnd": {
      "description": "(uint, default \"#FFFFFF00\")",
      "default": "#FFFFFF00",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\s*#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})\\s*$"
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 4
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      ]
    },
    "spinDegrees": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "local": {
      "description": "(bool, default false)",
      "default": false,
      "type": "boolean"
    },
    "collision": {
      "description": "What a particle does when it meets the world: None (passes through), Bounce, or Die. (ParticleCollision, default \"None\")",
      "default": "None",
      "type": "string",
      "enum": [
        "None",
        "Bounce",
        "Die"
      ]
    },
    "restitution": {
      "description": "Bounce: the share of speed into the surface kept after a bounce; 0 = stops dead on it. Range: 0 to 1. (float, default 0.4)",
      "default": 0.4,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "friction": {
      "description": "Bounce: the share of speed along the surface lost at each bounce. Range: 0 to 1. (float, default 0.2)",
      "default": 0.2,
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "sheetColumns": {
      "description": "Frames across the texture. Range: 1 to 64. Category: Sheet. (int, default 1)",
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "sheetRows": {
      "description": "Frames down the texture. Range: 1 to 64. Category: Sheet. (int, default 1)",
      "default": 1,
      "type": "integer",
      "minimum": 1,
      "maximum": 64
    },
    "sheetFrames": {
      "description": "How many of the grid's frames are used, in order; 0 = all of them. At least 0. Category: Sheet. (int, default 0)",
      "default": 0,
      "type": "integer",
      "minimum": 0
    },
    "sheetCycles": {
      "description": "How many times a particle runs through its frames over its life; 0 = holds one frame. At least 0. Category: Sheet. (float, default 1)",
      "default": 1,
      "type": "number",
      "minimum": 0
    },
    "sheetRandomStart": {
      "description": "Each particle starts on a frame of its own, so a cloud of them does not flicker in step. Category: Sheet. (bool, default false)",
      "default": false,
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
