{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage faction record",
  "description": "A faction record (FactionRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "faction"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another faction record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:faction"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "label": {
      "description": "(string, default \"\")",
      "default": "",
      "type": "string"
    },
    "relations": {
      "description": "(List<FactionRelation>)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "faction": {
            "description": "Names a faction record. (RecordRef<FactionRecord>)",
            "allOf": [
              {
                "$ref": "ids.schema.json#/definitions/record:faction"
              }
            ]
          },
          "stance": {
            "description": "(Stance)",
            "type": "string",
            "enum": [
              "Neutral",
              "Ally",
              "Hostile"
            ]
          },
          "replace": {
            "description": "true (in a patch): replace this object with what the patch writes, instead of merging into it.",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "relations+": {
      "description": "Adds to \"relations\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "faction": {
            "description": "Names a faction record. (RecordRef<FactionRecord>)",
            "allOf": [
              {
                "$ref": "ids.schema.json#/definitions/record:faction"
              }
            ]
          },
          "stance": {
            "description": "(Stance)",
            "type": "string",
            "enum": [
              "Neutral",
              "Ally",
              "Hostile"
            ]
          },
          "replace": {
            "description": "true (in a patch): replace this object with what the patch writes, instead of merging into it.",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "relations-": {
      "description": "Removes these from \"relations\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "faction": {
            "description": "Names a faction record. (RecordRef<FactionRecord>)",
            "allOf": [
              {
                "$ref": "ids.schema.json#/definitions/record:faction"
              }
            ]
          },
          "stance": {
            "description": "(Stance)",
            "type": "string",
            "enum": [
              "Neutral",
              "Ally",
              "Hostile"
            ]
          },
          "replace": {
            "description": "true (in a patch): replace this object with what the patch writes, instead of merging into it.",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "default": {
      "description": "(Stance, default \"Neutral\")",
      "default": "Neutral",
      "type": "string",
      "enum": [
        "Neutral",
        "Ally",
        "Hostile"
      ]
    },
    "standing": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "hostileBelow": {
      "description": "(float, default -25)",
      "default": -25,
      "type": "number"
    },
    "friendlyAbove": {
      "description": "(float, default 25)",
      "default": 25,
      "type": "number"
    },
    "killCost": {
      "description": "(float, default 20)",
      "default": 20,
      "type": "number"
    },
    "replace": {
      "description": "true (in a patch): replace this object with what the patch writes, instead of merging into it.",
      "type": "boolean"
    }
  },
  "additionalProperties": false
}
