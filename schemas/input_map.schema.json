{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage input_map record",
  "description": "A input_map record (InputMapRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "input_map"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another input_map record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:input_map"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "context": {
      "description": "(InputContext, default \"Gameplay\")",
      "default": "Gameplay",
      "type": "string",
      "enum": [
        "Editor",
        "Console",
        "UI",
        "Gameplay"
      ]
    },
    "actions": {
      "description": "(Dictionary<string, List<InputBinding>>)",
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "object",
          "properties": {
            "key": {
              "description": "(string)",
              "type": "string"
            },
            "mouse": {
              "description": "(string)",
              "type": "string"
            },
            "gamepad": {
              "description": "(string)",
              "type": "string"
            },
            "composite": {
              "description": "(string)",
              "type": "string"
            },
            "scale": {
              "description": "(float)",
              "type": "number"
            },
            "deadzone": {
              "description": "(float)",
              "type": "number"
            },
            "invert": {
              "description": "(bool)",
              "type": "boolean"
            },
            "rate": {
              "description": "(bool)",
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      }
    }
  },
  "additionalProperties": false
}
