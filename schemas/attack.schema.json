{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage attack record",
  "description": "A attack record (AttackRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "attack"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another attack record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:attack"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "damage": {
      "description": "(float, default 10)",
      "default": 10,
      "type": "number"
    },
    "damageType": {
      "description": "Names a damage_type record. (RecordRef<DamageTypeRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:damage_type"
        }
      ]
    },
    "reach": {
      "description": "(float, default 2)",
      "default": 2,
      "type": "number"
    },
    "radius": {
      "description": "(float, default 0.35)",
      "default": 0.35,
      "type": "number"
    },
    "arcDegrees": {
      "description": "(float, default 120)",
      "default": 120,
      "type": "number"
    },
    "windupTime": {
      "description": "(float, default 0.25)",
      "default": 0.25,
      "type": "number"
    },
    "recoverTime": {
      "description": "(float, default 0.2)",
      "default": 0.2,
      "type": "number"
    },
    "cooldown": {
      "description": "(float, default 0.5)",
      "default": 0.5,
      "type": "number"
    },
    "animation": {
      "description": "(string, default \"\")",
      "default": "",
      "type": "string"
    },
    "swingCue": {
      "description": "Names a cue record. (RecordRef<CueRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:cue"
        }
      ]
    },
    "viewmodel": {
      "description": "Names a sprite_sheet record. (RecordRef<SpriteSheetRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:sprite_sheet"
        }
      ]
    },
    "arms": {
      "description": "Names a viewmodel record. (RecordRef<ViewmodelRecord>)",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/record:viewmodel"
        }
      ]
    },
    "effects": {
      "description": "Names a effect record. (List<RecordRef<EffectRecord>>)",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:effect"
      }
    },
    "effects+": {
      "description": "Adds to \"effects\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:effect"
      }
    },
    "effects-": {
      "description": "Removes these from \"effects\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:effect"
      }
    }
  },
  "additionalProperties": false
}
