{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage movement_profile record",
  "description": "A movement_profile record (MovementProfileRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "movement_profile"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another movement_profile record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:movement_profile"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "walkSpeed": {
      "description": "(float, default 4.2)",
      "default": 4.2,
      "type": "number"
    },
    "runSpeed": {
      "description": "(float, default 7)",
      "default": 7,
      "type": "number"
    },
    "acceleration": {
      "description": "(float, default 55)",
      "default": 55,
      "type": "number"
    },
    "airAcceleration": {
      "description": "(float, default 12)",
      "default": 12,
      "type": "number"
    },
    "friction": {
      "description": "(float, default 8)",
      "default": 8,
      "type": "number"
    },
    "jumpSpeed": {
      "description": "(float, default 5.2)",
      "default": 5.2,
      "type": "number"
    },
    "gravity": {
      "description": "(float, default -18)",
      "default": -18,
      "type": "number"
    },
    "maxSlopeDegrees": {
      "description": "(float, default 50)",
      "default": 50,
      "type": "number"
    },
    "stepHeight": {
      "description": "(float, default 0.45)",
      "default": 0.45,
      "type": "number"
    },
    "radius": {
      "description": "(float, default 0.35)",
      "default": 0.35,
      "type": "number"
    },
    "standHeight": {
      "description": "(float, default 1.8)",
      "default": 1.8,
      "type": "number"
    },
    "crouchHeight": {
      "description": "(float, default 1.05)",
      "default": 1.05,
      "type": "number"
    },
    "crouchSpeedScale": {
      "description": "(float, default 0.45)",
      "default": 0.45,
      "type": "number"
    },
    "groundSnap": {
      "description": "(float, default 0.35)",
      "default": 0.35,
      "type": "number"
    },
    "eyeOffset": {
      "description": "(float, default -0.18)",
      "default": -0.18,
      "type": "number"
    }
  },
  "additionalProperties": false
}
