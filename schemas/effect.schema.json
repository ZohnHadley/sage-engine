{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage effect record",
  "description": "A effect record (EffectRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "effect"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another effect record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:effect"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "modifiers": {
      "description": "(List<AttributeModifier>)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attribute": {
            "description": "Names a attribute record. (RecordRef<AttributeRecord>)",
            "allOf": [
              {
                "$ref": "ids.schema.json#/definitions/record:attribute"
              }
            ]
          },
          "op": {
            "description": "(ModifierOp)",
            "type": "string",
            "enum": [
              "Add",
              "Multiply",
              "Override"
            ]
          },
          "value": {
            "description": "(float)",
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "modifiers+": {
      "description": "Adds to \"modifiers\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attribute": {
            "description": "Names a attribute record. (RecordRef<AttributeRecord>)",
            "allOf": [
              {
                "$ref": "ids.schema.json#/definitions/record:attribute"
              }
            ]
          },
          "op": {
            "description": "(ModifierOp)",
            "type": "string",
            "enum": [
              "Add",
              "Multiply",
              "Override"
            ]
          },
          "value": {
            "description": "(float)",
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "modifiers-": {
      "description": "Removes these from \"modifiers\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "attribute": {
            "description": "Names a attribute record. (RecordRef<AttributeRecord>)",
            "allOf": [
              {
                "$ref": "ids.schema.json#/definitions/record:attribute"
              }
            ]
          },
          "op": {
            "description": "(ModifierOp)",
            "type": "string",
            "enum": [
              "Add",
              "Multiply",
              "Override"
            ]
          },
          "value": {
            "description": "(float)",
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "duration": {
      "description": "(EffectDuration, default \"Instant\")",
      "default": "Instant",
      "type": "string",
      "enum": [
        "Instant",
        "Timed",
        "Infinite"
      ]
    },
    "time": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "period": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "stacking": {
      "description": "(EffectStacking, default \"Refresh\")",
      "default": "Refresh",
      "type": "string",
      "enum": [
        "Separate",
        "Refresh",
        "Stack"
      ]
    },
    "maxStacks": {
      "description": "(int, default 1)",
      "default": 1,
      "type": "integer"
    },
    "grantTags": {
      "description": "Names a tag record. (List<RecordRef<TagRecord>>)",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "grantTags+": {
      "description": "Adds to \"grantTags\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "grantTags-": {
      "description": "Removes these from \"grantTags\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "requireTags": {
      "description": "Names a tag record. (List<RecordRef<TagRecord>>)",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "requireTags+": {
      "description": "Adds to \"requireTags\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "requireTags-": {
      "description": "Removes these from \"requireTags\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "blockTags": {
      "description": "Names a tag record. (List<RecordRef<TagRecord>>)",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "blockTags+": {
      "description": "Adds to \"blockTags\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "blockTags-": {
      "description": "Removes these from \"blockTags\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:tag"
      }
    },
    "cues": {
      "description": "Names a cue record. (List<RecordRef<CueRecord>>)",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:cue"
      }
    },
    "cues+": {
      "description": "Adds to \"cues\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:cue"
      }
    },
    "cues-": {
      "description": "Removes these from \"cues\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "ids.schema.json#/definitions/record:cue"
      }
    },
    "cost": {
      "description": "(float, default 0)",
      "default": 0,
      "type": "number"
    },
    "executions": {
      "description": "(List<IEffectExecution>)",
      "type": "array",
      "items": {
        "$ref": "vocabularies.schema.json#/definitions/effect_execution"
      }
    },
    "executions+": {
      "description": "Adds to \"executions\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "$ref": "vocabularies.schema.json#/definitions/effect_execution"
      }
    },
    "executions-": {
      "description": "Removes these from \"executions\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "$ref": "vocabularies.schema.json#/definitions/effect_execution"
      }
    }
  },
  "additionalProperties": false
}
