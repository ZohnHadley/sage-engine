{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage quest record",
  "description": "A quest record (QuestRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "quest"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another quest record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:quest"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "label": {
      "description": "(string, default \"\")",
      "default": "",
      "type": "string"
    },
    "start": {
      "description": "(string, default \"\")",
      "default": "",
      "type": "string"
    },
    "stages": {
      "description": "(List<QuestStage>)",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "(string)",
            "type": "string"
          },
          "text": {
            "description": "(string)",
            "type": "string"
          },
          "objectives": {
            "description": "(List<QuestObjective>)",
            "type": "array",
            "items": {
              "$ref": "vocabularies.schema.json#/definitions/quest_objective"
            }
          },
          "objectives+": {
            "description": "Adds to \"objectives\": what a base or an earlier definition listed, then these.",
            "type": "array",
            "items": {
              "$ref": "vocabularies.schema.json#/definitions/quest_objective"
            }
          },
          "objectives-": {
            "description": "Removes these from \"objectives\" (as a base or an earlier definition listed it).",
            "type": "array",
            "items": {
              "$ref": "vocabularies.schema.json#/definitions/quest_objective"
            }
          },
          "next": {
            "description": "(string)",
            "type": "string"
          },
          "done": {
            "description": "(bool)",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "stages+": {
      "description": "Adds to \"stages\": what a base or an earlier definition listed, then these.",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "(string)",
            "type": "string"
          },
          "text": {
            "description": "(string)",
            "type": "string"
          },
          "objectives": {
            "description": "(List<QuestObjective>)",
            "type": "array",
            "items": {
              "$ref": "vocabularies.schema.json#/definitions/quest_objective"
            }
          },
          "objectives+": {
            "description": "Adds to \"objectives\": what a base or an earlier definition listed, then these.",
            "type": "array",
            "items": {
              "$ref": "vocabularies.schema.json#/definitions/quest_objective"
            }
          },
          "objectives-": {
            "description": "Removes these from \"objectives\" (as a base or an earlier definition listed it).",
            "type": "array",
            "items": {
              "$ref": "vocabularies.schema.json#/definitions/quest_objective"
            }
          },
          "next": {
            "description": "(string)",
            "type": "string"
          },
          "done": {
            "description": "(bool)",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "stages-": {
      "description": "Removes these from \"stages\" (as a base or an earlier definition listed it).",
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "description": "(string)",
            "type": "string"
          },
          "text": {
            "description": "(string)",
            "type": "string"
          },
          "objectives": {
            "description": "(List<QuestObjective>)",
            "type": "array",
            "items": {
              "$ref": "vocabularies.schema.json#/definitions/quest_objective"
            }
          },
          "objectives+": {
            "description": "Adds to \"objectives\": what a base or an earlier definition listed, then these.",
            "type": "array",
            "items": {
              "$ref": "vocabularies.schema.json#/definitions/quest_objective"
            }
          },
          "objectives-": {
            "description": "Removes these from \"objectives\" (as a base or an earlier definition listed it).",
            "type": "array",
            "items": {
              "$ref": "vocabularies.schema.json#/definitions/quest_objective"
            }
          },
          "next": {
            "description": "(string)",
            "type": "string"
          },
          "done": {
            "description": "(bool)",
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
