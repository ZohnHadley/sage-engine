{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sage ui_style record",
  "description": "A ui_style record (UiStyleRecord). Generated by `sage schema` from the metadata table (issue #21).",
  "type": "object",
  "required": [
    "type",
    "id"
  ],
  "properties": {
    "$schema": {
      "description": "The JSON Schema an editor checks this file with; the game ignores it.",
      "type": "string"
    },
    "type": {
      "description": "The record type.",
      "const": "ui_style"
    },
    "id": {
      "description": "The record's id: name (this file's namespace) or namespace:name. A second definition of an id is an error; change one with \"patch\".",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/id"
        }
      ]
    },
    "base": {
      "description": "Inherit every field from another ui_style record, resolved after patches; this record's own fields win.",
      "allOf": [
        {
          "$ref": "ids.schema.json#/definitions/base:ui_style"
        }
      ]
    },
    "patch": {
      "description": "true: change a record defined earlier in load order, field by field, instead of defining one. Objects merge; lists replace unless written \"field+\" (add) or \"field-\" (remove).",
      "type": "boolean"
    },
    "abstract": {
      "description": "true: a template, usable as a \"base\" and never built into a record itself.",
      "type": "boolean"
    },
    "disabled": {
      "description": "true (in a patch): remove the record.",
      "type": "boolean"
    },
    "font": {
      "description": "The bitmap font atlas text is drawn with; empty: the client's own font. A font path. (AssetPath)",
      "type": "string"
    },
    "textScale": {
      "description": "Text size, 1 = the font's own; laid out, so a label measures with it. Range: 0.1 to 10. (float, default 1)",
      "default": 1,
      "type": "number",
      "minimum": 0.1,
      "maximum": 10
    },
    "padding": {
      "description": "Space inside a widget of this style, unless its layout node says otherwise: 4, [h, v] or [left, top, right, bottom]. (Thickness)",
      "anyOf": [
        {
          "type": "number"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 1,
          "maxItems": 4
        }
      ]
    },
    "borderWidth": {
      "description": "The border's width, in virtual units; 0 draws none. Unit: units. At least 0. (float, default 0)",
      "default": 0,
      "type": "number",
      "minimum": 0
    },
    "textColour": {
      "description": "Text colour. (uint, default \"#FFFFFFFF\")",
      "default": "#FFFFFFFF",
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\s*#([0-9A-Fa-f]{6}|[0-9A-Fa-f]{8})\\s*$"
        },
        {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 4
        },
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      ]
    },
    "background": {
