<Project>
  <!--
    Engine content (docs/design/05 §3.1, 07 §3.1): engine_content/ becomes the exe's Content/ folder,
    the "engine" VFS mount (record namespace "sage").
      - shaders/*.fx are compiled with dotnet-mgfxc (pinned in .config/dotnet-tools.json) to
        Content/shaders/*.mgfxo. A change to any .fx or .fxh recompiles all of them; a compile error
        fails the build with mgfxc's output.
      - everything else (data/, textures/) is copied as is.
    Imported by the host project (the exe owns the Content folder).
  -->
  <PropertyGroup>
    <SageEngineContentDir>$(MSBuildThisFileDirectory)..\engine_content\</SageEngineContentDir>
    <SageShaderOutDir>$(BaseIntermediateOutputPath)$(Configuration)\shaders\</SageShaderOutDir>
  </PropertyGroup>

  <ItemGroup>
    <SageShader Include="$(SageEngineContentDir)shaders\*.fx" />
    <SageShaderInclude Include="$(SageEngineContentDir)shaders\*.fxh" />
    <!--
      `tools/` is excluded because it makes the content rather than being content: the scripts that
      draw the font and the engine textures are run by hand and belong in the repository, not beside
      the executable a player gets (R12; before it, `make_engine_textures.py` shipped too).
    -->
    <None Include="$(SageEngineContentDir)**\*"
          Exclude="$(SageEngineContentDir)shaders\**;$(SageEngineContentDir)tools\**"
          Link="Content\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="@(SageShader);@(SageShaderInclude)" Link="engine_content\shaders\%(Filename)%(Extension)" />
  </ItemGroup>

  <!--
    SageSkipShaders=true compiles the host without its shaders: a build to check the code, not one to
    run, since the renderer needs the .mgfxo files. It exists because mgfxc needs Wine on Linux
    (MGFXC0001), and Linux CI still has to compile the host.
  -->

  <!--
    mgfxc is a local dotnet tool, so it has to be restored before it can be run. Until R12 this
    happened only as a side effect of the vendored ImGuiNet project restoring tools for MGCB; now that
    MGCB is gone, the one target that needs a tool restores it itself.
  -->
  <Target Name="SageRestoreTools" BeforeTargets="SageCompileShaders" Condition="'$(SageSkipShaders)' != 'true'">
    <Exec Command="dotnet tool restore" StandardOutputImportance="low" />
  </Target>

  <Target Name="SageCompileShaders" BeforeTargets="AssignTargetPaths" Condition="'$(SageSkipShaders)' != 'true'"
          Inputs="@(SageShader);@(SageShaderInclude)"
          Outputs="@(SageShader->'$(SageShaderOutDir)%(Filename).mgfxo')">
    <MakeDir Directories="$(SageShaderOutDir)" />
    <Exec Command="dotnet mgfxc &quot;%(SageShader.FullPath)&quot; &quot;$(SageShaderOutDir)%(SageShader.Filename).mgfxo&quot; /Profile:OpenGL" />
  </Target>

  <Target Name="SageIncludeShaders" BeforeTargets="AssignTargetPaths" DependsOnTargets="SageCompileShaders" Condition="'$(SageSkipShaders)' != 'true'">
    <ItemGroup>
      <None Include="@(SageShader->'$(SageShaderOutDir)%(Filename).mgfxo')" Link="Content\shaders\%(Filename).mgfxo" CopyToOutputDirectory="PreserveNewest" />
      <FileWrites Include="@(SageShader->'$(SageShaderOutDir)%(Filename).mgfxo')" />
    </ItemGroup>
  </Target>
</Project>
