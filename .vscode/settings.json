{
  // Record files (data/**/*.json) against the generated JSON Schemas (issue #21): autocomplete for
  // fields, component and part ids and the ids content defines, a tooltip with each field's unit and
  // range on hover, and a red underline under a misspelt field before the game runs. The schemas are
  // generated into schemas/ by `sage schema games/Sandbox games/Hello tests/games/scene-only tests/games/camera-cut --out schemas` (README); CI
  // fails when they are stale. MAKING_A_GAME.md, "Editing records in VS Code", has the details.
  //
  // Record files have // comments, which plain JSON calls an error: open them (and game.json) as
  // JSON with comments. The schemas apply either way.
  "files.associations": {
    "**/data/**/*.json": "jsonc",
    "**/game.json": "jsonc",
    "**/mod.json": "jsonc"
  },
  "json.schemas": [
    {
      "fileMatch": ["**/data/**/*.json", "!**/bin/**", "!**/obj/**"],
      "url": "./schemas/record.schema.json"
    },
    {
      // game.json and mod.json (phase 4j): the keys their loaders read.
      "fileMatch": ["**/game.json", "!**/bin/**", "!**/obj/**"],
      "url": "./schemas/game.schema.json"
    },
    {
      "fileMatch": ["**/mod.json", "!**/bin/**", "!**/obj/**"],
      "url": "./schemas/mod.schema.json"
    }
  ]
}
