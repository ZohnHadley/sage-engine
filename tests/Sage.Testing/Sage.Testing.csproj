<Project Sdk="Microsoft.NET.Sdk">
  <!--
    The harness the engine's tests boot through, and a game's tests can too (docs/REDESIGN.md §3.2,
    issue #14): HeadlessApp, MountFixture, EventProbe, CaptureSink. A plain library on the base engine
    (Sage.Gameplay and below, and Sage.UI) only: no test framework, so a game can use it from xUnit, NUnit or a console app, and no client,
    so nothing here can need a window.
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <RollForward>Major</RollForward>
    <RootNamespace>Sage.Testing</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sage.Gameplay\Sage.Gameplay.csproj" />
    <!-- EngineAssemblies names the retained UI too (issue #95), a base assembly beside Physics3D. -->
    <ProjectReference Include="..\..\src\Sage.UI\Sage.UI.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- SkinnedModelBuilder writes skinned .glb files in code (issue #116). Sage.Simulation brings it
         already; named here because this project uses it directly. -->
    <PackageReference Include="SharpGLTF.Core" />
  </ItemGroup>
  <PropertyGroup>
    <NoWarn>$(NoWarn);SAGE0125;SAGE0126</NoWarn>
  </PropertyGroup>

  <!-- The layers below, for every file (one namespace per assembly, REDESIGN §3.1). -->
  <ItemGroup>
    <Using Include="Sage.Core" />
    <Using Include="Sage.Simulation" />
    <Using Include="Sage.Physics3D" />
    <Using Include="Sage.Gameplay" />
  </ItemGroup>
</Project>
