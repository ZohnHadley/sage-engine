<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless tests. References the base engine only (Sage.Core to Sage.Gameplay, and Sage.UI): if simulation code
    ever picks up a MonoGame dependency, this project stops compiling (ARCHITECTURE.md §2 rule 2).
  -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Same as the engine: run on the newest installed runtime when .NET 8 itself isn't installed. -->
    <RollForward>Major</RollForward>
    <RootNamespace>Sage.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <!-- No background GC in the test process (runtimeconfig System.GC.Concurrent=false). The zero-
         allocation tests read GC.GetAllocatedBytesForCurrentThread, and a background GC started by any
         thread clears this thread's allocation context without taking its unused bytes off the count
         (dotnet/runtime#134724), so a window that allocated nothing reads up to 8 KB more. That was the
         Windows-only flake in #81 (2016, 7408, 3816 and 32 bytes, a different test each run). Blocking
         collections account correctly; AllocationProbeTests prove it, and fail if this is turned off. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <!-- To run Sage.Generators on source text and check what it writes and reports (issue #16). -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Using Include="Sage.Testing" />
    <Using Include="Sage.Core" />
    <Using Include="Sage.Simulation" />
    <Using Include="Sage.Physics3D" />
    <Using Include="Sage.Gameplay" />
  </ItemGroup>

  <ItemGroup>
    <!-- The base engine, every assembly by name (issue #24): the tests read each one's declarations. -->
    <ProjectReference Include="..\..\src\Sage.Core\Sage.Core.csproj" />
    <ProjectReference Include="..\..\src\Sage.Simulation\Sage.Simulation.csproj" />
    <ProjectReference Include="..\..\src\Sage.Physics3D\Sage.Physics3D.csproj" />
    <ProjectReference Include="..\..\src\Sage.Gameplay\Sage.Gameplay.csproj" />
    <ProjectReference Include="..\..\src\Sage.UI\Sage.UI.csproj" />
    <ProjectReference Include="..\..\src\Sage.Editing\Sage.Editing.csproj" />
    <!-- The harness every test boots through: HeadlessApp, MountFixture, EventProbe (issue #14). -->
    <ProjectReference Include="..\Sage.Testing\Sage.Testing.csproj" />
    <!-- The generator as a library, not as an analyzer: the tests drive it directly. -->
    <ProjectReference Include="..\..\src\Sage.Generators\Sage.Generators.csproj" />
    <!-- The Sandbox's *simulation* half only: no MonoGame, so the game's own rules can be ticked
         here the way the engine's are (R15). Sandbox.Client is deliberately not referenced. -->
    <ProjectReference Include="..\..\games\Sandbox\Sandbox.csproj" />
    <!-- The guide's example game, so that the smallest thing a game can be is exercised by the suite.
         An example nobody builds rots, and a rotted example is worse than none (R19). -->
    <ProjectReference Include="..\..\games\Hello\Hello.csproj" />
    <!-- The RPG kit's simulation half (issue #27): its spellmaker, panels and screens are tested here,
         and the layering tests read it. A test loads its module only when it asks for it (With, or a
         game.json that names the kit); the scene-only and no-plugins games never do. -->
    <ProjectReference Include="..\..\src\Sage.Kits.Rpg\Sage.Kits.Rpg.csproj" />
    <!-- The `sage` CLI, headless like the rest: its packager (`sage package`, issue #293) is tested here. -->
    <ProjectReference Include="..\..\src\Sage.Cli\Sage.Cli.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The host's launch options (issue #298), compiled in: the host is a MonoGame executable, which a
         headless test may not reference, but the rules for its -options are plain code. -->
    <Compile Include="..\..\src\Sage.Host\HostOptions.cs" Link="Core\Host\HostOptions.cs" />
  </ItemGroup>
  <!-- The tests exercise the experimental API too (issue #31, docs/MAKING_A_GAME.md §10b): the open
       vocabularies (SAGE0120), scenes and placements (SAGE0121), brush maps (SAGE0122), cameras (SAGE0123), phase 4b's logic (SAGE0124: conditions and actions, easing) the retained UI (SAGE0125), skeletal animation (SAGE0126), the hit pipeline (SAGE0127), phase 4g's cells (SAGE0129), render passes (SAGE0130), phase 4i's saves (SAGE0131) and data mods (SAGE0132). -->
  <PropertyGroup>
    <NoWarn>$(NoWarn);SAGE0120;SAGE0121;SAGE0122;SAGE0123;SAGE0124;SAGE0125;SAGE0126;SAGE0127;SAGE0129;SAGE0130;SAGE0131;SAGE0132;SAGE0133;SAGE0134</NoWarn>
  </PropertyGroup>
</Project>
