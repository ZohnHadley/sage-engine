<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Headless tests. References Sage.Engine only: if simulation code ever picks up a MonoGame
    dependency, this project stops compiling (ARCHITECTURE.md §2 rule 2).
  -->
  <Import Project="..\..\build\Sage.Configurations.props" />
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <!-- Same as the engine: run on the newest installed runtime when .NET 8 itself isn't installed. -->
    <RollForward>Major</RollForward>
    <RootNamespace>sage_engine.Tests</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sage.Engine\Sage.Engine.csproj" />
    <!-- The Sandbox's *simulation* half only: no MonoGame, so the game's own rules can be ticked
         here the way the engine's are (R15). Sandbox.Client is deliberately not referenced. -->
    <ProjectReference Include="..\..\games\Sandbox\Sandbox.csproj" />
    <!-- The guide's example game, so that the smallest thing a game can be is exercised by the suite.
         An example nobody builds rots, and a rotted example is worse than none (R19). -->
    <ProjectReference Include="..\..\games\Hello\Hello.csproj" />
  </ItemGroup>
</Project>
