  { "type": "prefab", "id": "plate", "name": "pressure plate", "parts": { "body": { "size": [2, 1, 2], "trigger": true } } },
  { "type": "prefab", "id": "door", "name": "door", "parts": { "body": { "size": [2, 3, 0.2] }, "mover": { "open": [2, 0, 0], "seconds": 2 } } },
  { "type": "prefab", "id": "crate", "name": "crate", "parts": { "body": { "size": [1, 1, 1], "mass": 10 } } },
  { "type": "prefab", "id": "light", "name": "light", "parts": { "light": { "colour": [1, 0.85, 0.6], "range": 8, "intensity": 1.2 } } },

  // The level's own: the ground, and who plays.
  { "type": "prefab", "id": "floor", "name": "floor", "parts": { "body": { "size": [40, 1, 40] } } },
  { "type": "prefab", "id": "player", "name": "player", "tags": ["player_controlled"], "parts": { "character": { "layer": "player" } } }
