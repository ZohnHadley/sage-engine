  // boots it headlessly and fires every weapon.
  "name": "Weapons range",
  "id": "weapons",
  "plugins": ["sage.gameplay.character", "sage.gameplay.animation", "sage.gameplay.attributes",
              "sage.gameplay.combat", "sage.gameplay.items", "sage.gameplay.abilities"],
  "kits": ["sage.kits.rpg"],
  "mounts": ["content"],
  "scene": "range"
